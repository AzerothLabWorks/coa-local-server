+#ifndef COA_G1_SOCIAL_ADAPTER_FIXTURE_H
+#define COA_G1_SOCIAL_ADAPTER_FIXTURE_H
+
+#include "BotSocialChatPolicy.h"
+#include <cstdint>
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+using uint32 = std::uint32_t;
+inline std::uint64_t FixtureNow = 1000;
+inline constexpr uint32 LANG_UNIVERSAL = 0;
+inline constexpr uint32 LANG_ADDON = 0xFFFFFFFF;
+enum ChatType
+{
+    CHAT_MSG_WHISPER,
+    CHAT_MSG_PARTY,
+    CHAT_MSG_RAID,
+    CHAT_MSG_SAY,
+    CHAT_MSG_CHANNEL,
+    CHAT_MSG_GUILD,
+    CHAT_MSG_YELL
