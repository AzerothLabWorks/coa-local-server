+            case 4: f.bot.falling = true; break;
+            case 5: f.bot.transfer = true; break;
+            case 6: f.injured.horizontal = 61.0f; break;
+            case 7: f.injured.flying = true; break;
+            case 8: f.injured.alive = false; break;
+            case 9: f.injured.phase = 2; break;
+        }
+        auto reach = f.ActionNamed("coa brewing reach");
+        Check(reach && !reach->Execute({}) && f.ai.nearMoves == 0 && f.ai.losMoves == 0,
+            "blocked or unsafe recovery never starts movement");
+    }
+    {
+        Fixture f;
+        f.injured.horizontal = 45.0f;
+        f.bot.mounted = true;
+        auto reach = f.ActionNamed("coa brewing reach");
+        Check(reach && !reach->isUseful() && !reach->Execute({}) && f.ai.nearMoves == 0,
+            "healing recovery does not replace mounted travel");
+        f.bot.mounted = false;
+        f.ai.state = BOT_STATE_NON_COMBAT;
+        f.ai.noncombatStrategies.insert("stay");
+        Check(reach && !reach->isUseful(), "explicit stay is respected in the recovery engine");
+    }
+    {
+        Fixture f;
+        f.injured.horizontal = 45.0f;
+        f.injured.health = 20.0f;
+        f.other.health = 30.0f;
+        auto reach = f.ActionNamed("coa brewing reach");
+        Check(reach && !reach->isUseful(), "reachable critical member is healed before repositioning");
+        f.other.health = 70.0f;
+        Check(reach && reach->isUseful(), "unreachable critical member outranks mild reachable damage");
+        f.injured.health = 60.0f;
+        Check(reach && !reach->isUseful(), "reachable wounded member is preferred over noncritical movement");
+    }
+    {
+        Fixture f;
+        auto attack = f.ActionNamed("coa brewing attack");
+        Check(!attack->Execute({}) && f.ai.cast == 0, "Brewing holds paid damage while healing is needed");
+        f.injured.health = 100.0f;
+        f.bot.mana = 49;
+        Check(!attack->Execute({}), "paid damage cannot spend below the forty-percent reserve");
+        f.bot.mana = 50;
+        Check(attack->Execute({}) && f.ai.cast == 900001, "damage may spend exactly to the reserve");
+        f.bot.mana = 5;
+        f.ClearCast();
+        Check(!attack->Execute({}) && f.ai.attempts.empty(),
+            "reserve rejects a damage cost above current unsigned mana before attempting the cast");
+        f.bot.mana = 10;
+        Learn(f.bot, 900002, 0, 35.0f, true);
+        f.ClearCast();
+        Check(attack->Execute({}) && f.ai.cast == 900002, "free attacks remain available with low mana");
+        f.injured.health = 20.0f;
+        f.ClearCast();
+        Check(attack->Execute({}) && f.ai.cast == 900002, "free fallback remains when normal healing is unavailable");
+    }
+    {
+        Fixture f;
+        f.ai.combatStrategies.clear();
+        f.bot.mana = 10;
+        auto attack = f.ActionNamed("coa brewing attack");
+        Check(attack->Execute({}) && f.ai.cast == 900001, "non-Brewing damage behavior is unchanged");
+        f.ai.combatStrategies.insert("coa brewing");
+        f.bot.learned.erase(801670);
+        f.ClearCast();
+        Check(attack->Execute({}), "a bot with no known heal does not reserve mana for unavailable healing");
+    }
+    {
+        Fixture f;
+        std::vector<TriggerNode*> triggers;
+        std::unique_ptr<Strategy> combat(f.strategies.creators.at("coa brewing")(&f.ai));
+        Check((combat->GetType() & (STRATEGY_TYPE_COMBAT | STRATEGY_TYPE_HEAL | STRATEGY_TYPE_RANGED)) ==
+            (STRATEGY_TYPE_COMBAT | STRATEGY_TYPE_HEAL | STRATEGY_TYPE_RANGED) &&
+            !(combat->GetType() & STRATEGY_TYPE_DPS), "Brewing advertises its implemented ranged healing role");
+        combat->InitTriggers(triggers);
+        Check(HasTrigger(triggers, "invalid target", ACTION_NORMAL), "shared post-combat target cleanup is retained");
+        Check(HasTrigger(triggers, "coa brewing urgent", ACTION_CRITICAL_HEAL), "urgent healing has explicit priority");
+        Check(HasTrigger(triggers, "coa brewing wounded", ACTION_HIGH), "party healing outranks generic damage");
+        Check(HasTrigger(triggers, "coa brewing reach", ACTION_HIGH), "healing reach outranks generic damage");
+        DeleteTriggers(triggers);
+        std::unique_ptr<Strategy> recovery(f.strategies.creators.at("coa brewing recovery")(&f.ai));
+        recovery->InitTriggers(triggers);
+        Check(HasTrigger(triggers, "coa brewing urgent", ACTION_CRITICAL_HEAL) &&
+            HasTrigger(triggers, "coa brewing wounded", ACTION_HIGH) &&
+            HasTrigger(triggers, "coa brewing reach", ACTION_HIGH),
+            "recovery engine also receives explicit healing and movement triggers");
+        DeleteTriggers(triggers);
+    }
+#if COA_BREWING_HAS_TRIGGER_FACTORY
+    {
+        Fixture f;
+        CoaTriggerFactory factory;
+        std::unique_ptr<Trigger> urgent(factory.creators.at("coa brewing urgent")(&f.ai));
+        std::unique_ptr<Trigger> wounded(factory.creators.at("coa brewing wounded")(&f.ai));
+        std::unique_ptr<Trigger> reach(factory.creators.at("coa brewing reach")(&f.ai));
+        Check(!urgent->IsActive() && wounded->IsActive() && !reach->IsActive(),
+            "registered triggers distinguish ordinary reachable wounds");
+        f.injured.health = 39.99f;
+        Check(urgent->IsActive(), "registered urgent trigger uses the strict critical boundary");
+        f.injured.health = 40.0f;
+        Check(!urgent->IsActive(), "critical trigger does not include its exact boundary");
+        f.injured.horizontal = 45.0f;
+        Check(!urgent->IsActive() && !wounded->IsActive() && reach->IsActive(),
+            "registered reach trigger retains a target beyond current casting range");
+        f.injured.horizontal = 10.0f;
+        f.injured.los = false;
+        Check(reach->IsActive(), "registered reach trigger retains a LOS-blocked target");
+        f.ai.combatStrategies.insert("stay");
+        Check(!reach->IsActive(), "reach trigger respects explicit stay");
+        f.injured.los = true;
+        f.injured.health = 80.0f;
+        Check(!urgent->IsActive() && !wounded->IsActive(), "registered heal triggers stop at eighty percent");
+    }
+#else
+    Check(false, "Brewing trigger factory exists");
+#endif
+    std::printf("Brewing bounded source fixture: %d failures\n", failures);
+    return failures ? 1 : 0;
+}
