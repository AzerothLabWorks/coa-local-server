+water_checks::PathComparison CompareStableRipplePath(const water_checks::WaterView& view, const Image& mask,
+                                                     const water_checks::WaterFrameResult& rippled,
+                                                     const water_checks::WaterFrameResult& calm)
+{
+    if (!rippled.coverageCapturesStable || !calm.coverageCapturesStable ||
+        rippled.image.w != calm.image.w || rippled.image.h != calm.image.h)
+        return {};
+    return water_checks::CompareAroundPath(view, rippled.image, calm.image, [&mask, &rippled, &calm](UINT x, UINT y) {
+        const bool water = !IsDry(rippled.sceneBeforeWater, rippled.stockAfterWater, x, y) &&
+                           !IsDry(calm.sceneBeforeWater, calm.stockAfterWater, x, y);
+        const bool sameStock = std::memcmp(rippled.stockBeforeShade.At(x, y), calm.stockBeforeShade.At(x, y), 3) == 0;
+        return water && sameStock && FullWaterAround(mask, x, y, kWaterEdgeMargin);
+    });
+}
+
+bool FullWaterInteriorWasDrawn(const Image& mask, const water_checks::WaterFrameResult& frame)
+{
+    if (!frame.coverageCapturesStable || frame.sceneBeforeWater.w != mask.w || frame.sceneBeforeWater.h != mask.h ||
+        frame.stockAfterWater.w != mask.w || frame.stockAfterWater.h != mask.h)
+        return false;
+    size_t checked = 0;
+    for (UINT y = 0; y < mask.h; ++y)
+        for (UINT x = 0; x < mask.w; ++x)
+            if (FullWaterAround(mask, x, y, kWaterEdgeMargin))
+            {
+                if (IsDry(frame.sceneBeforeWater, frame.stockAfterWater, x, y))
+                    return false;
+                ++checked;
+            }
+    return checked > 0;
+}
