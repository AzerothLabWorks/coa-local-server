+def method(source, signature):
+    position = source.find(signature)
+    if position < 0:
+        raise ValueError(f"Missing production function: {signature}")
+    start = source.index("{", position)
+    depth = 1
+    end = start + 1
+    while depth and end < len(source):
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
