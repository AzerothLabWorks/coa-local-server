+CLI_DESCRIPTION = "Compile the actual party social adapter and bounded policies against lifecycle fixtures."
+
+import os
+from pathlib import Path
+import re
+import shlex
+import shutil
+import subprocess
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[3]
+HERE = Path(__file__).resolve().parent
+SOURCE = ROOT / "modules/mod-playerbots/src/Util"
+
+
+def main():
+    compiler = os.environ.get("CXX") or shutil.which("c++") or shutil.which("g++") or shutil.which("clang++")
+    if not compiler:
+        raise RuntimeError("A portable C++ compiler is required")
+
+    ai_source = (SOURCE.parent / "Bot/PlayerbotAI.cpp").read_text(encoding="utf-8")
+    update = ai_source[ai_source.index("void PlayerbotAI::UpdateAI("):]
+    guard, update = update.split("if (bot->FindMap())", 1)
+    if not re.search(r"partySocial\.Reset\(\);\s*return;", guard):
+        raise AssertionError("AI lifecycle early return must reset party drinking episodes")
+    if not re.match(r"\s*\{[^{}]*partySocial\.Update\(this\);\s*\}\s*else\s*(?:\{)?[^{}]*"
+                    r"partySocial\.Reset\(\);", update):
+        raise AssertionError("Mapless AI update must reset party drinking episodes")
+
+    source = (SOURCE / "BotPartySocial.cpp").read_text(encoding="utf-8")
+    original_clock = (
+        "return std::chrono::duration_cast<std::chrono::milliseconds>(\n"
+        "            std::chrono::steady_clock::now().time_since_epoch()).count();"
+    )
+    if source.count(original_clock) != 1:
+        raise AssertionError("Party social monotonic clock seam changed")
+    source = source.replace(original_clock, "return FixtureNow;")
+
+    with tempfile.TemporaryDirectory(prefix="coa-g1-party-social-") as temporary:
+        directory = Path(temporary)
+        (directory / "BotPartySocialProduction.h").write_text(source, encoding="utf-8")
+        for header in ("Group.h", "Player.h", "PlayerbotAI.h", "PlayerbotAIConfig.h", "WorldSession.h",
+                       "SpellAuraEffects.h", "SpellInfo.h"):
+            (directory / header).write_text('#include "fixture.h"\n', encoding="utf-8")
+        executable = directory / "fixture"
+        command = shlex.split(compiler) + [
+            "-std=c++20", "-Wall", "-Wextra", "-Werror", "-I", str(directory), "-I", str(HERE),
+            "-I", str(SOURCE), str(HERE / "fixture.cpp"), "-pthread", "-o", str(executable),
+        ]
+        subprocess.run(command, check=True)
+        subprocess.run([str(executable)], check=True)
+
+
+if __name__ == "__main__":
+    main()
