new file mode 100644
index 0000000..70fe5bc
--- /dev/null
+++ b/apps/coa-gameplay-test/check_g1_utilities.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+CLI_DESCRIPTION = """Check preserved Furline speed ratios and profession-book starter tool additions."""
+
+import argparse
+import json
+import math
+from pathlib import Path
+
+
+def observations(directory):
+    summary = json.loads((directory / 'summary.json').read_text(encoding='utf-8'))
+    result = json.loads((directory / 'result.json').read_text(encoding='utf-8'))
+    if summary['status'] != 'passed' or result['status'] != 'passed':
+        raise ValueError('A completed native scenario pass is required')
+    values = {}
+    for step in result['steps']:
+        if step['action'] != 'snapshot':
+            continue
+        label = step['label']
+        if label in values:
+            raise ValueError(f'Duplicate snapshot: {label}')
+        value = float(step['actual'])
+        if not math.isfinite(value):
+            raise ValueError(f'Non-finite snapshot: {label}')
+        values[label] = value
+    return values
+
+
+def check_furline(values):
+    baseline = values['initial_ground_speed']
+    if baseline <= 0:
+        raise ValueError('Unmounted ground speed must be positive')
+    for label in ('vanity_mount_ground_speed', 'direct_mount_ground_speed'):
+        ratio = values[label] / baseline
+        if not math.isclose(ratio, 2, rel_tol=0, abs_tol=0.000001):
+            raise ValueError(f'{label}: measured speed ratio {ratio}, expected 2')
+        print(f'{label}: 100% ground speed bonus')
+    for label in ('vanity_dismount_ground_speed', 'direct_dismount_ground_speed', 'recovered_ground_speed'):
+        if not math.isclose(values[label], baseline, rel_tol=0, abs_tol=0.000001):
+            raise ValueError(f'{label}: measured speed {values[label]}, expected unmounted {baseline}')
+        print(f'{label}: restored unmounted speed {baseline}')
+
+
+def check_artisans(values):
+    for tool in ('fishing_poles', 'skinning_knives'):
+        counts = [values[f'{phase}_{tool}'] for phase in ('initial', 'trained', 'repeated')]
+        if any(count < 0 or not count.is_integer() for count in counts):
+            raise ValueError(f'{tool}: observations must be nonnegative item counts')
+        initial, trained, repeated = map(int, counts)
+        if trained - initial != 1:
+            raise ValueError(f'{tool}: training added {trained - initial}, expected exactly one')
+        if repeated != trained:
+            raise ValueError(f'{tool}: repeated training/login changed the count from {trained} to {repeated}')
+        print(f'{tool}: one starter tool added and no duplicate after repeated training/login hooks')
+
+
+def check(directory, mode):
+    values = observations(directory)
+    if mode == 'furline':
+        check_furline(values)
+    else:
+        check_artisans(values)
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=CLI_DESCRIPTION)
+    parser.add_argument('result_directory', type=Path)
+    parser.add_argument('mode', choices=('furline', 'artisans'))
+    args = parser.parse_args()
+    check(args.result_directory, args.mode)
