+bool MatchesColour(const unsigned char* bgr, DWORD colour)
+{
+    const int expected[3] = {static_cast<int>(colour & 0xFF), static_cast<int>((colour >> 8) & 0xFF),
+                             static_cast<int>((colour >> 16) & 0xFF)};
