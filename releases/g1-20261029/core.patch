+++ b/apps/coa-gameplay-test/scenarios/g1-azeroth-mount-flight.json
@@ -0,0 +1,145 @@
+{
+  "schema": 1,
+  "name": "G1 preserves learned Blossomback flight on both Azeroth continents without bypassing riding or Cold Weather Flying",
+  "contract": [
+    "Requires CoA.AllowAzerothMountFlight=1 and CoA.LegacyMountFlight=0 in the isolated qualification runtime.",
+    "Blossomback Arboon 900125 is the accepted G1 learned mount. Spell.dbc provides mounted, ground-speed and",
+    "mounted-flight auras without a flying-area-only attribute. Native casts at riding 300 must grant flight on",
+    "maps 0 and 1, at the upstream Artisan speed of 280 percent, retaining ground speed of 100 percent.",
+    "Azeroth permission does not grant Expert riding: riding 150 remains grounded even on map 1. It also does not",
+    "bypass the separate Northrend Cold Weather Flying requirement: the same mount is grounded without 54197",
+    "and can fly after learning it. Dismounting must send the native flight-removal packet and clear the mount.",
+    "Socketless sessions do not acknowledge flight, so native server packets 835 and 836 establish permission",
+    "and removal; flight_speed_rate establishes speed. Aura presence alone is not accepted as flight proof.",
+    "This bounded case does not claim rendered client motion, autonomous bot travel, battleground coverage,",
+    "or every area's restrictions. Those policy branches are covered separately by g1_mount_flight."
+  ],
+  "timeout_ms": 90000,
+  "location": { "map": 0, "x": -8833.38, "y": 628.628, "z": 94.0066, "o": 1.06535 },
+  "players": [
+    { "id": "rider", "race": 1, "class": 13, "level": 80 }
+  ],
+  "steps": [
+    { "action": "wait", "ms": 8000, "label": "Settle ordinary login and riding initialization" },
+    { "action": "learn", "actor": "rider", "spell": 900125 },
+    { "action": "assert", "actor": "rider", "metric": "knows_spell", "spell": 900125, "equals": 1 },
+    { "action": "set_skill", "actor": "rider", "skill": 762, "value": 300, "maximum": 300 },
+    {
+      "action": "snapshot", "actor": "rider", "metric": "server_packets", "opcode": 835,
+      "save_as": "eastern_flight_grants"
+    },
+    { "action": "cast", "actor": "rider", "spell": 900125 },
+    { "action": "assert", "actor": "rider", "metric": "mount_display_id", "min": 1, "within_ms": 5000 },
+    {
+      "action": "assert", "actor": "rider", "metric": "server_packets", "opcode": 835,
+      "relative_to": "eastern_flight_grants", "min": 1, "within_ms": 1000,
+      "label": "Candidate opt-in preserves real flight permission in Eastern Kingdoms"
+    },
+    { "action": "assert", "actor": "rider", "metric": "flight_speed_rate", "min": 3.799, "max": 3.801 },
+    { "action": "assert", "actor": "rider", "metric": "run_speed_rate", "min": 1.999, "max": 2.001 },
+    {
+      "action": "snapshot", "actor": "rider", "metric": "server_packets", "opcode": 836,
+      "save_as": "eastern_flight_removals"
+    },
+    { "action": "cancel_mount", "actor": "rider" },
+    { "action": "assert", "actor": "rider", "metric": "mount_display_id", "equals": 0, "within_ms": 5000 },
+    {
+      "action": "assert", "actor": "rider", "metric": "server_packets", "opcode": 836,
+      "relative_to": "eastern_flight_removals", "min": 1, "within_ms": 1000,
+      "label": "Dismounting removes the granted Eastern Kingdoms flight permission"
+    },
+    { "action": "assert", "actor": "rider", "metric": "run_speed_rate", "min": 0.999, "max": 1.001 },
+    {
+      "action": "teleport", "actor": "rider", "map": 1,
+      "x": 1662.44, "y": -4405.14, "z": 18.0879, "o": 0
+    },
+    { "action": "wait", "ms": 3000 },
+    { "action": "assert", "actor": "rider", "metric": "map_id", "equals": 1 },
+    {
+      "action": "snapshot", "actor": "rider", "metric": "server_packets", "opcode": 835,
+      "save_as": "kalimdor_flight_grants"
+    },
+    { "action": "cast", "actor": "rider", "spell": 900125 },
+    { "action": "assert", "actor": "rider", "metric": "mount_display_id", "min": 1, "within_ms": 5000 },
+    {
+      "action": "assert", "actor": "rider", "metric": "server_packets", "opcode": 835,
+      "relative_to": "kalimdor_flight_grants", "min": 1, "within_ms": 1000,
+      "label": "Candidate opt-in preserves real flight permission in Kalimdor"
+    },
+    { "action": "assert", "actor": "rider", "metric": "flight_speed_rate", "min": 3.799, "max": 3.801 },
+    { "action": "assert", "actor": "rider", "metric": "run_speed_rate", "min": 1.999, "max": 2.001 },
+    {
+      "action": "snapshot", "actor": "rider", "metric": "server_packets", "opcode": 836,
+      "save_as": "kalimdor_flight_removals"
+    },
+    { "action": "cancel_mount", "actor": "rider" },
+    { "action": "assert", "actor": "rider", "metric": "mount_display_id", "equals": 0, "within_ms": 5000 },
+    {
+      "action": "assert", "actor": "rider", "metric": "server_packets", "opcode": 836,
+      "relative_to": "kalimdor_flight_removals", "min": 1, "within_ms": 1000
+    },
+    { "action": "set_skill", "actor": "rider", "skill": 762, "value": 150, "maximum": 300 },
+    {
+      "action": "snapshot", "actor": "rider", "metric": "server_packets", "opcode": 835,
+      "save_as": "untrained_flight_grants"
+    },
+    { "action": "cast", "actor": "rider", "spell": 900125 },
+    { "action": "assert", "actor": "rider", "metric": "mount_display_id", "min": 1, "within_ms": 5000 },
+    { "action": "wait", "ms": 1000 },
+    {
+      "action": "assert", "actor": "rider", "metric": "server_packets", "opcode": 835,
+      "relative_to": "untrained_flight_grants", "equals": 0,
+      "label": "Azeroth opt-in does not bypass Expert riding requirement"
+    },
+    { "action": "assert", "actor": "rider", "metric": "run_speed_rate", "min": 1.999, "max": 2.001 },
+    { "action": "cancel_mount", "actor": "rider" },
+    { "action": "assert", "actor": "rider", "metric": "mount_display_id", "equals": 0, "within_ms": 5000 },
+    {
+      "action": "teleport", "actor": "rider", "map": 571,
+      "x": 2213.95, "y": 5273.15, "z": 11.2565, "o": 5.89294
+    },
+    { "action": "wait", "ms": 3000 },
+    { "action": "set_skill", "actor": "rider", "skill": 762, "value": 300, "maximum": 300 },
+    { "action": "unlearn", "actor": "rider", "spell": 54197, "all_specs": true },
+    { "action": "assert", "actor": "rider", "metric": "knows_spell", "spell": 54197, "equals": 0 },
+    {
+      "action": "snapshot", "actor": "rider", "metric": "server_packets", "opcode": 835,
+      "save_as": "northrend_without_training"
+    },
+    { "action": "cast", "actor": "rider", "spell": 900125 },
+    { "action": "assert", "actor": "rider", "metric": "mount_display_id", "min": 1, "within_ms": 5000 },
+    { "action": "wait", "ms": 1000 },
+    {
+      "action": "assert", "actor": "rider", "metric": "server_packets", "opcode": 835,
+      "relative_to": "northrend_without_training", "equals": 0,
+      "label": "Azeroth opt-in does not bypass Northrend Cold Weather Flying requirement"
+    },
+    { "action": "cancel_mount", "actor": "rider" },
+    { "action": "assert", "actor": "rider", "metric": "mount_display_id", "equals": 0, "within_ms": 5000 },
+    { "action": "learn", "actor": "rider", "spell": 54197 },
+    { "action": "assert", "actor": "rider", "metric": "knows_spell", "spell": 54197, "equals": 1 },
+    {
+      "action": "snapshot", "actor": "rider", "metric": "server_packets", "opcode": 835,
+      "save_as": "northrend_with_training"
+    },
+    { "action": "cast", "actor": "rider", "spell": 900125 },
+    { "action": "assert", "actor": "rider", "metric": "mount_display_id", "min": 1, "within_ms": 5000 },
+    {
+      "action": "assert", "actor": "rider", "metric": "server_packets", "opcode": 835,
+      "relative_to": "northrend_with_training", "min": 1, "within_ms": 1000,
+      "label": "Native Northrend flight remains available after Cold Weather Flying training"
+    },
+    { "action": "assert", "actor": "rider", "metric": "flight_speed_rate", "min": 3.799, "max": 3.801 },
+    {
+      "action": "snapshot", "actor": "rider", "metric": "server_packets", "opcode": 836,
+      "save_as": "northrend_flight_removals"
+    },
+    { "action": "cancel_mount", "actor": "rider" },
+    { "action": "assert", "actor": "rider", "metric": "mount_display_id", "equals": 0, "within_ms": 5000 },
+    {
+      "action": "assert", "actor": "rider", "metric": "server_packets", "opcode": 836,
+      "relative_to": "northrend_flight_removals", "min": 1, "within_ms": 1000
+    },
+    { "action": "assert", "actor": "rider", "metric": "run_speed_rate", "min": 0.999, "max": 1.001 }
+  ]
+}
