+bool PurchaseAscensionBotTalentRank(Player* player, uint32 entryId, uint32 rank, std::string& refusal)
+{
+    refusal.clear();
+    AscensionCompatData::CoATalentEntry const* entry = FindAscensionTalentEntry(entryId);
+    if (!ascensionCompatConfig.GetConfigValue<bool>(AscensionCompatConfig::ENABLED))
+        refusal = "CoA compatibility is disabled.";
+    else if (!player || !player->GetSession() || !player->GetSession()->IsBot())
+        refusal = "Only bot characters can purchase profile talents.";
+    else if (!player->IsInWorld() || !player->IsAlive() || player->IsInCombat() ||
+        player->IsBeingTeleported() || player->IsInFlight())
