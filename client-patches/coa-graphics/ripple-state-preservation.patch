+#pragma once
+
+namespace water_ripple_state_checks
+{
+constexpr uint32_t kContactCount = kMaxWaterContacts;
+constexpr double kStartSeconds = 600.0;
+constexpr float kContactSpacing = 1.0f;
+
+static_assert(kContactCount >= 24, "the ripple state regression reaches constants beyond c71");
+
+WaterContactFrame CrowdedWaterContacts()
+{
+    WaterContactFrame contacts;
+    for (uint32_t i = 0; i < kContactCount; ++i)
+    {
+        const float x = water_checks::kRippleUnitX + kContactSpacing * static_cast<float>(i % 8);
+        const float y = -4.0f + kContactSpacing * static_cast<float>(i / 8);
+        contacts.contacts[contacts.count++] =
+            water_checks::BasinContact(i + 1, x, y, water_checks::kRippleWadingDepth);
+    }
+    return contacts;
+}
+
+void CheckWaterRippleState(Harness& h)
+{
+    Config base;
+    vf_test_get_config(&base);
+    water_checks::BasinClient client(
+        h, water_checks::MakeWaterView(water_checks::kRippleEye, water_checks::kRippleEyeTarget));
+    Check(water_checks::AssignWaterData(water_checks::MakeSyntheticWaterData()),
+          "synthetic water data assigned for the crowded ripple state check");
+    water_checks::ReleaseRipples(client, base, kStartSeconds);
+    const Config ripples = water_checks::RippleConfig(base, 1.0f);
+    vf_test_set_config(&ripples);
+    const WaterContactFrame contacts = CrowdedWaterContacts();
+    water_checks::RenderRippleFrame(client, client.View(), kStartSeconds, contacts);
+    const uint64_t stepsBefore = water_checks::RippleStats().steps;
+    const water_checks::WaterFrameResult frame = water_checks::RenderRippleFrame(
+        client, client.View(), kStartSeconds + 2.0 * kWaterRippleStepSeconds, contacts);
+    const WaterRippleStats stats = water_checks::RippleStats();
+    float constants[water_checks::kSentinelPixelConstants * 4] = {};
+    const bool read = SUCCEEDED(h.dev->GetPixelShaderConstantF(0, constants, water_checks::kSentinelPixelConstants));
+    UINT changed = 0;
+    UINT firstChanged = water_checks::kSentinelPixelConstants;
+    for (UINT reg = 0; reg < water_checks::kSentinelPixelConstants; ++reg)
+    {
+        bool same = true;
+        for (UINT channel = 0; channel < 4; ++channel)
+        {
+            const UINT index = reg * 4 + channel;
+            same = same && constants[index] == 0.375f * index - 7.0f;
+        }
+        if (!same)
+        {
+            firstChanged = std::min(firstChanged, reg);
+            ++changed;
+        }
+    }
+    std::printf("     %u crowded water contacts, %llu ripple steps: %u client PS constants changed, first c%u\n",
+                stats.contacts, static_cast<unsigned long long>(stats.steps - stepsBefore), changed, firstChanged);
+    Check(frame.began && stats.shaded && stats.contacts == kContactCount && stats.steps > stepsBefore && read &&
+              changed == 0 && frame.stateKept,
+          "32 simultaneous wading contacts leave all 99 sentinel PS constants and the client's device state intact");
+    water_checks::ReleaseRipples(client, base, kStartSeconds + water_checks::kRippleGap);
+    vf_test_set_water_seconds(water_checks::kRealTime);
+    vf_test_set_config(&base);
+}
