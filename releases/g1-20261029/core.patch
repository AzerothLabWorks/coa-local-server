+    std::string broadcastWorldChannelName = "World";
+    uint32 zoneChannelId = 1;
+    std::string commandPrefix;
+    std::string commandSeparator = ";";
+};
+inline Config sPlayerbotAIConfig;
+inline uint32 urand(uint32 minimum, uint32) { return minimum; }
+
+#endif
diff --git a/apps/coa-tests/g1_social_adapter/run.py b/apps/coa-tests/g1_social_adapter/run.py
