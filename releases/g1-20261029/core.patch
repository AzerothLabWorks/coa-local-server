+    Require(!shared.Accept(200000, 9, "world", std::string(1025, 'x'), limits), "message memory bound");
+    Require(!shared.Accept(200000, 9, std::string(193, 'x'), "line", limits), "channel memory bound");
+    Require(shared.Accept(200000, 9, std::string(192, 'x'), std::string(1024, 'y'), limits),
+            "maximum channel and message lengths accepted");
