diff --git a/src/Ai/Class/Coa/CoaAiObjectContext.cpp b/src/Ai/Class/Coa/CoaAiObjectContext.cpp
new file mode 100644
index 00000000..3afd34e3
--- /dev/null
+++ b/src/Ai/Class/Coa/CoaAiObjectContext.cpp
@@ -0,0 +1,225 @@
+#include "CoaAiObjectContext.h"
+
+#include "Group.h"
+#include "Player.h"
+#include "PlayerbotAI.h"
+#include "Playerbots.h"
+#include "SpellInfo.h"
+#include "SpellMgr.h"
+
+#include <algorithm>
+#include <array>
+
+namespace
+{
+constexpr float BREWING_HEAL_BELOW_PCT = 80.0f;
+
+// Verified against the installed CoA Spell.dbc. Highest ranks are first.
+constexpr std::array<uint32, 9> LOAS_BREW =
+    {501206, 501205, 501204, 501203, 501202, 501201, 501200, 501199, 501198};
+constexpr std::array<uint32, 7> SPIRIT_IN_A_BOTTLE =
+    {501213, 501212, 501211, 501210, 501209, 501208, 501207};
+constexpr std::array<uint32, 6> POTION_TOSS =
+    {573435, 573434, 573433, 573432, 573431, 573430};
+
+Player* FindBrewingHealTarget(Player* bot)
+{
+    Player* target = bot->GetHealthPct() < BREWING_HEAL_BELOW_PCT ? bot : nullptr;
+    Group* group = bot->GetGroup();
+    if (!group)
+        return target;
+
+    for (GroupReference* member = group->GetFirstMember(); member; member = member->next())
+    {
+        Player* player = member->GetSource();
+        if (!player || !player->IsInWorld() || !player->IsAlive() || player->GetMap() != bot->GetMap() ||
+            bot->GetDistance2d(player) > 35.0f || !bot->IsWithinLOSInMap(player))
+            continue;
+
+        // Include the human group leader even when their account has GM rights.
+        if (player->GetHealthPct() < BREWING_HEAL_BELOW_PCT &&
+            (!target || player->GetHealthPct() < target->GetHealthPct()))
+            target = player;
+    }
+
+    return target;
+}
+
+template <std::size_t N>
+bool CastFirstAvailableHeal(PlayerbotAI* ai, Player* bot, Unit* target, std::array<uint32, N> const& ranks)
+{
+    for (uint32 spellId : ranks)
+        if (bot->HasSpell(spellId) && ai->CanCastSpell(spellId, target) && ai->CastSpell(spellId, target))
+            return true;
+
+    return false;
+}
+
+bool IsDamageSpell(SpellInfo const* spell)
+{
+    if (!spell || spell->IsPassive() || spell->IsPositive())
+        return false;
+
+    for (SpellEffectInfo const& effect : spell->Effects)
+        switch (effect.Effect)
+        {
+            case SPELL_EFFECT_SCHOOL_DAMAGE:
+            case SPELL_EFFECT_WEAPON_DAMAGE:
+            case SPELL_EFFECT_WEAPON_DAMAGE_NOSCHOOL:
+            case SPELL_EFFECT_NORMALIZED_WEAPON_DMG:
+            case SPELL_EFFECT_WEAPON_PERCENT_DAMAGE:
+            case SPELL_EFFECT_HEALTH_LEECH:
+            case SPELL_EFFECT_POWER_DRAIN:
+                return true;
+            default:
+                break;
+        }
+
+    return false;
+}
+
+class CoaAttackAction final : public Action
+{
+public:
+    explicit CoaAttackAction(PlayerbotAI* ai) : Action(ai, "coa attack") {}
+
+    bool Execute(Event) override
+    {
+        Unit* target = AI_VALUE(Unit*, "current target");
+        if (!target || !target->IsAlive())
+            return false;
+
+        Player* bot = botAI->GetBot();
+        std::vector<SpellInfo const*> candidates;
+        for (auto const& [spellId, playerSpell] : bot->GetSpellMap())
+        {
+            if (!playerSpell->Active || playerSpell->State == PLAYERSPELL_REMOVED)
+                continue;
+            SpellInfo const* spell = sSpellMgr->GetSpellInfo(spellId);
+            if (IsDamageSpell(spell))
+                candidates.push_back(spell);
+        }
+
+        std::sort(candidates.begin(), candidates.end(), [](SpellInfo const* left, SpellInfo const* right)
+        {
+            if (left->SpellLevel != right->SpellLevel)
+                return left->SpellLevel > right->SpellLevel;
+            return left->Id > right->Id;
+        });
+
+        for (SpellInfo const* spell : candidates)
+            if (botAI->CanCastSpell(spell->Id, target) && botAI->CastSpell(spell->Id, target))
+                return true;
+
+        return false;
+    }
+
+    bool isUseful() override { return AI_VALUE(Unit*, "current target") != nullptr; }
+    ActionThreatType getThreatType() override { return ActionThreatType::Single; }
+};
+
+class CoaBrewingHealAction final : public Action
+{
+public:
+    explicit CoaBrewingHealAction(PlayerbotAI* ai) : Action(ai, "coa brewing heal") {}
+
+    bool Execute(Event) override
+    {
+        Player* bot = botAI->GetBot();
+        Player* target = FindBrewingHealTarget(bot);
+        if (!target)
+            return false;
+
+        if (target->GetHealthPct() < 40.0f &&
+            CastFirstAvailableHeal(botAI, bot, target, SPIRIT_IN_A_BOTTLE))
+            return true;
+
+        if (target->GetHealthPct() < 65.0f &&
+            CastFirstAvailableHeal(botAI, bot, target, POTION_TOSS))
+            return true;
+
+        return CastFirstAvailableHeal(botAI, bot, target, LOAS_BREW);
+    }
+
+    bool isUseful() override { return FindBrewingHealTarget(botAI->GetBot()) != nullptr; }
+    ActionThreatType getThreatType() override { return ActionThreatType::Aoe; }
+};
+
+class CoaCombatStrategy final : public Strategy
+{
+public:
+    explicit CoaCombatStrategy(PlayerbotAI* ai) : Strategy(ai) {}
+    std::string const getName() override { return "coa"; }
+    uint32 GetType() const override { return STRATEGY_TYPE_COMBAT | STRATEGY_TYPE_DPS; }
+    std::vector<NextAction> getDefaultActions() override
+    {
+        return {NextAction("coa attack", ACTION_NORMAL), NextAction("melee", ACTION_DEFAULT)};
+    }
+};
+
+class CoaBrewingStrategy final : public Strategy
+{
+public:
+    explicit CoaBrewingStrategy(PlayerbotAI* ai) : Strategy(ai) {}
+    std::string const getName() override { return "coa brewing"; }
+    uint32 GetType() const override { return STRATEGY_TYPE_HEAL | STRATEGY_TYPE_RANGED; }
+    std::vector<NextAction> getDefaultActions() override
+    {
+        return {NextAction("coa brewing heal", ACTION_HIGH), NextAction("coa attack", ACTION_NORMAL),
+                NextAction("melee", ACTION_DEFAULT)};
+    }
+};
+
+class CoaBrewingRecoveryStrategy final : public Strategy
+{
+public:
+    explicit CoaBrewingRecoveryStrategy(PlayerbotAI* ai) : Strategy(ai) {}
+    std::string const getName() override { return "coa brewing recovery"; }
+    uint32 GetType() const override { return STRATEGY_TYPE_HEAL; }
+    std::vector<NextAction> getDefaultActions() override
+    {
+        return {NextAction("coa brewing heal", ACTION_NORMAL)};
+    }
+};
+
+class CoaStrategyFactory final : public NamedObjectContext<Strategy>
+{
+public:
+    CoaStrategyFactory()
+    {
+        creators["coa"] = [](PlayerbotAI* ai) -> Strategy* { return new CoaCombatStrategy(ai); };
+        creators["coa brewing"] = [](PlayerbotAI* ai) -> Strategy* { return new CoaBrewingStrategy(ai); };
+        creators["coa brewing recovery"] = [](PlayerbotAI* ai) -> Strategy* { return new CoaBrewingRecoveryStrategy(ai); };
+    }
+};
+
+class CoaActionFactory final : public NamedObjectContext<Action>
+{
+public:
+    CoaActionFactory()
+    {
+        creators["coa attack"] = [](PlayerbotAI* ai) -> Action* { return new CoaAttackAction(ai); };
+        creators["coa brewing heal"] = [](PlayerbotAI* ai) -> Action* { return new CoaBrewingHealAction(ai); };
+    }
+};
+}
+
+SharedNamedObjectContextList<Strategy> CoaAiObjectContext::sharedStrategyContexts;
+SharedNamedObjectContextList<Action> CoaAiObjectContext::sharedActionContexts;
+SharedNamedObjectContextList<Trigger> CoaAiObjectContext::sharedTriggerContexts;
+SharedNamedObjectContextList<UntypedValue> CoaAiObjectContext::sharedValueContexts;
+
+CoaAiObjectContext::CoaAiObjectContext(PlayerbotAI* ai)
+    : AiObjectContext(ai, sharedStrategyContexts, sharedActionContexts, sharedTriggerContexts, sharedValueContexts)
+{
+}
+
+void CoaAiObjectContext::BuildSharedContexts()
+{
+    AiObjectContext::BuildSharedStrategyContexts(sharedStrategyContexts);
+    sharedStrategyContexts.Add(new CoaStrategyFactory());
+    AiObjectContext::BuildSharedActionContexts(sharedActionContexts);
+    sharedActionContexts.Add(new CoaActionFactory());
+    AiObjectContext::BuildSharedTriggerContexts(sharedTriggerContexts);
+    AiObjectContext::BuildSharedValueContexts(sharedValueContexts);
+}
