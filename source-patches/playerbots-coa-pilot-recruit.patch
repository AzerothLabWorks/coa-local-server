+bool IsAllowedCoaTestPilot(Player* master, ObjectGuid guid, uint32 accountId, std::string const& name)
+{
+    static std::vector<std::string> const allowedNames = []
+    {
+        char const* configured = std::getenv("COA_TEST_PILOT_NAMES");
+        return ParseCoaTestPilotNames(configured ? configured : "");
+    }();
+
+    bool const realGameMaster = master && master->GetSession() && !master->GetSession()->IsBot() &&
+        master->GetSession()->GetSecurity() >= SEC_GAMEMASTER;
+    if (!realGameMaster || std::find(allowedNames.begin(), allowedNames.end(), name) == allowedNames.end() ||
+        !sPlayerbotAIConfig.IsInRandomAccountList(accountId))
+        return false;
+
+    CharacterCacheEntry const* candidate = sCharacterCache->GetCharacterCacheByGuid(guid);
+    if (!candidate || candidate->AccountId != accountId || candidate->Name != name ||
+        candidate->Class != CLASS_WITCH_DOCTOR || !candidate->Level || candidate->Level > master->GetLevel() ||
+        ObjectAccessor::FindConnectedPlayer(guid))
+        return false;
+
+    bool const groupAllowed = candidate->GroupGuid.IsEmpty() ||
+        (master->GetGroup() && candidate->GroupGuid == master->GetGroup()->GetGUID());
+    if (!groupAllowed || !sRandomPlayerbotMgr.IsAccountType(accountId, 0))
+        return false;
+
+    // This is an explicit GM command, not a periodic AI check. Reuse the core's
+    // prepared settings query; do not authorize a login after a failed read.
+    auto* statement = CharacterDatabase.GetPreparedStatement(CHAR_SEL_CHAR_SETTINGS);
+    statement->SetData(0, guid.GetCounter());
+    PreparedQueryResult result = CharacterDatabase.Query(statement);
+    if (!result)
+        return false;
+
+    uint32 specializationId = 0;
+    do
+    {
+        Field* fields = result->Fetch();
+        if (fields[0].Get<std::string>() != "core.ascension_active_spec")
+            continue;
+
+        std::istringstream data(fields[1].Get<std::string>());
+        if (!(data >> specializationId))
+            return false;
+        data >> std::ws;
+        if (!data.eof())
+            return false;
+        break;
+    } while (result->NextRow());
+
+    return CanRecruitCoaTestPilot(realGameMaster, true, true, true, groupAllowed,
+        candidate->Class, candidate->Level, master->GetLevel(), specializationId);
+}
