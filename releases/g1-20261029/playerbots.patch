+bool PlayerbotAI::IsSocialChatRequest(uint32 type, std::string const& text, Player* sender, uint32 lang) const
+{
+    if (!bot || !sPlayerbotAIConfig.socialChatEnabled || lang == LANG_ADDON || !IsRealPlayer(sender) ||
+        !sender->GetSession() || sender->GetSession()->IsBot())
+        return false;
+    if (type != CHAT_MSG_WHISPER && type != CHAT_MSG_PARTY && type != CHAT_MSG_RAID &&
+        type != CHAT_MSG_SAY && type != CHAT_MSG_CHANNEL)
+        return false;
+    if (!sPlayerbotAIConfig.commandPrefix.empty() && text.starts_with(sPlayerbotAIConfig.commandPrefix))
+        return false;
+    if (!sPlayerbotAIConfig.commandSeparator.empty() &&
+        text.find(sPlayerbotAIConfig.commandSeparator) != std::string::npos)
+        return false;
+    return BotSocialPolicy::Parse(text, bot->GetName(), type == CHAT_MSG_WHISPER) != BotSocialPolicy::Intent::None;
+}
