+bool IsExplicitChoice(AscensionCompatData::CoATalentEntry const& entry)
+{
+    return entry.AECost || entry.TECost || IsSelectableFree(entry.EntryId);
+}
+
+std::uint32_t ChosenRank(AscensionCompatData::CoATalentEntry const& entry, RecordedRank const& recordedRank)
+{
+    std::uint32_t const rank = recordedRank(entry.EntryId);
+    return rank <= entry.SpellCount ? rank : 0;
+}
+
+std::vector<KnownEntry> KnownEntries(std::uint8_t classId, HasSpell const& hasSpell,
+                                   RecordedRank const& recordedRank)
+{
+    std::vector<KnownEntry> known;
+    for (AscensionCompatData::CoATalentEntry const& entry : AscensionCompatData::CoATalentEntries)
+    {
+        if (entry.ClassId != classId)
+            continue;
+        std::uint32_t const rank = IsExplicitChoice(entry) ? ChosenRank(entry, recordedRank) : KnownRank(entry, hasSpell);
+        if (rank)
+            known.push_back({ entry.EntryId, rank });
+    }
+    return known;
+}
