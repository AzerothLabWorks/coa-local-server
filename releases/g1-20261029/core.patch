--- /dev/null
+++ b/apps/coa-gameplay-test/scenarios/g1-artisans-profession-limit.json
@@ -0,0 +1,104 @@
+{
+  "schema": 1,
+  "name": "G1 summoned Book of Artisans respects both primary profession slots",
+  "contract": [
+    "Requires MaxPrimaryTradeSkill=2, local profession tools, and the alternate Book of Artisans module disabled.",
+    "G1 opens a filtered trainer after the real 750750 summon creates the player's owned book 57500.",
+    "A fresh character must first see Apprentice Engineer 4039 as Available=0. After learning Alchemy and Tailoring,",
+    "a fresh trainer window must retain Journeyman Tailor 3912 as Available=0 but omit Apprentice Engineer.",
+    "The book filters unavailable rows while the native purchase gate still refuses a third primary profession.",
+    "A real trainer-buy packet for 4039 must emit SMSG_TRAINER_BUY_FAILED for that spell, observed through",
+    "spellbook_buy_failed rather than the generic extension-packet capture. No success response, money charge,",
+    "Engineering spell 4036 or skill 202 may result. This checks refusal, not its unobserved reason byte.",
+    "This verifies the shared native trainer state and purchase gate",
+    "through the candidate's actual summon path, not the disabled module's placed-book gossip page."
+  ],
+  "timeout_ms": 90000,
+  "players": [
+    { "id": "artisan", "race": 1, "class": 1, "level": 60, "bot": false }
+  ],
+  "steps": [
+    { "action": "wait", "ms": 5000, "label": "Settle ordinary login hooks" },
+    { "action": "learn", "actor": "artisan", "spell": 750750 },
+    { "action": "money", "actor": "artisan", "copper": 100000 },
+    { "action": "assert", "actor": "artisan", "metric": "skill_value", "skill": 171, "equals": 0 },
+    { "action": "assert", "actor": "artisan", "metric": "skill_value", "skill": 197, "equals": 0 },
+    { "action": "assert", "actor": "artisan", "metric": "skill_value", "skill": 202, "equals": 0 },
+    { "action": "assert", "actor": "artisan", "metric": "knows_spell", "spell": 4036, "equals": 0 },
+    {
+      "action": "snapshot", "actor": "artisan", "metric": "trainer_list_packets",
+      "save_as": "initial_windows"
+    },
+    { "action": "cast", "actor": "artisan", "spell": 750750, "label": "Summon the real owned trainer" },
+    { "action": "assert", "actor": "artisan", "metric": "pet_entry", "equals": 57500, "within_ms": 3000 },
+    { "action": "assert", "actor": "artisan", "metric": "owned_creature_count", "entry": 57500, "equals": 1 },
+    {
+      "action": "assert", "actor": "artisan", "metric": "trainer_list_packets",
+      "relative_to": "initial_windows", "equals": 1, "within_ms": 3000
+    },
+    {
+      "action": "assert", "actor": "artisan", "metric": "trainer_window_state", "spell": 4039,
+      "equals": 0, "label": "With free profession slots Apprentice Engineer is available"
+    },
+    { "action": "learn", "actor": "artisan", "spell": 2259 },
+    { "action": "learn", "actor": "artisan", "spell": 3908 },
+    { "action": "set_skill", "actor": "artisan", "skill": 197, "value": 75, "maximum": 75 },
+    { "action": "assert", "actor": "artisan", "metric": "skill_value", "skill": 171, "min": 1 },
+    { "action": "assert", "actor": "artisan", "metric": "skill_value", "skill": 197, "equals": 75 },
+    { "action": "wait", "ms": 1600 },
+    { "action": "reset_cooldown", "actor": "artisan", "spell": 750750 },
+    {
+      "action": "snapshot", "actor": "artisan", "metric": "trainer_list_packets",
+      "save_as": "before_limited_window"
+    },
+    {
+      "action": "cast", "actor": "artisan", "spell": 750750,
+      "label": "Summon again to request a fresh native trainer window"
+    },
+    { "action": "assert", "actor": "artisan", "metric": "pet_entry", "equals": 57500, "within_ms": 3000 },
+    {
+      "action": "assert", "actor": "artisan", "metric": "trainer_list_packets",
+      "relative_to": "before_limited_window", "equals": 1, "within_ms": 3000,
+      "label": "Only a newly emitted trainer window can satisfy the profession-limit checks"
+    },
+    {
+      "action": "assert", "actor": "artisan", "metric": "trainer_window_state", "spell": 3912,
+      "equals": 0, "label": "Journeyman Tailor remains available with both profession slots filled"
+    },
+    {
+      "action": "assert", "actor": "artisan", "metric": "trainer_window_state", "spell": 4039,
+      "equals": -1, "label": "The book omits a third primary profession that the native purchase gate refuses"
+    },
+    {
+      "action": "snapshot", "actor": "artisan", "metric": "spellbook_buy_failed", "spell": 4039,
+      "save_as": "before_refused_purchase"
+    },
+    {
+      "action": "snapshot", "actor": "artisan", "metric": "carried_money",
+      "save_as": "before_purchase_money"
+    },
+    {
+      "action": "assert", "actor": "artisan", "metric": "spellbook_buy_succeeded", "spell": 4039,
+      "equals": 0
+    },
+    { "action": "trainer_buy", "actor": "artisan", "spell": 4039 },
+    {
+      "action": "assert", "actor": "artisan", "metric": "spellbook_buy_failed", "spell": 4039,
+      "relative_to": "before_refused_purchase", "equals": 1, "within_ms": 1000,
+      "label": "The real trainer purchase produces a new failure packet for Apprentice Engineer"
+    },
+    {
+      "action": "assert", "actor": "artisan", "metric": "spellbook_buy_succeeded", "spell": 4039,
+      "equals": 0
+    },
+    {
+      "action": "assert", "actor": "artisan", "metric": "carried_money",
+      "relative_to": "before_purchase_money", "equals": 0
+    },
+    { "action": "assert", "actor": "artisan", "metric": "knows_spell", "spell": 4036, "equals": 0 },
+    { "action": "assert", "actor": "artisan", "metric": "skill_value", "skill": 202, "equals": 0 },
+    { "action": "assert", "actor": "artisan", "metric": "knows_spell", "spell": 2259, "equals": 1 },
+    { "action": "assert", "actor": "artisan", "metric": "knows_spell", "spell": 3908, "equals": 1 },
+    { "action": "assert", "actor": "artisan", "metric": "skill_value", "skill": 197, "equals": 75 }
+  ]
+}
