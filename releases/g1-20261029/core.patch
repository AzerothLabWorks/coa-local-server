index 0000000000000000000000000000000000000000..b179c3fbec6bc01c91e9f24e0e907422da2b594b
--- /dev/null
+++ b/src/server/coa/AscensionProfessionCastTime.cpp
@@ -0,0 +1,111 @@
+/* Copyright (C) 2016+ AzerothCore, GNU AGPL v3. */
+
+#include "AscensionProfessionCastTime.h"
+#include "Config.h"
+#include "DBCStructure.h"
+#include "SharedDefines.h"
+#include "Spell.h"
+#include "SpellInfo.h"
+#include "SpellMgr.h"
+#include "Unit.h"
+#include "WorldScript.h"
+#include <algorithm>
+#include <atomic>
+
+namespace AscensionProfessionCastTime
+{
+namespace
+{
+std::atomic<uint32> CastTimeCapMs{ 0 };
+
+bool IsCraftingSkill(uint32 skill)
+{
+    switch (skill)
+    {
+        case SKILL_FIRST_AID:
+        case SKILL_BLACKSMITHING:
+        case SKILL_LEATHERWORKING:
+        case SKILL_ALCHEMY:
+        case SKILL_COOKING:
+        case SKILL_MINING:
+        case SKILL_TAILORING:
+        case SKILL_ENGINEERING:
+        case SKILL_ENCHANTING:
+        case SKILL_JEWELCRAFTING:
+        case SKILL_INSCRIPTION:
+            return true;
+        default:
+            return false;
+    }
+}
+
+bool IsCraftingEffect(uint32 effect)
+{
+    switch (effect)
+    {
+        case SPELL_EFFECT_CREATE_ITEM:
+        case SPELL_EFFECT_CREATE_RANDOM_ITEM:
+        case SPELL_EFFECT_ENCHANT_ITEM:
+        case SPELL_EFFECT_ENCHANT_ITEM_TEMPORARY:
+        case SPELL_EFFECT_ENCHANT_ITEM_PRISMATIC:
+        case SPELL_EFFECT_CREATE_ITEM_2:
+            return true;
+        default:
+            return false;
+    }
+}
+
+class Configuration : public WorldScript
+{
+public:
+    Configuration() : WorldScript("AscensionProfessionCastTimeConfiguration", { WORLDHOOK_ON_AFTER_CONFIG_LOAD }) { }
+
+    void OnAfterConfigLoad(bool) override
+    {
+        int32 const configured = sConfigMgr->GetOption<int32>("CoA.ProfessionCastTimeCapMs", 0);
+        CastTimeCapMs.store(uint32(std::max(configured, 0)), std::memory_order_relaxed);
+    }
+};
+}
+
+bool IsEligible(SpellInfo const* spellInfo)
+{
+    if (!spellInfo || spellInfo->IsChanneled() || spellInfo->HasEffect(SPELL_EFFECT_SKILL_STEP) ||
+        spellInfo->HasEffect(SPELL_EFFECT_LEARN_SPELL))
+        return false;
+
+    auto const abilities = sSpellMgr->GetSkillLineAbilityMapBounds(spellInfo->Id);
+    for (auto ability = abilities.first; ability != abilities.second; ++ability)
+    {
+        uint32 const skill = ability->second->SkillLine;
+        for (SpellEffectInfo const& effect : spellInfo->Effects)
+        {
+            if (IsCraftingSkill(skill) && IsCraftingEffect(effect.Effect))
+                return true;
+
+            if (skill == SKILL_MINING && effect.Effect == SPELL_EFFECT_OPEN_LOCK &&
+                effect.MiscValue == LOCKTYPE_MINING)
+                return true;
+
+            if ((skill == SKILL_MINING || skill == SKILL_SKINNING) && effect.Effect == SPELL_EFFECT_SKINNING)
+                return true;
+        }
+    }
+    return false;
+}
+
+std::uint32_t LimitCastTime(Unit* caster, SpellInfo const* spellInfo, Spell* spell, std::uint32_t castTime)
+{
+    uint32 const cap = CastTimeCapMs.load(std::memory_order_relaxed);
+    if (!cap || castTime <= cap || !caster || !caster->IsPlayer() || !spell || spell->IsTriggered() ||
+        spell->m_CastItem || spell->m_castItemGUID || !IsEligible(spellInfo))
+        return castTime;
+
+    return cap;
+}
+}
+
+void AddSC_AscensionProfessionCastTime()
+{
+    new AscensionProfessionCastTime::Configuration();
+}
