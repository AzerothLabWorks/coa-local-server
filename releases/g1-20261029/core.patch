+    std::string channel;
+};
+
+inline std::vector<Sent> FixtureMessages;
+
+struct WorldSession
+{
+    bool bot = false;
+    bool IsBot() const { return bot; }
+};
+
+struct Social
+{
+    std::set<std::uint64_t> ignored;
+    bool HasIgnore(ObjectGuid guid) const { return ignored.contains(guid.raw); }
+};
+
+class Group
+{
+public:
+    bool raid = false;
+    bool isRaidGroup() const { return raid; }
+};
+
+class Channel;
+inline std::map<Channel const*, std::set<std::uint64_t>> FixtureChannelMembers;
+
+class Player
+{
+public:
+    std::uint64_t guid = 1;
+    std::string name = "Pablo";
+    bool controlled = true;
+    bool hasSession = true;
+    bool inWorld = true;
+    bool teleporting = false;
+    bool removing = false;
+    bool friendly = true;
+    bool hasSocial = true;
+    bool tank = false;
+    bool heal = false;
+    int map = 1;
+    int phase = 1;
+    float distance = 0.0f;
+    uint32 team = 1;
+    uint32 classId = 13;
+    uint32 level = 25;
+    Group* group = nullptr;
+    WorldSession session;
+    Social social;
+
+    ObjectGuid GetGUID() const { return {guid}; }
+    std::string const& GetName() const { return name; }
+    WorldSession* GetSession() { return hasSession ? &session : nullptr; }
+    bool IsInWorld() const { return inWorld; }
+    bool IsBeingTeleported() const { return teleporting; }
+    bool IsDuringRemoveFromWorld() const { return removing; }
+    int* FindMap() { return map ? &map : nullptr; }
+    Social* GetSocial() { return hasSocial ? &social : nullptr; }
+    Group* GetGroup() const { return group; }
+    uint32 GetTeamId() const { return team; }
+    uint32 getClass() const { return classId; }
+    uint32 GetLevel() const { return level; }
+    bool IsInMap(Player const* other) const { return map && map == other->map; }
+    bool InSamePhase(Player const* other) const { return phase == other->phase; }
+    bool IsWithinDistInMap(Player const* other, float range) const
+    {
+        return IsInMap(other) && other->distance <= range;
+    }
+    bool IsFriendlyTo(Player const* other) const { return friendly && other->friendly; }
+    void Whisper(std::string const& text, uint32, Player const* target)
+    {
+        FixtureMessages.push_back({CHAT_MSG_WHISPER, guid, target->guid, text, {}});
+    }
+};
+
+inline bool IsRealPlayer(Player* player) { return player && !player->controlled; }
+inline std::map<std::uint64_t, Player*> FixturePlayers;
+namespace ObjectAccessor
+{
+inline Player* FindPlayer(ObjectGuid guid)
+{
+    auto const found = FixturePlayers.find(guid.raw);
+    return found == FixturePlayers.end() ? nullptr : found->second;
+}
+}
+
+class Channel
+{
+public:
+    std::string name = "World";
+    uint32 id = 0;
+#include "ChannelMembershipProduction.h"
+    std::string const& GetName() const { return name; }
+    uint32 GetChannelId() const { return id; }
+    void Say(ObjectGuid bot, std::string const& text, uint32)
+    {
+        FixtureMessages.push_back({CHAT_MSG_CHANNEL, bot.raw, 0, text, name});
+    }
+
+private:
+    bool IsOn(ObjectGuid guid) const { return FixtureChannelMembers[this].contains(guid.raw); }
+};
