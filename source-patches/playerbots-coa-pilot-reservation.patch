+std::set<uint32> GetReservedCoaTestPilotAccounts(std::vector<std::string> const& names,
+    std::vector<uint32> const& randomAccounts, std::map<uint32, uint8> const& assignments)
+{
+    std::set<uint32> reservedAccounts;
+    for (std::string const& name : names)
+    {
+        CharacterCacheEntry const* candidate = sCharacterCache->GetCharacterCacheByName(name);
+        if (!candidate || candidate->Class < 12 || candidate->Class > 32 ||
+            std::find(randomAccounts.begin(), randomAccounts.end(), candidate->AccountId) == randomAccounts.end())
+            continue;
+
+        auto const assignment = assignments.find(candidate->AccountId);
+        if (assignment != assignments.end() && assignment->second == 0)
+            reservedAccounts.insert(candidate->AccountId);
+    }
+    return reservedAccounts;
+}
+}
