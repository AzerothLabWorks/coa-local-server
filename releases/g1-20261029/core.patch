+        (entry->SpecId && entry->SpecId != GetAscensionActiveSpecialization(player)) ||
+        rank > entry->SpellCount || (!entry->AECost && !entry->TECost &&
+            !AscensionClassService::GetSelectableFreeGroup(entryId)))
+        refusal = "The requested talent is not a selectable entry of this bot's build.";
+    else if (rank < GetAscensionTalentRank(player, entryId))
+        refusal = "Profile preparation never lowers existing talent ranks.";
