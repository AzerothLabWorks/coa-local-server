+};
+struct Config
+{
+    std::unordered_map<std::string, bool> values;
+    uint32 reads = 0;
+    template<class T> T GetOption(char const* key, T fallback)
+    {
+        ++reads;
+        auto found = values.find(key);
+        return found == values.end() ? fallback : T(found->second);
+    }
