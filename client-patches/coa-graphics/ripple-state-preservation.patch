+D3DCOLOR Shade(D3DCOLOR c, float s)
+{
+    auto ch = [&](int shift) {
+        return static_cast<D3DCOLOR>(std::fmin(((c >> shift) & 0xFF) * s, 255.0f)) << shift;
+    };
+    return 0xFF000000u | ch(16) | ch(8) | ch(0);
+}
