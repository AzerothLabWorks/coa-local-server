+    bool HasStrategy(char const*, uint32) const { return mountStrategy; }
+    uint32 GetState() const { return state; }
+    bool CanCastSpell(uint32 id, Player*) const
+    {
+        return bot->HasSpell(id) && !bot->mounted && !bot->moving && !bot->casting &&
+            !bot->denied && !bot->cooldown && !bot->combat;
+    }
+    bool CastSpell(uint32 id, Player*)
+    {
+        ++casts;
+        if (!CanCastSpell(id, bot) || !castSucceeds)
+            return false;
+        bot->mounted = true;
+        bot->mountSpell = id;
+        bot->flightAura = sSpellMgr->GetSpellInfo(id)->HasAura(SPELL_AURA_MOD_INCREASE_MOUNTED_FLIGHT_SPEED);
+        return true;
+    }
+};
