diff --git a/src/Util/BotPartySocialPolicy.h b/src/Util/BotPartySocialPolicy.h
new file mode 100644
index 0000000000000000000000000000000000000000..8e245fda67d81b7001b3323159fd0dd45fe5560d
--- /dev/null
+++ b/src/Util/BotPartySocialPolicy.h
@@ -0,0 +1,139 @@
+#ifndef PLAYERBOTS_BOT_PARTY_SOCIAL_POLICY_H
+#define PLAYERBOTS_BOT_PARTY_SOCIAL_POLICY_H
+
+#include <cstddef>
+#include <cstdint>
+#include <unordered_map>
+
+namespace bot_party_social
+{
+using Milliseconds = std::uint64_t;
+
+enum class Notice
+{
+    None,
+    Drinking,
+    ManaReady
+};
+
+struct Snapshot
+{
+    std::uint64_t group = 0;
+    bool eligible = false;
+    bool drinking = false;
+    float manaPercent = 0.0f;
+};
+
+class Episode
+{
+public:
+    Notice Observe(Snapshot const& snapshot, Milliseconds now)
+    {
+        if (!snapshot.eligible || !snapshot.group)
+        {
+            Reset();
+            return Notice::None;
+        }
+
+        if (group != snapshot.group)
+        {
+            Reset();
+            group = snapshot.group;
+        }
+
+        if (snapshot.drinking)
+        {
+            if (drinking)
+                return Notice::None;
+
+            drinking = true;
+            started = now;
+            return snapshot.manaPercent < ReadyManaPercent && now >= nextDrinkNotice
+                ? Notice::Drinking : Notice::None;
+        }
+
+        bool const ready = drinking && announced && snapshot.manaPercent >= ReadyManaPercent &&
+            now >= started && now - started <= MaximumEpisodeDuration;
+        drinking = false;
+        announced = false;
+        return ready ? Notice::ManaReady : Notice::None;
+    }
+
+    void Confirm(Notice notice, Milliseconds now)
+    {
+        if (notice == Notice::Drinking && drinking)
+        {
+            announced = true;
+            nextDrinkNotice = now + DrinkNoticeCooldown;
+        }
+    }
+
+    void Reset()
+    {
+        group = 0;
+        drinking = false;
+        announced = false;
+        started = 0;
+    }
+
+    static constexpr float ReadyManaPercent = 90.0f;
+    static constexpr Milliseconds DrinkNoticeCooldown = 90000;
+    static constexpr Milliseconds MaximumEpisodeDuration = 120000;
+
+private:
+    std::uint64_t group = 0;
+    bool drinking = false;
+    bool announced = false;
+    Milliseconds started = 0;
+    Milliseconds nextDrinkNotice = 0;
+};
+
+class GroupBudget
+{
+public:
+    bool Acquire(std::uint64_t group, Milliseconds now)
+    {
+        if (!group)
+            return false;
+
+        if (now >= nextCleanup)
+        {
+            for (auto it = lastNotice.begin(); it != lastNotice.end();)
+            {
+                if (now >= it->second && now - it->second >= Retention)
+                    it = lastNotice.erase(it);
+                else
+                    ++it;
+            }
+            nextCleanup = now + Retention;
+        }
+
+        auto const it = lastNotice.find(group);
+        if (it != lastNotice.end())
+        {
+            if (now < it->second || now - it->second < NoticeCooldown)
+                return false;
+            it->second = now;
+            return true;
+        }
+
+        if (lastNotice.size() >= MaximumGroups)
+            return false;
+
+        lastNotice.emplace(group, now);
+        return true;
+    }
+
+    std::size_t Size() const { return lastNotice.size(); }
+
+    static constexpr Milliseconds NoticeCooldown = 6000;
+    static constexpr Milliseconds Retention = 60000;
+    static constexpr std::size_t MaximumGroups = 1024;
+
+private:
+    std::unordered_map<std::uint64_t, Milliseconds> lastNotice;
+    Milliseconds nextCleanup = 0;
+};
+}
+
+#endif
diff --git a/src/Util/BotSocialChat.cpp b/src/Util/BotSocialChat.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..68ef24c98b0797c6495314680225c64787b185d0
--- /dev/null
+++ b/src/Util/BotSocialChat.cpp
@@ -0,0 +1,201 @@
+#include "BotSocialChat.h"
+#include "Channel.h"
+#include "ChannelMgr.h"
+#include "ChatHelper.h"
+#include "Group.h"
+#include "ObjectAccessor.h"
+#include "Player.h"
+#include "PlayerbotAI.h"
+#include "PlayerbotAIConfig.h"
+#include "Random.h"
+#include "SocialMgr.h"
+#include "WorldSession.h"
+#include <array>
+#include <chrono>
+#include <mutex>
+
+namespace
+{
+std::uint64_t Now()
+{
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+bool ReserveSender(ObjectGuid sender, std::uint64_t now)
+{
+    static std::mutex mutex;
+    static BotSocialPolicy::SenderBudget budget;
+    std::lock_guard<std::mutex> lock(mutex);
+    return budget.Accept(sender.GetRawValue(), now);
+}
+
+Channel* SharedChannel(Player* bot, Player* sender, std::string const& name)
+{
+    ChannelMgr* manager = ChannelMgr::forTeam(bot->GetTeamId());
+    if (!manager)
+        return nullptr;
+    Channel* channel = manager->GetChannel(name, bot, false);
+    if (!channel || !channel->HasMember(bot->GetGUID()) || !channel->HasMember(sender->GetGUID()))
+        return nullptr;
+    if (channel->GetName() != sPlayerbotAIConfig.broadcastWorldChannelName &&
+        channel->GetChannelId() != sPlayerbotAIConfig.zoneChannelId)
+        return nullptr;
+    return channel;
+}
+
+bool Eligible(Player* bot, Player* sender, std::uint32_t type, std::string const& channel)
+{
+    if (!bot || !sender || sender == bot || !IsRealPlayer(sender) || !sender->GetSession() ||
+        sender->GetSession()->IsBot() || !sender->IsInWorld() ||
+        sender->IsBeingTeleported() || sender->IsDuringRemoveFromWorld() || !sender->FindMap() ||
+        !bot->IsInWorld() || bot->IsBeingTeleported() || bot->IsDuringRemoveFromWorld() || !bot->FindMap() ||
+        (sender->GetSocial() && sender->GetSocial()->HasIgnore(bot->GetGUID())))
+        return false;
+    switch (type)
+    {
+        case CHAT_MSG_WHISPER:
+            return true;
+        case CHAT_MSG_PARTY:
+            return bot->GetGroup() && sender->GetGroup() == bot->GetGroup();
+        case CHAT_MSG_RAID:
+            return bot->GetGroup() && bot->GetGroup()->isRaidGroup() && sender->GetGroup() == bot->GetGroup();
+        case CHAT_MSG_SAY:
+            return bot->IsInMap(sender) && bot->InSamePhase(sender) &&
+                bot->IsWithinDistInMap(sender, 25.0f) && bot->IsFriendlyTo(sender);
+        case CHAT_MSG_CHANNEL:
+            return SharedChannel(bot, sender, channel) != nullptr;
+        default:
+            return false;
+    }
+}
+
+std::string Reply(PlayerbotAI& ai, BotSocialPolicy::Intent intent, Player* sender)
+{
+    Player* bot = ai.GetBot();
+    std::size_t const style = bot->GetGUID().GetRawValue() % 3;
+    using Intent = BotSocialPolicy::Intent;
+    switch (intent)
+    {
+        case Intent::Hello:
+        {
+            std::array<std::string, 3> const phrases = {
+                "Hello, " + sender->GetName() + "! Good to see you.",
+                "Greetings, " + sender->GetName() + ".",
+                "Hello, " + sender->GetName() + "."};
+            return phrases[style];
+        }
+        case Intent::Thanks:
+        {
+            std::array<char const*, 3> const phrases = {"Any time! Happy to help.", "You are most welcome.",
+                                                       "You're welcome."};
+            return phrases[style];
+        }
+        case Intent::Goodbye:
+        {
+            std::array<char const*, 3> const phrases = {"See you around! Safe travels.", "May your journey go well.",
+                                                       "Safe travels."};
+            return phrases[style];
+        }
+        case Intent::ClassRole:
+        {
+            std::string const name = ChatHelper::FormatClass(bot->getClass());
+            if (name.empty())
+                return "I'm still finding my role.";
+            std::string const role = PlayerbotAI::IsTank(bot) ? "tanking" :
+                PlayerbotAI::IsHeal(bot) ? "healing" : "dealing damage";
+            return "I'm a level " + std::to_string(bot->GetLevel()) + " " + name + ", focused on " + role + ".";
+        }
+        case Intent::Location:
+        {
+            if (AreaTableEntry const* zone = ai.GetCurrentZone())
+                return "I'm in " + ai.GetLocalizedAreaName(zone) + ".";
+            return "I'm between destinations right now.";
+        }
+        default:
+            return {};
+    }
+}
+}
+
+bool BotSocialChat::Handle(PlayerbotAI& ai, std::uint32_t type, ObjectGuid senderGuid,
+                           std::string const& message, std::string const& channel)
+{
+    if (!sPlayerbotAIConfig.socialChatEnabled)
+    {
+        std::lock_guard<std::mutex> lock(stateMutex);
+        pending.reset();
+        return false;
+    }
+    Player* bot = ai.GetBot();
+    if (!bot)
+        return false;
+    BotSocialPolicy::Intent const intent = BotSocialPolicy::Parse(message, bot->GetName(),
+                                                                 type == CHAT_MSG_WHISPER);
+    if (intent == BotSocialPolicy::Intent::None)
+        return false;
+    Player* sender = ObjectAccessor::FindPlayer(senderGuid);
+    if (!Eligible(bot, sender, type, channel))
+        return true;
+    std::uint64_t const now = Now();
+    std::lock_guard<std::mutex> lock(stateMutex);
+    BotSocialPolicy::Cooldown acceptedCooldown = cooldown;
+    if (pending || !acceptedCooldown.Accept(senderGuid.GetRawValue(), intent, now) || !ReserveSender(senderGuid, now))
+        return true;
+    cooldown = acceptedCooldown;
+    pending = Pending{type, senderGuid, intent, channel, now + urand(1000, 3000), now + 10000};
+    return true;
+}
+
+void BotSocialChat::Update(PlayerbotAI& ai)
+{
+    std::uint64_t const now = Now();
+    std::optional<Pending> ready;
+    {
+        std::lock_guard<std::mutex> lock(stateMutex);
+        if (!sPlayerbotAIConfig.socialChatEnabled)
+        {
+            pending.reset();
+            return;
+        }
+        if (!pending || now < pending->due)
+            return;
+        ready = *pending;
+        pending.reset();
+    }
+    Pending const& reply = *ready;
+    Player* bot = ai.GetBot();
+    Player* sender = ObjectAccessor::FindPlayer(reply.sender);
+    if (now > reply.expires || !Eligible(bot, sender, reply.type, reply.channel))
+        return;
+    std::string const text = Reply(ai, reply.intent, sender);
+    if (text.empty())
+        return;
+    switch (reply.type)
+    {
+        case CHAT_MSG_WHISPER:
+            bot->Whisper(text, LANG_UNIVERSAL, sender);
+            break;
+        case CHAT_MSG_PARTY:
+            ai.SayToParty(text);
+            break;
+        case CHAT_MSG_RAID:
+            ai.SayToRaid(text);
+            break;
+        case CHAT_MSG_SAY:
+            ai.Say(text);
+            break;
+        case CHAT_MSG_CHANNEL:
+            if (Channel* channel = SharedChannel(bot, sender, reply.channel))
+                channel->Say(bot->GetGUID(), text, LANG_UNIVERSAL);
+            break;
+        default:
+            break;
+    }
+}
+
+void BotSocialChat::Reset()
+{
+    std::lock_guard<std::mutex> lock(stateMutex);
+    pending.reset();
+}
