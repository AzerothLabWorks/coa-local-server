@@ -0,0 +1,856 @@
+CLI_DESCRIPTION = "Check pinned profiles, native catalogue legality and extracted bot preparation/LFG policies."
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import sys
+import tempfile
+
+
+HERE = Path(__file__).resolve().parent
