index 0000000000000000000000000000000000000000..9672b5ffb378f5e328e9f3f9044b3b4d3c2fc3d6
--- /dev/null
+++ b/apps/coa-tests/g1_mount_flight/run.py
@@ -0,0 +1,84 @@
+CLI_DESCRIPTION = "Check mount flight hooks, accepted Blossomback data, speed tiers and CoA riding setup."
+
+import argparse
+import os
+from pathlib import Path
+import re
+import shlex
+import shutil
+import subprocess
+import sys
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[3]
+HERE = Path(__file__).resolve().parent
+
+
+def definition(source, signature):
+    start = source.index(signature)
+    brace = source.index("{", start)
+    end = brace + 1
+    depth = 1
+    while depth and end < len(source):
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    if depth:
+        raise ValueError(f"Unterminated production definition: {signature}")
+    return source[start:end]
+
+
+def blossomback(directory):
+    sys.path.insert(0, str(ROOT / "apps/coa-dbc"))
+    from inspect_dbc import DataSet
+
+    record = DataSet(directory, root=ROOT).record("Spell", 900125)
+    fields = {field["name"]: field for field in record["fields"]}
+    assert not any(field.get("error") for field in fields.values())
+    assert record["name"] == "Blossomback Arboon"
+    assert tuple(fields[f"Effect[{i}]"]["value"] for i in range(3)) == (6, 6, 6)
+    assert tuple(fields[f"EffectApplyAuraName[{i}]"]["value"] for i in range(3)) == (78, 32, 207)
+    assert tuple(fields[f"EffectBasePoints[{i}]"]["value"] for i in (1, 2)) == (99, 279)
+    assert fields["AttributesEx4"]["value"] & 0x04000000 == 0
+    print("Accepted Blossomback Spell.dbc SHA256 " + record["origin"]["sha256"], flush=True)
+    return (
+        "SpellInfo AcceptedBlossomback() { SpellInfo spell; spell.Id = 900125; "
+        "spell.effects = {{{78, 0}, {32, 1}, {207, 2}}}; return spell; }\n"
+    )
+
+
+def main():
+    parser = argparse.ArgumentParser(description=CLI_DESCRIPTION)
+    parser.add_argument("--dbc-dir", type=Path, required=True)
+    args = parser.parse_args()
+    source = (ROOT / "src/server/coa/AscensionMountSpeed.cpp").read_text(encoding="utf-8")
+    config = (ROOT / "src/server/coa/conf/coa.conf.dist").read_text(encoding="utf-8")
+    assert re.search(r"^CoA.AllowAzerothMountFlight\s*=\s*0\s*$", config, re.M)
+    assert re.search(r"^CoA.ProfessionCastTimeCapMs\s*=\s*0\s*$", config, re.M)
+    production = "\n".join(line for line in source.splitlines() if not line.startswith("#include"))
+    spells = (ROOT / "src/server/game/Spells/SpellMgr.h").read_text(encoding="utf-8")
+    riding = definition(spells, "enum RidingSkillValue : uint16") + ";\n"
+    riding += "constexpr int32 NOVICE_RIDING_MOUNT_SPEED = 40;\n"
+    riding += definition(spells, "inline int32 GetRidingGroundMountSpeed") + "\n"
+    riding += definition(spells, "inline int32 GetRidingFlightMountSpeed") + "\n"
+    compat = (ROOT / "src/server/coa/AscensionCompat.cpp").read_text(encoding="utf-8")
+    initializer = definition(compat, "void InitializeRiding(Player* player) const")
+    compiler = os.environ.get("CXX") or shutil.which("c++") or shutil.which("g++") or shutil.which("clang++")
+    if not compiler:
+        raise RuntimeError("A portable C++20 compiler is required")
+    with tempfile.TemporaryDirectory(prefix="coa-g1-mount-flight-") as temporary:
+        directory = Path(temporary)
+        (directory / "RidingProduction.h").write_text(riding, encoding="utf-8")
+        (directory / "MountProduction.h").write_text(production, encoding="utf-8")
+        (directory / "RidingInitialization.h").write_text(initializer, encoding="utf-8")
+        (directory / "Blossomback.h").write_text(blossomback(args.dbc_dir), encoding="utf-8")
+        executable = directory / "mount-flight"
+        subprocess.run(shlex.split(compiler) + [
+            "-std=c++20", "-Wall", "-Wextra", "-Werror", "-I", str(directory),
+            str(HERE / "cases.cpp"), "-o", str(executable),
+        ], check=True)
+        subprocess.run([str(executable)], check=True)
+
+
+if __name__ == "__main__":
+    main()
