+            WaterSentinel untagged;
+            ReadWaterSentinel(dev, untagged);
+            result.untagRestores = result.untagRestores && SameWaterSentinel(beforeTag, untagged, true);
+            ReleaseWaterSentinel(untagged);
+        }
+        ReleaseWaterSentinel(beforeTag);
+    }
