+float WeightOf(const AuthoredFog& fog, uint32_t light)
+{
+    for (int i = 0; i < fog.lightCount; ++i)
+        if (fog.lightIds[i] == light)
+            return fog.lightWeights[i];
+    return 0.0f;
+}
