+    AND (`SpellId`, `ReqSkillLine`, `ReqSkillRank`, `ReqAbility1`, `ReqLevel`) IN
+    ((54083, 356, 125, 7731, 10), (54084, 356, 275, 18248, 10), (54254, 129, 125, 3274, 0),
+     (54255, 129, 275, 10846, 0), (54256, 185, 275, 18260, 0), (54257, 185, 125, 3102, 0),
+     (61464, 202, 350, 30350, 65));
+
+INSERT INTO `trainer_spell` (`TrainerId`, `SpellId`, `MoneyCost`, `ReqSkillLine`, `ReqSkillRank`,
+    `ReqAbility1`, `ReqAbility2`, `ReqAbility3`, `ReqLevel`, `VerifiedBuild`)
+SELECT 200001, `rank`.`SpellId`, 0, `rank`.`ReqSkillLine`, `rank`.`ReqSkillRank`,
+    `rank`.`ReqAbility1`, 0, 0, `rank`.`ReqLevel`, NULL
+FROM
+(
+    SELECT 54083 AS `SpellId`, 356 AS `ReqSkillLine`, 125 AS `ReqSkillRank`, 7731 AS `ReqAbility1`, 10 AS `ReqLevel`
+    UNION ALL SELECT 54084, 356, 275, 18248, 10
+    UNION ALL SELECT 54254, 129, 125, 3274, 0
+    UNION ALL SELECT 54255, 129, 275, 10846, 0
+    UNION ALL SELECT 54256, 185, 275, 18260, 0
+    UNION ALL SELECT 54257, 185, 125, 3102, 0
+    UNION ALL SELECT 61464, 202, 350, 30350, 65
+) AS `rank`
+LEFT JOIN `trainer_spell` AS `existing`
+    ON `existing`.`TrainerId` = 200001 AND `existing`.`SpellId` = `rank`.`SpellId`
+WHERE `existing`.`SpellId` IS NULL;
diff --git a/data/sql/updates/pending_db_world/rev_20260925_00_local_optional_table_bootstrap.sql b/data/sql/updates/pending_db_world/rev_20260925_00_local_optional_table_bootstrap.sql
