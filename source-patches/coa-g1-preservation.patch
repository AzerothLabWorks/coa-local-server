+{
+  "schema": 1,
+  "name": "G1 preserves Furline ownership, ground speed and dismounting",
+  "contract": "Vanity unlock and companion learning grant Furline 91737, with 100% ground speed and safe dismounting.",
+  "timeout_ms": 60000,
+  "players": [
+    { "id": "rider", "race": 1, "class": 1, "level": 60, "bot": false }
+  ],
+  "steps": [
+    {
+      "action": "assert", "actor": "rider", "metric": "knows_spell", "spell": 9931327,
+      "equals": 1, "within_ms": 5000, "label": "the owned vanity summon is learned before testing"
+    },
+    {
+      "action": "assert", "actor": "rider", "metric": "knows_spell", "spell": 91737,
+      "equals": 1, "within_ms": 5000, "label": "Furline ownership also grants its speed-bearing mount spell"
+    },
+    {
+      "action": "set_skill", "actor": "rider", "skill": 762, "value": 300, "maximum": 300,
+      "label": "hold riding skill constant for both summon paths"
+    },
+    {
+      "action": "assert", "actor": "rider", "metric": "run_speed_rate", "equals": 1,
+      "label": "the unmounted human has ordinary ground speed"
+    },
+    {
+      "action": "snapshot", "actor": "rider", "metric": "run_speed_rate", "save_as": "initial_ground_speed",
+      "label": "initial_ground_speed"
+    },
+    {
+      "action": "cast", "actor": "rider", "spell": 9931327,
+      "label": "summon from the original Furline vanity entry"
+    },
+    {
+      "action": "assert", "actor": "rider", "metric": "aura", "spell": 91737,
+      "equals": 1, "within_ms": 3000, "label": "the legacy vanity cast reaches the speed-bearing mount aura"
+    },
+    {
+      "action": "assert", "actor": "rider", "metric": "aura", "spell": 9931327, "equals": 0,
+      "label": "the slow legacy aura is replaced, not stacked with the mount aura"
+    },
+    {
+      "action": "assert", "actor": "rider", "metric": "run_speed_rate", "equals": 2,
+      "label": "the original DBC mount-speed aura doubles ground speed"
+    },
+    {
+      "action": "snapshot", "actor": "rider", "metric": "run_speed_rate", "save_as": "vanity_mount_ground_speed",
+      "label": "vanity_mount_ground_speed"
+    },
+    { "action": "cancel_mount", "actor": "rider", "label": "dismount through the normal client handler" },
+    { "action": "wait", "ms": 1000, "label": "allow delayed utility work to run after dismounting" },
+    {
+      "action": "assert", "actor": "rider", "metric": "aura", "spell": 91737, "equals": 0,
+      "label": "delayed work does not reapply the mount aura"
+    },
+    {
+      "action": "assert", "actor": "rider", "metric": "run_speed_rate", "equals": 1,
+      "label": "dismounting restores ordinary ground speed"
+    },
+    {
+      "action": "snapshot", "actor": "rider", "metric": "run_speed_rate", "save_as": "vanity_dismount_ground_speed",
+      "label": "vanity_dismount_ground_speed"
+    },
+    { "action": "cast", "actor": "rider", "spell": 91737, "label": "summon the learned mount directly" },
+    {
+      "action": "assert", "actor": "rider", "metric": "aura", "spell": 91737,
+      "equals": 1, "within_ms": 3000, "label": "the directly learned mount also produces its aura"
+    },
+    {
+      "action": "assert", "actor": "rider", "metric": "run_speed_rate", "equals": 2,
+      "label": "the direct mount path has the same ground speed"
+    },
+    {
+      "action": "snapshot", "actor": "rider", "metric": "run_speed_rate", "save_as": "direct_mount_ground_speed",
+      "label": "direct_mount_ground_speed"
+    },
+    { "action": "cancel_mount", "actor": "rider", "label": "finish the direct mount test unmounted" },
+    { "action": "wait", "ms": 1000, "label": "settle the direct dismount before ownership recovery" },
+    {
+      "action": "snapshot", "actor": "rider", "metric": "run_speed_rate", "save_as": "direct_dismount_ground_speed",
+      "label": "direct_dismount_ground_speed"
+    },
+    {
+      "action": "unlearn", "actor": "rider", "spell": 91737, "all_specs": true,
+      "label": "remove only the supplemental mount spell from the test character"
+    },
+    {
+      "action": "assert", "actor": "rider", "metric": "knows_spell", "spell": 91737, "equals": 0,
+      "label": "the ownership recovery starts with a genuinely missing mount spell"
+    },
+    {
+      "action": "login_hooks", "actor": "rider",
+      "label": "replay login synchronization without claiming a database reload"
+    },
+    {
+      "action": "assert", "actor": "rider", "metric": "knows_spell", "spell": 91737,
+      "equals": 1, "within_ms": 8000, "label": "owned companion synchronization repairs the missing speed spell"
+    },
+    {
+      "action": "assert", "actor": "rider", "metric": "aura", "spell": 91737, "equals": 0,
+      "label": "learning an owned mount never mounts the character automatically"
+    },
+    {
+      "action": "assert", "actor": "rider", "metric": "run_speed_rate", "equals": 1,
+      "label": "ownership recovery leaves the character at ordinary unmounted speed"
+    },
+    {
+      "action": "snapshot", "actor": "rider", "metric": "run_speed_rate", "save_as": "recovered_ground_speed",
+      "label": "recovered_ground_speed"
+    }
+  ]
+}
