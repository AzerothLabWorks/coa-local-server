+bool AttackOggleflintAddAction::Execute(Event /*event*/)
+{
+    Unit* add = RagefireEscort::Nearest(botAI, bot, context, "oggleflint",
+                                        {NPC_RAGEFIRE_SHAMAN, NPC_RAGEFIRE_TROGG});
+    if (!add || AI_VALUE(Unit*, "current target") == add)
+        return false;
+
+    return Attack(add);
