+const AuthoredLayer* MidHaze(const AuthoredFog& fog)
+{
+    for (int i = 0; i < fog.layerCount; ++i)
+        if (fog.layers[i].start < 1.0f && std::fabs(fog.layers[i].g - 0.5f) < 0.01f)
+            return &fog.layers[i];
+    return nullptr;
+}
