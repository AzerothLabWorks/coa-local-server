diff --git a/data/sql/updates/pending_db_world/rev_1792365477029742178.sql b/data/sql/updates/pending_db_world/rev_1792365477029742178.sql
new file mode 100644
index 0000000000000000000000000000000000000000..420aca9bf9322b2088cab67ab7e27cde3aeaded1
--- /dev/null
+++ b/data/sql/updates/pending_db_world/rev_1792365477029742178.sql
@@ -0,0 +1,37 @@
+DELETE FROM `lfg_dungeon_rewards`
+WHERE (`dungeonId`, `maxLevel`, `firstQuestId`, `otherQuestId`) IN
+((417, 64, 24887, 24895), (417, 70, 24888, 24896), (418, 70, 24922, 24923),
+ (465, 80, 24790, 24791), (466, 80, 24788, 24789))
+AND EXISTS
+(
+    SELECT 1
+    FROM
+    (
+        SELECT `dungeonId`, `maxLevel`, `firstQuestId`, `otherQuestId`
+        FROM `lfg_dungeon_rewards`
+        GROUP BY `dungeonId`, `maxLevel`, `firstQuestId`, `otherQuestId`
+    ) AS `source`
+    WHERE `source`.`dungeonId` = CASE `lfg_dungeon_rewards`.`dungeonId`
+        WHEN 417 THEN 259 WHEN 418 THEN 260 WHEN 465 THEN 261 WHEN 466 THEN 262 END
+        AND `source`.`maxLevel` = `lfg_dungeon_rewards`.`maxLevel`
+        AND `source`.`firstQuestId` = `lfg_dungeon_rewards`.`firstQuestId`
+        AND `source`.`otherQuestId` = `lfg_dungeon_rewards`.`otherQuestId`
+);
+
+INSERT INTO `lfg_dungeon_rewards` (`dungeonId`, `maxLevel`, `firstQuestId`, `otherQuestId`)
+SELECT `mapping`.`newId`, `source`.`maxLevel`, `source`.`firstQuestId`, `source`.`otherQuestId`
+FROM `lfg_dungeon_rewards` AS `source`
+INNER JOIN
+(
+    SELECT 259 AS `oldId`, 417 AS `newId`, 64 AS `maxLevel`, 24887 AS `firstQuestId`, 24895 AS `otherQuestId`
+    UNION ALL SELECT 259, 417, 70, 24888, 24896
+    UNION ALL SELECT 260, 418, 70, 24922, 24923
+    UNION ALL SELECT 261, 465, 80, 24790, 24791
+    UNION ALL SELECT 262, 466, 80, 24788, 24789
+) AS `mapping` ON `source`.`dungeonId` = `mapping`.`oldId`
+    AND `source`.`maxLevel` = `mapping`.`maxLevel`
+    AND `source`.`firstQuestId` = `mapping`.`firstQuestId`
+    AND `source`.`otherQuestId` = `mapping`.`otherQuestId`
+LEFT JOIN `lfg_dungeon_rewards` AS `existing`
+    ON `existing`.`dungeonId` = `mapping`.`newId` AND `existing`.`maxLevel` = `mapping`.`maxLevel`
+WHERE `existing`.`dungeonId` IS NULL;
