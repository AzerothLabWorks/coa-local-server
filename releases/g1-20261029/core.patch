@@ -0,0 +1,84 @@
+CLI_DESCRIPTION = "Check incremental ledger preservation, Northshire delta parity and optional schema ordering."
+
+import hashlib
+from pathlib import Path
+import re
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parents[3]
+BASE = "0a0a21d3830e24dec61f16aeb013a16c748d5615"
+TARGET = "6dcb71b284b9e6463805e629f65195cea2c4d80f"
+PENDING = "data/sql/updates/pending_db_world/"
+NORTHSHIRE = "rev_20260930_99_ASC_northshire_revamp.sql"
+BOOTSTRAP = "rev_20261012_00_local_worldforged_upgrade_bootstrap.sql"
+CONSUMER = "rev_20261012_01_worldforged_upgrade_tiers.sql"
+ETHEREAL_BOOTSTRAP = "rev_20261012_00_local_ethereal_set_cache_bootstrap.sql"
+ETHEREAL_CONSUMER = "rev_20261012_30_thermal_anvil_fix.sql"
+DELTA = "rev_20261013_90_local_northshire_incremental_guards.sql"
+
+
+def frozen(revision, path):
+    return subprocess.run(["git", "-C", str(ROOT), "show", revision + ":" + path],
+                          check=True, capture_output=True).stdout
+
+
+def block(source, delete):
+    match = re.search(re.escape(delete) + r"\s+INSERT INTO `(?:conditions|smart_scripts)`[\s\S]*?;", source)
+    if not match:
+        raise AssertionError("Frozen upstream block missing: " + delete)
+    return match[0]
+
+
+def expected_delta(upstream):
+    pages = "(2300500, 2300503, 2300504, 2300505)"
+    conditions = "DELETE FROM `conditions` WHERE `SourceTypeOrReferenceId` = "
+    blocks = [
+        block(upstream, conditions + "4 AND `SourceGroup` IN " + pages + ";"),
+        block(upstream, "DELETE FROM `smart_scripts` WHERE `entryorguid` IN " + pages + " AND `source_type` = 1;"),
+        block(upstream, conditions + "22 AND `SourceEntry` IN " + pages + " AND `SourceId` = 1;"),
+        block(upstream, conditions
+              + "22 AND `SourceEntry` IN (2300520, 2300521, 2300522, 2300523) AND `SourceId` = 1;"),
+    ]
+    pair = block(upstream, "DELETE FROM `smart_scripts` WHERE `entryorguid` IN (2300579, 2300546)"
+                 + " AND `source_type` = 1;")
+    columns = re.search(r"INSERT INTO `smart_scripts`\n([^\n]+)\nVALUES", pair)[1]
+    rows = re.findall(r"^\(2300546, 1, [012],[^\n]+", pair, re.M)
+    if len(rows) != 3:
+        raise AssertionError("Frozen Mirror Shard full SmartAI block is incomplete")
+    blocks.append("DELETE FROM `smart_scripts` WHERE `entryorguid` = 2300546 AND `source_type` = 1;\n\n"
+                  + "INSERT INTO `smart_scripts`\n" + columns + "\nVALUES\n" + "\n".join(rows))
+    return "\n\n".join(blocks) + "\n"
+
+
+def main():
+    original = frozen(BASE, PENDING + NORTHSHIRE)
+    upstream = frozen(TARGET, PENDING + NORTHSHIRE)
+    applied = (ROOT / PENDING / NORTHSHIRE).read_bytes()
+    if original == upstream:
+        raise AssertionError("Unadapted upstream does not reproduce the applied-migration replay hazard")
+    if applied != original or hashlib.sha1(applied).hexdigest() != "574efd6e259c77da4e3d5e5dbea71a585d92e1a8":
+        raise AssertionError("Already applied Northshire migration no longer matches its accepted ledger hash")
+    delta = (ROOT / PENDING / DELTA).read_text(encoding="utf-8")
+    if delta != expected_delta(upstream.decode("utf-8")):
+        raise AssertionError("Incremental Northshire delta differs from the frozen upstream changed row blocks")
+    base_schema = frozen(TARGET, "modules/mod-worldforged-upgrades/data/sql/db-world/base/01_worldforged_structure.sql")
+    expected = base_schema.decode("utf-8").split("CREATE TABLE `worldforged_upgrade`", 1)[1]
+    expected = "CREATE TABLE IF NOT EXISTS `worldforged_upgrade`" + expected
+    actual = (ROOT / PENDING / BOOTSTRAP).read_text(encoding="utf-8")
+    if actual != expected or BOOTSTRAP >= CONSUMER:
+        raise AssertionError("Optional Worldforged schema is not exact, non-destructive or before its consumer")
+    ethereal_base = frozen(TARGET, "modules/mod-ethereal-bazaar/data/sql/db-world/base/06_ethereal_bazaar_set_caches.sql")
+    schema = re.search(r"CREATE TABLE `ethereal_bazaar_set_cache`[\s\S]*?;", ethereal_base.decode("utf-8"))[0]
+    expected_ethereal = schema.replace("CREATE TABLE `", "CREATE TABLE IF NOT EXISTS `", 1) + "\n"
+    if ((ROOT / PENDING / ETHEREAL_BOOTSTRAP).read_text(encoding="utf-8") != expected_ethereal
+            or ETHEREAL_BOOTSTRAP >= ETHEREAL_CONSUMER):
+        raise AssertionError("Optional Ethereal set cache schema differs or runs after its DELETE consumer")
+    print("PASS: unadapted upstream replay hazard reproduced; accepted Northshire ledger bytes preserved")
+    print("PASS: incremental guards match all changed frozen upstream row blocks, including full SmartAI pairs")
+    print("PASS: exact optional Worldforged base schema is bootstrapped without seeds before its ALTER consumer")
+    print("PASS: exact optional Ethereal set cache schema is bootstrapped without seeds before its DELETE consumer")
+
+
+if __name__ == "__main__":
+    main()
