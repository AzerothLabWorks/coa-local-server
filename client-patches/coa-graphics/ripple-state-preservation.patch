+template <typename IncludePixel>
+PathComparison CompareAroundPath(const WaterView& v, const Image& a, const Image& b, IncludePixel includePixel)
+{
+    PathComparison c;
+    for (UINT y = 0; y < a.h; ++y)
+        for (UINT x = 0; x < a.w; ++x)
+        {
+            if (!includePixel(x, y))
+                continue;
+            const bool changed = std::memcmp(a.At(x, y), b.At(x, y), 3) != 0;
+            if (NearRipplePath(v, x, y))
+            {
+                ++c.nearPath;
+                c.changedNearPath += changed ? 1 : 0;
