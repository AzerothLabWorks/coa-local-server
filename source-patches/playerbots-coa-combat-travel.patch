-    // Not useful when level lower than minimum required
-    if (bot->GetLevel() < sPlayerbotAIConfig.useGroundMountAtMinLevel)
+    // COA companions can have trained riding before the stock AI minimum.
+    // Keep native spell checks and the roaming/BG policy; allow this while the
+    // leader is unmounted too, so the same action can synchronize dismounts.
+    bool const trainedCoaCompanion = bot->getClass() >= 12 && bot->getClass() <= 32 &&
+        master && master != bot && botAI->HasGameClientMaster() && bot->GetGroup() &&
+        bot->GetGroup() == master->GetGroup() && !bot->InBattleground() &&
+        bot->GetPureSkillValue(SKILL_RIDING) >= 75;
+    if (bot->GetLevel() < sPlayerbotAIConfig.useGroundMountAtMinLevel && !trainedCoaCompanion)
         return false;
 
     // Allow mounting while transformed only if the form allows it
