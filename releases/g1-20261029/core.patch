+def method(source, signature):
+    position = source.find(signature)
+    if position < 0:
+        raise ValueError(f"Missing production function: {signature}")
+    start = source.index("{", position)
+    depth = 1
+    end = start + 1
+    while depth and end < len(source):
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    if depth:
+        raise ValueError(f"Unterminated production function: {signature}")
+    return source[position:end]
+
+
+def canonical_hash(value):
+    body = json.dumps(value, separators=(",", ":"), ensure_ascii=True).encode()
+    return hashlib.sha256(body).hexdigest()
+
+
+def registry_rows(source):
+    pattern = (r'\{\s*(\d+),\s*(\d+),\s*"([^"]+)",\s*CoaSpecRole::(\w+),'
+               r'\s*"([^"]+)",\s*"([^"]+)",\s*(nullptr|"[^"]+"),\s*(true|false)\s*\}')
+    rows = []
+    for match in re.finditer(pattern, source):
+        fields = match.groups()
+        rows.append([int(fields[0]), int(fields[1]), *fields[2:6],
+                     None if fields[6] == "nullptr" else fields[6][1:-1], fields[7] == "true"])
+    return rows
+
+
+def pick_rows(source):
+    pattern = r"\{\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+),\s*(\d+)\s*\}"
+    return [list(map(int, match.groups())) for match in re.finditer(pattern, source)]
+
+
+def check_pinned_data(oracle):
+    profiles = registry_rows(REGISTRY.read_text(encoding="utf-8"))
+    picks = pick_rows(PICKS.read_text(encoding="utf-8"))
+    assert len(profiles) == oracle["profiles_count"], "Pinned 70-profile registry changed"
+    assert len(picks) == oracle["picks_count"], "Pinned 3564-pick source changed"
+    assert canonical_hash(profiles) == oracle["canonical_profiles_sha256"], "Profile metadata differs from upstream"
+    assert canonical_hash(picks) == oracle["canonical_picks_sha256"], "Level builds differ from pinned upstream"
+    assert len({row[1] for row in profiles}) == 70, "Specialization IDs must be unique"
+    for class_id, *expected in oracle["class_specs"]:
+        assert sorted(row[1] for row in profiles if row[0] == class_id) == expected, "Class ownership changed"
+    assert {row[1] for row in profiles if row[3] == "Heal"} == set(oracle["healers"]), "Healer map changed"
+    assert {row[1] for row in profiles if row[3] == "Tank"} == set(oracle["tanks"]), "Tank map changed"
+    rejected = [entry["pick"] for entry in oracle["rejected_picks"]]
+    assert len(rejected) == 4 and len({tuple(pick) for pick in rejected}) == 4, "Exactly four reviewed rejections"
+    assert all(pick in picks for pick in rejected), "Rejected tuple must exist in the pinned raw source"
