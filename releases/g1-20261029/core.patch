+    auto const recordedSpent = AscensionCoATalentState::Spent(recorded);
+    Check(HoldsEntry(recorded, 12264) && !HoldsEntry(recorded, 7131) &&
+        recordedSpent.AE == 1 && recordedSpent.TE == 0 && human.spells == humanBefore.spells &&
+        Preserved(humanBefore, human),
+        "human recorded choices and AE/TE accounting remain authoritative and unchanged");
+    human.settings["core.coa_talent.7131"] = {{1}};
+    auto const recordedForeign = KnownTalentEntries(&human);
+    Check(HoldsEntry(recordedForeign, 7131), "bot-only filtering never rewrites the existing human recorded branch");
+}
+int main(int, char** argv)
+{
+    DbcDirectory = std::string(argv[1]) + "/";
