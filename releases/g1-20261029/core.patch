+bool PrepareAscensionBotSpecialization(Player* player, uint32 specializationId, std::string& refusal)
+{
+    refusal.clear();
+    if (!ascensionCompatConfig.GetConfigValue<bool>(AscensionCompatConfig::ENABLED))
+        refusal = "CoA compatibility is disabled.";
+    else if (!player || !player->GetSession() || !player->GetSession()->IsBot())
+        refusal = "Only bot characters can be prepared.";
+    else if (!player->IsInWorld() || !player->IsAlive() || player->IsInCombat() ||
+        player->IsBeingTeleported() || player->IsInFlight())
+        refusal = "The bot must be alive, in the world, out of combat and not transferring or on a taxi.";
+    else if (!IsAscensionCustomClassId(player->getClass()) || !specializationId)
+        refusal = "A valid CoA class specialization is required.";
+    else if (player->GetLevel() < 10 || player->GetLevel() > 80)
+        refusal = "The bot must already be level 10-80; preparation never changes its level.";
+    else if (uint32 const active = GetAscensionActiveSpecialization(player); active && active != specializationId)
+        refusal = "The bot already has another specialization; preparation will not replace its build.";
+    else if (!std::any_of(AscensionCompatData::CoATalentEntries.begin(),
+        AscensionCompatData::CoATalentEntries.end(), [player, specializationId](auto const& entry)
+        {
+            return entry.ClassId == player->getClass() && entry.SpecId == specializationId;
+        }))
+        refusal = "The requested profile is missing from the native talent catalog.";
+
+    if (!refusal.empty())
+        return false;
+    if (GetAscensionActiveSpecialization(player) == specializationId)
+        return true;
+    struct SavedSkill
+    {
+        uint16 Id;
+        uint16 Step;
+        uint16 Value;
+        uint16 Maximum;
+    };
+    std::vector<SavedSkill> skills;
+    for (uint32 id = 1; id < sSkillLineStore.GetNumRows(); ++id)
+        if (player->HasSkill(id))
+            skills.push_back({uint16(id), player->GetSkillStep(id), player->GetPureSkillValue(id),
+                player->GetPureMaxSkillValue(id)});
+    bool const selected = SwitchAscensionSpecialization(player, specializationId);
+    for (auto const& skill : skills)
+        player->SetSkill(skill.Id, skill.Step, skill.Value, skill.Maximum);
+    player->UpdateDefenseBonusesMod();
+    if (!selected)
+    {
+        refusal = "Native specialization selection failed.";
+        return false;
+    }
+    return true;
+}
