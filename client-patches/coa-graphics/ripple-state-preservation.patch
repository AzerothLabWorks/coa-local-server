+double MaskedCoverage(const Image& mask, const Image& coverage)
+{
+    double sum = 0.0;
+    for (UINT y = 0; y < mask.h; ++y)
+        for (UINT x = 0; x < mask.w; ++x)
+            if (IsMaskPixel(mask, x, y))
+                sum += coverage.At(x, y)[1];
+    return sum;
+}
