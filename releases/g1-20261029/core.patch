+import argparse
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--dbc-dir", type=Path, required=True)
+    arguments = parser.parse_args()
+    package = Path(os.environ.get("COA_LOCAL_SERVER_DIR", "/opt/coa-local-server"))
+    lua = os.environ.get("LUA51", "/opt/lua51/lua")
+    test = package / "tests/test-coa-lfg-tracker.py"
+    if not test.is_file():
+        raise RuntimeError("The CoA local-server tracker test package is required: " + str(test))
+    subprocess.run([sys.executable, "-B", str(test), "--lua51", lua,
+                    "--dbc-dir", str(arguments.dbc_dir)], check=True)
+    print("LUA-DOUBLES SCOPE: packaged objective callback, protocol validation and accepted DBC mappings; "
+          "not native client packet delivery or UI rendering.")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/apps/coa-tests/g1_mount_flight/cases.cpp b/apps/coa-tests/g1_mount_flight/cases.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4e87c4ec96ca5dec217450fafe914406b4a98451
--- /dev/null
+++ b/apps/coa-tests/g1_mount_flight/cases.cpp
@@ -0,0 +1,163 @@
+#include "fixture.h"
+#include "MountProduction.h"
+#include "Blossomback.h"
+
+int failures = 0;
+void Check(bool condition, char const* name)
+{
+    std::printf("%s %s\n", condition ? "PASS" : "FAIL", name);
+    failures += !condition;
+}
+
+void Configure(bool azeroth, bool legacy = false)
+{
+    config.values["CoA.AllowAzerothMountFlight"] = azeroth;
+    config.values["CoA.LegacyMountFlight"] = legacy;
+    FlightConfiguration{}.OnAfterConfigLoad(true);
+}
+
+int main()
+{
+    SpellInfo blossom = AcceptedBlossomback();
+    Player player;
+    Spell spell{&player, &blossom};
+    MountFlight cast;
+    FlightConfiguration{}.OnStartup();
+    Check(!AscensionMountSpeed::CanFly(&player, &blossom), "absent option preserves upstream Azeroth grounding");
+    TargetInfo grounded;
+    cast.OnSpellCalculatedTarget(&spell, &player, grounded);
+    Check(grounded.effectMask == 3, "default removes only Blossomback flight and retains mounted ground effects");
+
+    Configure(true);
+    for (uint32 map : {MAP_EASTERN_KINGDOMS, MAP_KALIMDOR})
+    {
+        player.map = map;
+        TargetInfo flying;
+        cast.OnSpellCalculatedTarget(&spell, &player, flying);
+        Check(AscensionMountSpeed::CanFly(&player, &blossom) && flying.effectMask == 7,
+            "opt-in preserves learned Blossomback flight in each accepted Azeroth continent");
+    }
+    uint32 const cachedReads = config.reads;
+    AscensionMountSpeed::CanFly(&player, &blossom);
+    Check(config.reads == cachedReads, "flight checks do not read configuration in the hot path");
+
+    for (uint32 gate = 0; gate < 7; ++gate)
+    {
+        Player denied;
+        SpellInfo mount = blossom;
+        switch (gate)
+        {
+            case 0: denied.riding = RIDING_SKILL_EXPERT - 1; break;
+            case 1: denied.battleground = true; break;
+            case 2: area.flags = AREA_FLAG_NO_FLY_ZONE; break;
+            case 3: battlefieldManager.present = true; battlefield.allowed = false; break;
+            case 4: mount.locationAllowed = false; break;
+            case 5: denied.zoneAllowed = false; break;
+            case 6: mount.flyingAreasOnly = true; break;
+        }
+        Check(!AscensionMountSpeed::CanFly(&denied, &mount),
+            "Azeroth opt-in retains riding, battleground, area, battlefield and native spell restrictions");
+        area.flags = 0;
+        battlefieldManager.present = false;
+        battlefield.allowed = true;
+    }
+    player.riding = RIDING_SKILL_EXPERT;
+    Check(AscensionMountSpeed::CanFly(&player, &blossom), "Expert riding is the first permitted flight tier");
+    Check(!AscensionMountSpeed::CanFly(&player, nullptr), "absent spell cannot enable mount flight");
+    for (uint32 map : {558u, 937u, 489u, 169u})
+    {
+        player.map = map;
+        Check(!AscensionMountSpeed::CanFly(&player, &blossom), "opt-in does not unlock other maps or dungeons");
+    }
+    for (bool option : {false, true})
+    {
+        Configure(option);
+        player.map = MAP_OUTLAND;
+        Check(AscensionMountSpeed::CanFly(&player, &blossom), "Outland flight remains available with either setting");
+        player.map = MAP_NORTHREND;
+        player.spells.erase(SPELL_COLD_WEATHER_FLYING);
+        Check(!AscensionMountSpeed::CanFly(&player, &blossom), "Northrend still requires Cold Weather Flying");
+        player.spells.insert(SPELL_COLD_WEATHER_FLYING);
+        Check(AscensionMountSpeed::CanFly(&player, &blossom), "trained Northrend flight remains available");
+    }
+
+    Configure(true);
+    player.map = MAP_EASTERN_KINGDOMS;
+    Aura mounted{&blossom, &player};
+    AuraEffect mountEffect{&mounted};
+    player.mounts = {&mountEffect};
+    MountFlightArea{}.OnPlayerUpdateArea(&player, 1, 2);
+    Check(!mounted.removed, "allowed Azeroth area transition preserves the accepted flying mount");
+    area.flags = AREA_FLAG_NO_FLY_ZONE;
+    MountFlightArea{}.OnPlayerUpdateArea(&player, 2, 3);
+    Check(mounted.removed, "entering a no-fly area still removes the flying mount");
+    area.flags = 0;
+    mounted.removed = false;
+    Configure(false);
+    MountFlightArea{}.OnPlayerUpdateArea(&player, 3, 4);
+    Check(mounted.removed, "disabling the option restores upstream grounding on area update");
+    mounted.removed = false;
+    mounted.mask = 3;
+    MountFlightArea{}.OnPlayerUpdateArea(&player, 4, 5);
+    Check(!mounted.removed, "ordinary ground-only mount effects are not dismounted");
+
+    Configure(true);
+    SpellInfo ground = blossom;
+    ground.effects[2].ApplyAuraName = 0;
+    Spell groundSpell{&player, &ground};
+    TargetInfo groundHit;
+    cast.OnSpellCalculatedTarget(&groundSpell, &player, groundHit);
+    Check(groundHit.effectMask == 7 && FlightEffectMask(&ground) == 0, "ground mounts gain no flight effect");
+    Unit creature;
+    Spell creatureSpell{&creature, &blossom};
+    TargetInfo creatureHit;
+    cast.OnSpellCalculatedTarget(&creatureSpell, &creature, creatureHit);
+    Check(creatureHit.effectMask == 7, "non-player spells retain the native path");
+    Configure(false, true);
+    player.spells.erase(blossom.Id);
+    TargetInfo legacyUnknown;
+    cast.OnSpellCalculatedTarget(&spell, &player, legacyUnknown);
+    Check(legacyUnknown.effectMask == 7, "explicit upstream legacy mode still skips unlearned mounts");
+    player.spells.insert(blossom.Id);
+    TargetInfo legacyKnown;
+    cast.OnSpellCalculatedTarget(&spell, &player, legacyKnown);
+    Check(legacyKnown.effectMask == 3, "legacy mode alone does not accidentally unlock learned Azeroth mounts");
+
+    Configure(true);
+    LearnedMountSpeed speed;
+    AuraEffect groundSpeed{&mounted, SPELL_AURA_MOD_INCREASE_MOUNTED_SPEED};
+    AuraEffect flightSpeed{&mounted, SPELL_AURA_MOD_INCREASE_MOUNTED_FLIGHT_SPEED};
+    struct Tier { uint16 riding; int32 ground; int32 flight; };
+    for (Tier tier : {Tier{50, 40, 0}, Tier{75, 60, 0}, Tier{150, 100, 0},
+        Tier{225, 100, 150}, Tier{300, 100, 280}, Tier{375, 100, 310}})
+    {
+        player.riding = tier.riding;
+        int32 groundAmount = 100;
+        int32 flightAmount = 280;
+        speed.OnAfterAuraEffectCalculateAmount(&groundSpeed, &player, groundAmount);
+        speed.OnAfterAuraEffectCalculateAmount(&flightSpeed, &player, flightAmount);
+        Check(groundAmount == tier.ground && flightAmount == tier.flight,
+            "upstream riding-based speed tiers remain intact");
+    }
+    player.spells.erase(blossom.Id);
+    int32 unchanged = 280;
+    speed.OnAfterAuraEffectCalculateAmount(&flightSpeed, &player, unchanged);
+    Check(unchanged == 280, "unlearned mounts retain their own speed amount");
+
+    Player trainee;
+    trainee.spells.clear();
+    trainee.riding = trainee.ridingStep = trainee.ridingMaximum = 0;
+    ascensionCompatConfig.enabled = false;
+    CollectionService{}.InitializeRiding(&trainee);
+    Check(trainee.spells.empty() && trainee.riding == 0, "disabled convenience grants no riding");
+    ascensionCompatConfig.enabled = true;
+    CollectionService{}.InitializeRiding(&trainee);
+    Check(trainee.riding == 300 && trainee.ridingStep == 5 && trainee.ridingMaximum == 300,
+        "CoA login uses Artisan step five after Novice rank insertion");
+    Check(trainee.spells == std::unordered_set<uint32>{33388, 33391, 34090, 34091, 54197},
+        "CoA login keeps all existing riding grants and Cold Weather Flying");
+    CollectionService{}.InitializeRiding(&trainee);
+    Check(trainee.learningCalls == 5 && trainee.ridingStep == 5,
+        "repeated login initialization neither duplicates grants nor downgrades the new riding step");
+    return failures ? 1 : 0;
+}
