@@ -0,0 +1,40 @@
+#include "BotChatPacing.h"
+#include "BotChatPacingPolicy.h"
+#include "PlayerbotAIConfig.h"
+#include "Random.h"
+
+#include <chrono>
+#include <mutex>
+
+namespace BotChatPacing
+{
+bool AllowAmbient(std::uint64_t botId, std::uint32_t team, std::string const& channel,
+                  std::string const& message)
+{
+    if (!sPlayerbotAIConfig.socialPacingEnabled)
+        return true;
+
+    static std::mutex mutex;
+    static AmbientPolicy policy;
+    auto const now = std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+    Limits const limits{1000ULL * sPlayerbotAIConfig.socialAmbientChannelIntervalSeconds,
+                        1000ULL * sPlayerbotAIConfig.socialAmbientBotIntervalSeconds,
+                        1000ULL * sPlayerbotAIConfig.socialAmbientRepeatSeconds};
+    std::lock_guard<std::mutex> lock(mutex);
+    return policy.Accept(now, botId, std::to_string(team) + ":" + channel, message, limits);
+}
+
+std::size_t SelectTemplate(std::string const& key, std::size_t count)
+{
+    if (count < 2)
+        return 0;
+    if (!sPlayerbotAIConfig.socialPacingEnabled)
+        return urand(0, count - 1);
+
+    static std::mutex mutex;
+    static RecentChoices choices;
+    std::lock_guard<std::mutex> lock(mutex);
+    return choices.Pick(key, count, rand32());
+}
+}
