+++ b/src/Ai/Class/Coa/CoaRoleProfile.h
@@ -0,0 +1,33 @@
+#ifndef PLAYERBOTS_COAROLEPROFILE_H
+#define PLAYERBOTS_COAROLEPROFILE_H
+
+#include <cstdint>
+#include <string_view>
+#include "CoaSpecStrategies.h"
+
+enum class CoaCombatRole : std::uint8_t
+{
+    Damage,
+    Healer,
+    Tank
+};
+
+struct CoaRoleProfile
+{
+    CoaCombatRole Role;
+    bool Ranged;
+};
+
+constexpr CoaRoleProfile GetCoaRoleProfile(std::uint8_t classId, std::uint32_t specializationId)
+{
+    for (auto const& profile : CoaSpecStrategies)
+        if (profile.classId == classId && profile.specId == specializationId)
+        {
+            CoaCombatRole const role = profile.role == CoaSpecRole::Heal ? CoaCombatRole::Healer :
+                profile.role == CoaSpecRole::Tank ? CoaCombatRole::Tank : CoaCombatRole::Damage;
+            return {role, std::string_view(profile.position) != "close"};
+        }
+    return {CoaCombatRole::Damage, true};
+}
+
+#endif
