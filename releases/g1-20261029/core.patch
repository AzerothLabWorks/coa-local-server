+struct Spell
+{
+    Player* bot;
+    uint32 flags;
+    SpellTargets m_targets;
+    Spell(Player* player, SpellInfo const*, uint32 triggerFlags) : bot(player), flags(triggerFlags) {}
+    SpellCastResult CheckCast(bool) const
+    {
+        if (flags != TRIGGERED_IGNORE_CASTER_MOUNTED_OR_ON_VEHICLE || m_targets.target != bot)
+            return SPELL_FAILED_NOT_HERE;
+        if (bot->cooldown || bot->casting)
+            return SPELL_FAILED_NOT_READY;
+        return bot->denied || bot->combat || bot->moving ? SPELL_FAILED_NOT_HERE : SPELL_CAST_OK;
+    }
+};
