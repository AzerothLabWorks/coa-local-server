-std::string ReadText(const std::wstring& path)
-{
-    std::string text;
-    FILE* f = _wfopen(path.c_str(), L"rb");
-    if (!f)
-        return text;
-    char chunk[4096];
-    for (size_t n; (n = std::fread(chunk, 1, sizeof(chunk), f)) > 0;)
-        text.append(chunk, n);
-    std::fclose(f);
-    return text;
-}
