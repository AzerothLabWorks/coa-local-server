-void ReleaseWaterSentinel(WaterSentinel& s)
-{
-    for (IDirect3DBaseTexture9* texture : s.textures)
-        if (texture)
-            texture->Release();
-    for (IDirect3DSurface9* target : s.targets)
-        if (target)
-            target->Release();
-    IUnknown* refs[] = {s.vs, s.ps, s.decl, s.stream, s.depth};
-    for (IUnknown* ref : refs)
-        if (ref)
-            ref->Release();
-}
