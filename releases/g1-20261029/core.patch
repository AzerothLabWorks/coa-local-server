@@ -0,0 +1,166 @@
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shlex
+import shutil
+import subprocess
+import tempfile
+
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+CLI_DESCRIPTION = "Qualify staged terrain with native grid-height, collision and Detour readers; no server or database."
+SQL_EXPECTATIONS = {
+    "rev_20260924_11_coa_teldrassil_dolanaar.sql": {
+        46343: (9794.05, 897.77, 1311.554),
+        46478: (9799.12, 903.11, 1311.646),
+        46207: (9815.81, 901.18, 1306.536),
+        49559: (9949.98, 893.79, 1357.588),
+        46204: (9927.83, 892.37, 1316.605),
+    },
+    "rev_20260923_02_coa_elwynn_stock_relocations.sql": {
+        80346: (-9480.69, -18.104, 56.963),
+        80350: (-9479.89, -1.924, 56.966),
+        80347: (-9480.76, -1.24, 63.82),
+        241343: (-9488.5, -44.27, 49.794),
+    },
+    "rev_20261001_29_coa_cain_entry_room_kobolds.sql": {
+        9010130: (1799.7672, 1967.7028, 141.4438),
+        9010131: (1782.4592, 1972.5784, 141.4452),
+    },
+}
+
+
+def check_expectations():
+    native = (HERE / "harness.cpp").read_text(encoding="utf-8")
+    pattern = r'\{"[^"\n]+", [01], ([-\d.]+)f, ([-\d.]+)f, ([-\d.]+)f, (?:true|false)\}'
+    native_points = {tuple(map(float, match)) for match in re.findall(pattern, native)}
+    for name, rows in SQL_EXPECTATIONS.items():
+        sql = (ROOT / "data/sql/updates/pending_db_world" / name).read_text(encoding="utf-8")
+        for guid, expected in rows.items():
+            update = re.search(r"UPDATE `creature` SET ([^;]+?) WHERE `guid` = " + str(guid) + r"\b", sql, re.S)
+            if not update:
+                raise SystemExit(f"FAIL: source SQL expectation missing for {name} GUID {guid}")
+            actual = tuple(float(re.search(r"`position_" + axis + r"` = ([-\d.]+)", update[1])[1])
+                           for axis in "xyz")
+            if actual != expected or expected not in native_points:
+                raise SystemExit(f"FAIL: native floor expectation disagrees with {name} GUID {guid}")
+        print(f"PASS: native expectations match independent frozen SQL {name}", flush=True)
+    dolanaar = (ROOT / "data/sql/updates/pending_db_world/rev_20260924_11_coa_teldrassil_dolanaar.sql")
+    sql = dolanaar.read_text(encoding="utf-8")
+    for guid, expected in ((9007418, (9810.0, 1008.0, 1239.067)),
+                           (9007444, (9804.0, 974.0, 1232.246)),
+                           (9007427, (9800.0, 970.0, 1231.645))):
+        row = re.search(r"^\(" + str(guid) + r", ([^\n]+)$", sql, re.M)
+        if not row:
+            raise SystemExit(f"FAIL: source termite spawn missing for GUID {guid}")
+        actual = tuple(map(float, row[1].split(", ")[7:10]))
+        if actual != expected or expected not in native_points:
+            raise SystemExit(f"FAIL: native floor expectation disagrees with termite spawn GUID {guid}")
+    patrol = re.search(r"const Ironhorn =\s*\{\{(.*?)\}\};", native, re.S)
+    native_patrol = [tuple(map(float, match)) for match in
+                     re.findall(r"\{([-.\d]+)f, ([-.\d]+)f, ([-.\d]+)f\}", patrol[1])]
+    bloodhoof = (ROOT / "data/sql/updates/pending_db_world/rev_20260926_22_coa_mulgore_bloodhoof.sql")
+    sql = bloodhoof.read_text(encoding="utf-8")
+    updates = re.findall(r"UPDATE `waypoint_data` SET ([^;]+?) WHERE `id` = 252220 AND `point` = (\d+);", sql)
+    sql_patrol = [tuple(float(re.search(r"`position_" + axis + r"` = ([-\d.]+)", update)[1])
+                        for axis in "xyz") for update, _ in sorted(updates, key=lambda row: int(row[1]))]
+    if len(sql_patrol) != 15 or native_patrol != sql_patrol:
+        raise SystemExit("FAIL: native Bloodhoof route expectations disagree with frozen SQL patrol 252220")
+    print("PASS: native termite cave floors and all 15 Ironhorn patrol nodes match frozen SQL", flush=True)
+
+
+def directory(variable, default=None):
+    value = os.environ.get(variable, default)
+    if not value:
+        raise SystemExit(f"Missing prerequisite: {variable}")
+    path = Path(value).resolve()
+    if not path.is_dir():
+        raise SystemExit(f"Missing prerequisite: {variable} directory {path}")
+    return path
+
+
+def compile_harness(build, output):
+    commands = json.loads((build / "compile_commands.json").read_text(encoding="utf-8"))
+    entry = next(item for item in commands if item["file"].endswith("/Collision/Maps/MapTree.cpp"))
+    command = shlex.split(entry["command"])
+    compiler = shutil.which(os.environ.get("CXX", command[0]))
+    if not compiler:
+        raise SystemExit("Missing prerequisite: the build's C++ compiler")
+    options = [item for item in command[1:] if item.startswith(("-I", "-D"))]
+    includes = {ROOT / "src/server/game", ROOT / "src/server/shared"}
+    includes.update(path.parent for path in (ROOT / "src/server/game").rglob("*.h"))
+    includes.update(path.parent for path in (ROOT / "src/server/shared").rglob("*.h"))
+    options.extend("-I" + str(path) for path in sorted(includes))
+    ninja = (build / "build.ninja").read_text(encoding="utf-8")
+    target = re.search(r"^build src/tools/mmaps_generator:.*?^  LINK_LIBRARIES = ([^\n]+)$", ninja, re.M | re.S)
+    if not target:
+        raise SystemExit("Missing prerequisite: Ninja mmaps_generator link configuration")
+    libraries = [item for item in shlex.split(target[1]) if not item.startswith("-Wl,-rpath,")]
+    flags = ["-std=c++20", "-O2", "-Wall", "-Wextra", "-Wno-deprecated-declarations",
+             "-include", "array", "-include", "Optional.h",
+             "-ffunction-sections", "-fdata-sections", "-Wl,--gc-sections"]
+    result = subprocess.run([compiler, *flags, *options, str(HERE / "harness.cpp"),
+                             str(ROOT / "src/server/game/Grids/GridTerrainData.cpp"),
+                             *libraries, "-pthread", "-o", str(output)], cwd=build,
+                            capture_output=True, text=True, errors="replace", timeout=600)
+    if result.returncode:
+        raise SystemExit("Terrain harness did not compile:\n" + result.stdout + result.stderr)
+    print("PASS: native terrain harness compiled against the frozen build", flush=True)
+
+
+def dbc_manifest(path):
+    files = sorted(item for item in path.rglob("*") if item.is_file())
+    if not files or not (path / "CharBaseInfo.dbc").is_file() or not (path / "Spell.dbc").is_file():
+        raise SystemExit(f"Missing prerequisite: complete effective DBC directory {path}")
+    result = {}
+    for item in files:
+        with item.open("rb") as stream:
+            result[str(item.relative_to(path))] = hashlib.file_digest(stream, "sha256").hexdigest()
+    return result
+
+
+def check_dbcs(terrain):
+    before = directory("COA_TERRAIN_DBC_BASELINE_DIR")
+    after = directory("COA_TERRAIN_DBC_DIR", os.environ.get("COA_DBC_DIR", str(terrain / "dbc")))
+    expected = dbc_manifest(before)
+    actual = dbc_manifest(after)
+    changed = sorted(name for name in expected.keys() | actual.keys() if expected.get(name) != actual.get(name))
+    if changed:
+        raise SystemExit("FAIL: effective DBC files changed: " + ", ".join(changed))
+    print(f"PASS: all {len(actual)} effective DBC files are byte-identical to the preserved baseline", flush=True)
+
+
+def main():
+    argparse.ArgumentParser(description=CLI_DESCRIPTION).parse_args()
+    check_expectations()
+    build = directory("COA_TERRAIN_BUILD_DIR")
+    with tempfile.TemporaryDirectory(prefix="coa-g1-terrain-") as temporary:
+        executable = Path(temporary) / "terrain"
+        compile_harness(build, executable)
+        if os.environ.get("COA_TERRAIN_COMPILE_ONLY") == "1":
+            print("COMPILE ONLY: no terrain, navigation, DBC or gameplay qualification ran", flush=True)
+            return
+        terrain = directory("COA_TERRAIN_DIR")
+        check_dbcs(terrain)
+        if os.environ.get("COA_TERRAIN_BASELINE_DIR"):
+            baseline = directory("COA_TERRAIN_BASELINE_DIR")
+            result = subprocess.run([str(executable), str(baseline)], capture_output=True,
+                                    text=True, errors="replace", timeout=300)
+            print("BASELINE EXPECTED-FAILURE EVIDENCE:\n" + result.stdout, flush=True)
+            if result.stderr:
+                print(result.stderr, flush=True)
+            regression = re.search(r"FAIL: (origin: Dolanaar inn|floor: Dolanaar Keldamyr)", result.stdout)
+            if result.returncode != 1 or not regression:
+                raise SystemExit("FAIL: baseline did not reproduce the required Dolanaar geometry mismatch")
+            print("PASS: old data fails the independent Dolanaar geometry expectations", flush=True)
+        print("CANDIDATE TERRAIN EVIDENCE:", flush=True)
+        result = subprocess.run([str(executable), str(terrain)], timeout=300)
+        raise SystemExit(result.returncode)
+
+
+if __name__ == "__main__":
+    main()
