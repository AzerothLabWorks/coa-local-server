+bool CheckMountStateAction::TryMasterMount(Player* master) const
+{
+    if (!master || master == bot)
+        return false;
+
+    for (AuraEffect const* aura : master->GetAuraEffectsByType(SPELL_AURA_MOUNTED))
+    {
+        uint32 spellId = aura->GetSpellInfo()->Id;
+        if (bot->HasSpell(spellId) && botAI->CanCastSpell(spellId, bot) &&
+            botAI->CastSpell(spellId, bot))
+            return true;
+    }
+
+    return false;
+}
