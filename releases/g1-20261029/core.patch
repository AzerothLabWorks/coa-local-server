+{
+  "schema": 1,
+  "name": "Quest log: saved quest levels and XP are replayed after client world entry",
+  "contract": [
+    "Requires DestinyWeaver.Enable=1, CoA.QuestLevelScaling=1 and CoA.QuestLevelScaling.ClientFlag=0.",
+    "Extensions.dll reads a held quest's level and reward XP from SMSG_UPDATE_OBJECT_ADDON (0x0578)",
+    "fields 61+slot and 36+slot. Sending the slot only at server login cannot repair a client whose",
+    "world-entry initialization happens afterwards. Every CMSG_EXTENSION_INITIALIZED (0x0561) notice",
+    "must replay the held quest slots, including after relog and with open-world scaling disabled.",
+    "Quest 7 is authored at level 2 and its curve plays at level 16 for a level-20 character with",
+    "scaling enabled. This scenario saves that unfinished quest, relogs, settles all login traffic,",
+    "then snapshots per-slot packet counts before the world-entry notice. Old packets cannot pass",
+    "the required positive count deltas. Scaling off must replay the authored level 2, not 16.",
+    "This verifies native server replay and packet values, not client rendering or the cause of",
+    "the Southshore crash. Counts inspect the retained per-opcode history; this short scenario",
+    "stays below its 256-payload limit."
+  ],
+  "timeout_ms": 120000,
+  "players": [
+    {
+      "id": "hero",
+      "race": 1,
+      "class": 1,
+      "level": 20,
+      "ascension_client": true
+    }
+  ],
+  "steps": [
+    {
+      "action": "wait",
+      "label": "Let the fixture login settle",
+      "ms": 7000
+    },
+    {
+      "action": "level_scaling_packet",
+      "actor": "hero",
+      "value": 1
+    },
+    {
+      "action": "wait",
+      "ms": 1000
+    },
+    {
+      "action": "prepare_quest",
+      "actor": "hero",
+      "quest": 7,
+      "complete": false
+    },
+    {
+      "action": "assert",
+      "label": "Accept sends the scaled slot level",
+      "actor": "hero",
+      "metric": "quest_log_sent_level",
+      "quest": 7,
+      "equals": 16,
+      "within_ms": 1000
+    },
+    {
+      "action": "assert",
+      "label": "Accept sends positive slot reward XP",
+      "actor": "hero",
+      "metric": "quest_log_sent_xp",
+      "quest": 7,
+      "min": 1,
+      "within_ms": 1000
+    },
+    {
+      "action": "relog",
+      "actor": "hero"
+    },
+    {
+      "action": "wait",
+      "label": "Settle server login traffic before client initialization",
+      "ms": 7000
+    },
+    {
+      "action": "assert",
+      "label": "Relog preserves the unfinished scaled quest",
+      "actor": "hero",
+      "metric": "quest_level",
+      "quest": 7,
+      "equals": 16
+    },
+    {
+      "action": "snapshot",
+      "actor": "hero",
+      "metric": "quest_log_sent_level_count",
+      "quest": 7,
+      "save_as": "scaled_levels_before_notice"
+    },
+    {
+      "action": "snapshot",
+      "actor": "hero",
+      "metric": "quest_log_sent_xp_count",
+      "quest": 7,
+      "save_as": "scaled_xp_before_notice"
+    },
+    {
+      "action": "client_packet",
+      "actor": "hero",
+      "opcode": 1377
+    },
+    {
+      "action": "assert",
+      "label": "Client world entry receives a fresh held-quest level",
+      "actor": "hero",
+      "metric": "quest_log_sent_level_count",
+      "quest": 7,
+      "relative_to": "scaled_levels_before_notice",
+      "min": 1,
+      "within_ms": 2000
+    },
+    {
+      "action": "assert",
+      "label": "Client world entry receives fresh held-quest reward XP",
+      "actor": "hero",
+      "metric": "quest_log_sent_xp_count",
+      "quest": 7,
+      "relative_to": "scaled_xp_before_notice",
+      "min": 1,
+      "within_ms": 2000
+    },
+    {
+      "action": "assert",
+      "label": "The replay carries the effective scaled level",
+      "actor": "hero",
+      "metric": "quest_log_sent_level",
+      "quest": 7,
+      "equals": 16
+    },
+    {
+      "action": "assert",
+      "label": "The replay carries positive reward XP",
+      "actor": "hero",
+      "metric": "quest_log_sent_xp",
+      "quest": 7,
+      "min": 1
+    },
+    {
+      "action": "assert",
+      "label": "The client-side scaling flag remains disabled",
+      "actor": "hero",
+      "metric": "quest_query_scaled",
+      "quest": 7,
+      "equals": 0
+    },
+    {
+      "action": "level_scaling_packet",
+      "actor": "hero",
+      "value": 0
+    },
+    {
+      "action": "assert",
+      "label": "Turning scaling off sends the authored level",
+      "actor": "hero",
+      "metric": "quest_log_sent_level",
+      "quest": 7,
+      "equals": 2,
+      "within_ms": 2000
+    },
+    {
+      "action": "wait",
+      "label": "Settle the scaling toggle before the repeated notice",
+      "ms": 1000
+    },
+    {
+      "action": "snapshot",
+      "actor": "hero",
+      "metric": "quest_log_sent_level_count",
+      "quest": 7,
+      "save_as": "authored_levels_before_notice"
+    },
+    {
+      "action": "snapshot",
+      "actor": "hero",
+      "metric": "quest_log_sent_xp_count",
+      "quest": 7,
+      "save_as": "authored_xp_before_notice"
+    },
+    {
+      "action": "client_packet",
+      "actor": "hero",
+      "opcode": 1377
+    },
+    {
+      "action": "assert",
+      "label": "A repeated notice receives a fresh authored-level update",
+      "actor": "hero",
+      "metric": "quest_log_sent_level_count",
+      "quest": 7,
+      "relative_to": "authored_levels_before_notice",
+      "min": 1,
+      "within_ms": 2000
+    },
+    {
+      "action": "assert",
+      "label": "A repeated notice receives fresh authored reward XP",
+      "actor": "hero",
+      "metric": "quest_log_sent_xp_count",
+      "quest": 7,
+      "relative_to": "authored_xp_before_notice",
+      "min": 1,
+      "within_ms": 2000
+    },
+    {
+      "action": "assert",
+      "label": "The repeated replay uses level 2 rather than stale level 16",
+      "actor": "hero",
+      "metric": "quest_log_sent_level",
+      "quest": 7,
+      "equals": 2
+    }
+  ]
+}
