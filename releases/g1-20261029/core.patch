+++ b/apps/coa-tests/g1_lfg_status/run.py
@@ -0,0 +1,43 @@
+import argparse
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+SOURCE = 'src/server/coa/AscensionLfgObjective.cpp'
+
+
+def main():
+    parser = argparse.ArgumentParser(description='Exercise the real read-only LFG addon status responder.')
+    parser.add_argument('--source-ref')
+    args = parser.parse_args()
+    if args.source_ref:
+        native = subprocess.check_output(['git', 'show', f'{args.source_ref}:{SOURCE}'], cwd=ROOT, text=True)
+    else:
+        native = (ROOT / SOURCE).read_text(encoding='utf-8')
+    native = '\n'.join(line for line in native.splitlines() if not line.startswith('#include '))
+    template = (HERE / 'cases.cpp').read_text(encoding='utf-8')
+    assert template.count('// NATIVE_SOURCE') == 1
+    compiler = shutil.which(os.environ.get('CXX', 'cl.exe' if os.name == 'nt' else 'c++'))
+    assert compiler, 'A C++20 compiler is required'
+    with tempfile.TemporaryDirectory(prefix='coa-lfg-status-') as directory:
+        output = Path(directory)
+        source = output / 'harness.cpp'
+        source.write_text(template.replace('// NATIVE_SOURCE', native), encoding='utf-8')
+        executable = output / ('harness.exe' if os.name == 'nt' else 'harness')
+        includes = ROOT / 'src/common/Utilities'
+        if Path(compiler).stem.lower() == 'cl':
+            flags = ['/nologo', '/std:c++20', '/EHsc', '/W4', '/WX', '/utf-8', '/I' + str(includes),
+                     str(source), '/Fe' + str(executable)]
+        else:
+            flags = ['-std=c++20', '-Wall', '-Wextra', '-Werror', '-I', str(includes), str(source),
+                     '-o', str(executable)]
+        subprocess.run([compiler, *flags], cwd=output, check=True, timeout=120)
+        subprocess.run([str(executable)], cwd=output, check=True, timeout=30)
+
+
+if __name__ == '__main__':
+    main()
