+    ResetObservations();
+    runner.RequestWorldStep();
+    assert(GameTime::requests == std::vector<Milliseconds>{ 2ms });
+
+    polling->_actors["hero"].session->pending = true;
+    polling->_relogging = false;
+    ResetObservations();
+    runner.RequestWorldStep();
+    assert(GameTime::requests == std::vector<Milliseconds>{ 2ms });
+    runner._lanes[1].realPace = true;
+    ResetObservations();
+    runner.RequestWorldStep();
+    assert(GameTime::requests.empty());
+    runner._lanes[1].realPace = false;
+
+    runner._freezeUnseenWorld = true;
+    waiting->visiblePhases = 0x10;
+    polling->visiblePhases = 0x40;
+    ResetObservations();
+    runner.RequestWorldStep();
+    assert(CoAGameplay::phaseLaneCount == 2);
+    assert(Map::phases == (CoAGameplay::PhaseSentinel | 0x50));
+    assert(GameTime::requests == std::vector<Milliseconds>{ 2ms });
+    runner._simulated = false;
+    ResetObservations();
+    runner.RequestWorldStep();
+    assert(Map::phaseCalls == 0 && GameTime::requests.empty());
+    runner._simulated = true;
+    runner._freezeUnseenWorld = false;
+    runner._lanes = { { nullptr, false } };
+    ResetObservations();
+    runner.RequestWorldStep();
+    assert(GameTime::requests.empty());
+
+    std::cout << "Pending relog persistence paces every lane without consuming futures or altering active clock caps\n";
+}
