+#include "GatheringAlertsPolicy.h"
+
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+void Check(bool result, std::string const& message)
+{
+    if (!result)
+        throw std::runtime_error(message);
+}
+
+int main()
+{
+    using namespace LocalGatheringAlerts;
+    for (auto const& [text, expectedRadius] : std::vector<std::pair<std::string, std::uint32_t>>{
+        {"Q|1|scan1|100", 100}, {"Q|1|A_z-9|1", 10}, {"Q|1|scan|250", 250},
+        {"Q|1|scan|251", 250}, {"Q|1|scan|4294967295", 250},
+        {"Q|1|" + std::string(32, 'a') + "|233", 233}})
+    {
+        auto const parsed = ParseRequest(text);
+        Check(parsed && parsed->Radius == expectedRadius, "Valid radius parsing: " + text);
+        Check(parsed->Nonce == text.substr(4, text.find('|', 4) - 4), "Nonce roundtrip: " + text);
+    }
+
+    for (std::string const& text : std::vector<std::string>{
+        "", "Q|1|", "Q|2|scan|100", "Q|1||100", "Q|1|scan|", "Q|1|scan|0", "Q|1|scan|-1",
+        "Q|1|scan|+100", "Q|1|scan|1.5", "Q|1|scan|NaN", "Q|1|scan|inf", "Q|1|scan|4294967296",
+        "Q|1|scan|100|extra", "Q|1|scan|100 ", "Q|1|scan| 100", "Q|1|scan\n|100", "Q|1|scan\t|100",
+        "Q|1|scan/../|100", "Q|1|scan|", "Q|1|" + std::string(33, 'a') + "|100",
+        std::string(10000, 'Q'), std::string("Q|1|scan|100\0extra", 18)})
+        Check(!ParseRequest(text), "Malformed request accepted");
+
+    std::cout << "Gathering alert parser boundaries passed\n";
+}
