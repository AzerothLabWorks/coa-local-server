+    std::memcpy(in.glProjection, proj, sizeof(in.glProjection));
+    in.camPos[0] = eye.x;
+    in.camPos[1] = eye.y;
+    in.camPos[2] = eye.z;
+    Vec3 f = Norm(Sub(at, eye));
+    in.camTarget[0] = eye.x + f.x * 6;
