+// The newer Furline vanity spell has a mount aura but no riding-speed auras.
+// Replace that aura with the older native spell, which has ground and flight
+// speed auras. Both spell variants need the missing visible model repaired
+// for this custom client build.
+class spell_ascension_sunwarmed_furline : public SpellScript
+{
+    PrepareSpellScript(spell_ascension_sunwarmed_furline);
+
+    static constexpr uint32 DisplayId = 99008;
+    static constexpr uint32 CreatureEntry = 80403;
+
+    bool Load() override
+    {
+        return ascensionCompatConfig.GetConfigValue<bool>(AscensionCompatConfig::ENABLED) &&
+            GetCaster()->IsPlayer();
+    }
+
+    void EnsureMountDisplay()
+    {
+        Player* player = GetCaster()->ToPlayer();
+        if (!player)
+            return;
+
+        // The newer vanity spell has a mount aura but no riding-speed aura.
+        // Replace only that aura with the native spell after a successful cast;
+        // the collection still recognizes and casts its original spell ID.
+        if (GetSpellInfo()->Id == 9931327)
+        {
+            if (!player->HasAura(9931327))
+                return;
+            player->RemoveAurasDueToSpell(9931327);
+            player->CastSpell(player, 91737, true);
+            return;
+        }
+
+        if (player->HasAura(GetSpellInfo()->Id) &&
+            player->GetUInt32Value(UNIT_FIELD_MOUNTDISPLAYID) != DisplayId)
+            player->Mount(DisplayId, 0, CreatureEntry);
+    }
+
+    void Register() override
+    {
+        AfterCast += SpellCastFn(spell_ascension_sunwarmed_furline::EnsureMountDisplay);
+    }
+};
