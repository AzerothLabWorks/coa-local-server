+CoaRole GetCoaRole(Player const* player)
+{
+    if (!player || !IsAscensionCustomClassId(player->getClass()))
+        return CoaRole::Dps;
+
+    uint32 const specializationId = GetAscensionActiveSpecialization(player);
+    if (specializationId > UINT16_MAX || !GetCoaSpecStrategy(player->getClass(), uint16(specializationId)))
+        return CoaRole::Dps;
+
+    return RoleOf(specializationId);
+}
+
+CoaStyle GetCoaStyle(Player const* player)
+{
+    if (!player || !IsAscensionCustomClassId(player->getClass()))
+        return CoaStyle::Melee;
+
+    if (SpecializationProfile const* profile = FindProfile(GetAscensionActiveSpecialization(player)))
+        if (profile->ClassId == player->getClass())
+            return profile->Style;
+
+    uint8 stats = 0;
+    return ClassStyle(player->getClass(), stats);
+}
+
+uint8 GetCoaPrimaryStats(Player const* player)
+{
+    if (!player || !IsAscensionCustomClassId(player->getClass()))
+        return 0;
+
+    if (SpecializationProfile const* profile = FindProfile(GetAscensionActiveSpecialization(player)))
+        if (profile->ClassId == player->getClass())
+            return profile->Stats;
+
+    uint8 stats = 0;
+    ClassStyle(player->getClass(), stats);
+    return stats;
+}
+
+// A stable number per bot and purpose, so the same bot keeps the same role and specialization
+// across logins and restarts (splitmix64's finaliser, cut to 32 bits).
+static uint32 Hash(uint32 value, uint32 salt)
+{
+    uint64 x = (uint64(value) << 32) ^ salt;
+    x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ULL;
+    x = (x ^ (x >> 27)) * 0x94D049BB133111EBULL;
+    return uint32((x ^ (x >> 31)) & 0xFFFFFFFFu);
+}
+
+bool EnsureCoaSpecialization(Player* bot)
+{
+    if (!IsManagedCoaBot(bot) || bot->GetLevel() < SpecializationLevel ||
+        bot->GetLevel() > MaximumProfileLevel || GetAscensionActiveSpecialization(bot) ||
+        sRandomPlayerbotMgr.GetValue(bot, "coa_manual_spec") ||
+        sRandomPlayerbotMgr.GetValue(bot, "coa_auto_spec"))
+        return false;
+
+    std::array<std::vector<uint32>, 3> const byRole = SpecializationsByRole(bot->getClass());
+
+    // Dungeon groups need a tank and a healer. Only 8 of the 21 classes can heal, so healing
+    // weighs more than tanking to reach about one healer in eight specialized bots overall.
+    // A role the class cannot fill gives its share to the others.
+    std::array<uint32, 3> const shares = { 50, 20, 30 };
+    uint32 total = 0;
+    for (uint8 role = 0; role < 3; ++role)
+        if (!byRole[role].empty())
+            total += shares[role];
+
+    if (!total)
+        return false;
+
+    // The role follows the bot's own guid, not a die, so an eligible unset bot's choice is stable.
+    uint32 roll = 1 + Hash(bot->GetGUID().GetCounter(), 0x5350454Cu) % total;   // 'SPEC'
+    uint8 chosenRole = 0;
+    for (uint8 role = 0; role < 3; ++role)
+    {
+        if (byRole[role].empty())
+            continue;
+
+        if (roll <= shares[role])
+        {
+            chosenRole = role;
+            break;
+        }
+        roll -= shares[role];
+    }
+
+    std::vector<uint32> const& candidates = byRole[chosenRole];
+    if (candidates.empty())
+        return false;
+    uint32 const specializationId = candidates[Hash(bot->GetGUID().GetCounter(), 0x50494B4Bu) % candidates.size()];   // 'PIKK'
+
+    std::string refusal;
+    if (!PrepareAscensionBotSpecialization(bot, specializationId, refusal) ||
+        GetAscensionActiveSpecialization(bot) != specializationId)
+        return false;
+
+    sRandomPlayerbotMgr.SetValue(bot, "coa_auto_spec", specializationId);
+
+    LOG_INFO("playerbots", "coa: {} (class {}, level {}) took specialization {} as {}",
+             bot->GetName(), bot->getClass(), bot->GetLevel(), specializationId, RoleName(CoaRole(chosenRole)));
+    return true;
+}
+
+uint32 ApplyCoaTalents(Player* bot)
+{
+    if (!IsManagedCoaBot(bot) || bot->GetLevel() < SpecializationLevel ||
+        bot->GetLevel() > MaximumProfileLevel || sRandomPlayerbotMgr.GetValue(bot, "coa_manual_spec"))
+        return 0;
+
+    uint32 const specializationId = GetAscensionActiveSpecialization(bot);
+    if (!specializationId || specializationId > UINT16_MAX ||
+        !GetCoaSpecStrategy(bot->getClass(), uint16(specializationId)) ||
+        sRandomPlayerbotMgr.GetValue(bot, "coa_auto_spec") != specializationId)
+        return 0;
+
+    auto const entryOf = [](uint32 entryId) -> AscensionCompatData::CoATalentEntry const*
+    {
+        for (AscensionCompatData::CoATalentEntry const& entry : AscensionCompatData::CoATalentEntries)
+            if (entry.EntryId == entryId)
+                return &entry;
+        return nullptr;
+    };
+
+    uint32 raised = 0;
+    std::string changes;
+    for (CoaLevelBuildData::Pick const& pick : CoaLevelBuildData::Picks)
+    {
+        if (pick.ClassId != bot->getClass() || pick.SpecId != specializationId ||
+            pick.Level < SpecializationLevel || pick.Level > 60 || pick.Level > bot->GetLevel())
+            continue;
+        AscensionCompatData::CoATalentEntry const* entry = entryOf(pick.EntryId);
+        if (!entry || entry->ClassId != bot->getClass() ||
+            (entry->SpecId && entry->SpecId != specializationId) || entry->RequiredLevel > bot->GetLevel() ||
+            !pick.Rank || pick.Rank > entry->SpellCount || (pick.Tree == 0 && entry->TECost) ||
+            (pick.Tree == 1 && entry->AECost) || pick.Tree > 1)
+            continue;
+
+        if (GetAscensionTalentRank(bot, pick.EntryId) >= pick.Rank)
+            continue;
+
+        std::string refusal;
+        if (PurchaseAscensionBotTalentRank(bot, pick.EntryId, pick.Rank, refusal) &&
+            GetAscensionTalentRank(bot, pick.EntryId) >= pick.Rank)
+        {
+            ++raised;
+            changes += " +" + std::to_string(pick.EntryId);
+        }
+    }
+
+    if (raised)
+        LOG_INFO("playerbots", "coa: {} (class {}, level {}, specialization {}) purchased {} talent ranks:{}",
+                 bot->GetName(), bot->getClass(), bot->GetLevel(), specializationId, raised, changes);
+    return raised;
+}
