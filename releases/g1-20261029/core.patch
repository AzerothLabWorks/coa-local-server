+    LFGDungeonData const* GetLFGDungeon(uint32 id) const { return HasData && id == Data.id ? &Data : nullptr; }
+    LfgState GetState(ObjectGuid) const { return State; }
+    bool inLfgDungeonMap(ObjectGuid, uint32 map, Difficulty difficulty) const
+    { return HasData && Dungeon == Data.id && Data.map == map && Data.difficulty == difficulty; }
+    void FinishDungeon(ObjectGuid, uint32, Map*) { ++FinishCalls; }
