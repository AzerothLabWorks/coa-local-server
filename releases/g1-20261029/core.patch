+        sRandomPlayerbotMgr.values.clear();
+        Player bot;
+        if (test == 0) bot.session.bot = false;
+        if (test == 1) bot.hasSession = false;
+        if (test == 2) bot.hasAi = false;
+        if (test == 3) bot.random = false;
+        if (test == 4) bot.session.account = 999;
+        if (test == 5) bot.name = "Amaryla";
+        if (test == 6) bot.session.account = 105;
+        if (test == 7) bot.classId = 1;
+        if (test == 8) bot.level = 81;
+        if (test == 9) sRandomPlayerbotMgr.SetValue(&bot, "coa_manual_spec", 6);
+        if (test == 10) sRandomPlayerbotMgr.SetValue(&bot, "coa_auto_spec", 6);
+        if (test == 11) bot.combat = true;
+        Player const before = bot;
+        auto const spells = bot.spells;
+        uint32 const calls = switchCalls;
+        refused = refused && !EnsureCoaSpecialization(&bot) && ApplyCoaTalents(&bot) == 0 &&
+            bot.spec == before.spec && bot.spells == spells && Preserved(before, bot) && switchCalls == calls;
+    }
+    Check(refused, "human, uncontrolled, non-generated, reserved, classic and manual actors stay untouched");
+    sRandomPlayerbotMgr.values.clear();
+    Player failing;
+    auto const before = failing;
+    switchSucceeds = false;
+    Check(!EnsureCoaSpecialization(&failing) && failing.spec == 0 && Preserved(before, failing) &&
+        !sRandomPlayerbotMgr.GetValue(&failing, "coa_auto_spec"),
+        "failed selection leaves no auto marker and restores skills");
+    switchSucceeds = true;
+}
+void AllocationChecks()
+{
+    bool bounded = true, idempotent = true, retained = true;
+    for (auto const& profile : CoaSpecStrategies)
+        for (uint8 level : {10, 11, 13, 15, 21, 40, 60, 80})
+        {
+            sRandomPlayerbotMgr.values.clear();
+            purchaseAttempts.clear();
+            Player bot;
+            bot.classId = profile.classId;
+            bot.spec = profile.specId;
+            bot.level = level;
+            sRandomPlayerbotMgr.SetValue(&bot, "coa_auto_spec", bot.spec);
+            Player const before = bot;
+            ApplyCoaTalents(&bot);
+            uint32 ae = 0, te = 0;
+            auto const known = KnownTalentEntries(&bot);
+            auto const spent = AscensionCoATalentState::Spent(known);
+            bool const budgetExists = AscensionCompatData::GetCoATalentBudget(bot.classId, level, ae, te);
+            bool const statePreserved = Preserved(before, bot);
+            bool caseBounded = statePreserved && budgetExists && spent.AE <= ae && spent.TE <= te;
+            if (!caseBounded)
+                std::printf("ALLOCATION_STATE_FAIL class=%u spec=%u level=%u preserved=%u budget=%u "
+                    "AE=%u/%u TE=%u/%u\n", bot.classId, bot.spec, level, unsigned(statePreserved),
+                    unsigned(budgetExists), spent.AE, ae, spent.TE, te);
+            for (auto const& held : known)
+            {
+                auto const* entry = Entry(held.EntryId);
+                bool const legal = entry && entry->ClassId == bot.classId &&
+                    (!entry->SpecId || entry->SpecId == bot.spec) && entry->RequiredLevel <= level;
+                if (!legal)
+                    std::printf("ALLOCATION_KNOWN_FAIL class=%u spec=%u level=%u entry=%u rank=%u "
+                        "entry_class=%u entry_spec=%u required_level=%u rank_spell=%u\n", bot.classId,
+                        bot.spec, level, held.EntryId, held.Rank, entry ? entry->ClassId : 0,
+                        entry ? entry->SpecId : 0, entry ? entry->RequiredLevel : 0,
+                        entry && held.Rank ? entry->SpellIds[held.Rank - 1] : 0);
+                caseBounded = caseBounded && legal;
+            }
+            if (!caseBounded)
+                for (auto const& attempted : purchaseAttempts)
+                    std::printf("ALLOCATION_PURCHASE class=%u spec=%u level=%u entry=%u requested_rank=%u\n",
+                        attempted[0], attempted[1], level, attempted[2], attempted[3]);
+            bounded = bounded && caseBounded;
+            auto const spells = bot.spells;
+            auto const purchases = successfulPurchases;
+            idempotent = idempotent && ApplyCoaTalents(&bot) == 0 && spells == bot.spells &&
+                purchases == successfulPurchases && Preserved(before, bot);
+            retained = retained && std::includes(bot.spells.begin(), bot.spells.end(),
+                before.spells.begin(), before.spells.end());
+        }
+    Check(bounded, "additive plans stay within native AE/TE, level and class/spec gates at representative levels");
+    Check(idempotent, "repeated automatic planning never repurchases a held rank or churns the spellbook");
+    Check(retained, "unrelated spells and partial skills/items/equipment/action buttons survive additive allocation");
+    Check(budgetBypasses == 0, "every purchase uses the normal native budget-enabled service route");
+    bool manualRetained = true;
+    for (auto const& profile : CoaSpecStrategies)
+    {
+        sRandomPlayerbotMgr.values.clear();
+        Player bot;
+        bot.classId = profile.classId;
+        bot.spec = profile.specId;
+        bot.level = 80;
+        sRandomPlayerbotMgr.SetValue(&bot, "coa_auto_spec", bot.spec);
+        for (auto const& entry : AscensionCompatData::CoATalentEntries)
+            if (entry.ClassId == bot.classId && (!entry.SpecId || entry.SpecId == bot.spec) && entry.SpellCount)
+                bot.spells.insert(entry.SpellIds[0]);
+        auto const held = AscensionCoATalentState::KnownEntries(bot.classId,
+            [&bot](uint32 spell) { return bot.HasSpell(spell); });
+        ApplyCoaTalents(&bot);
+        for (auto const& entry : held)
+            manualRetained = manualRetained && GetAscensionTalentRank(&bot, entry.EntryId) >= entry.Rank;
+    }
+    Check(manualRetained, "an auto marker never licenses removal of existing or conflicting free-choice selections");
+}
+void PurchaseChecks()
+{
+    Player bot;
+    bot.spec = 6;
+    bot.level = 11;
+    std::string refusal;
+    auto const before = bot;
+    Check(PurchaseAscensionBotTalentRank(&bot, 29736, 1, refusal) && GetAscensionTalentRank(&bot, 29736) == 1 &&
+        Preserved(before, bot), "actual purchase wrapper buys Brewmaster rank1 and restores hook-mutated skills");
+    auto const calls = purchaseCalls;
+    auto const spells = bot.spells;
+    Check(PurchaseAscensionBotTalentRank(&bot, 29736, 1, refusal) && purchaseCalls == calls && spells == bot.spells,
+        "same paid rank is idempotent without native resynchronization");
+    Check(!PurchaseAscensionBotTalentRank(&bot, 29736, 0, refusal) && spells == bot.spells,
+        "profile purchase cannot lower an existing paid selection");
+    Check(!PurchaseAscensionBotTalentRank(&bot, 29736, 2, refusal) && spells == bot.spells && Preserved(before, bot),
+        "unaffordable rank is refused by normal native budget service without state changes");
+    bot.session.bot = false;
+    Check(!PurchaseAscensionBotTalentRank(&bot, 29736, 1, refusal) && spells == bot.spells,
+        "humans cannot use automatic bot purchasing");
+    bot.session.bot = true;
+    Check(!PurchaseAscensionBotTalentRank(&bot, 0, 1, refusal) && spells == bot.spells,
+        "unknown imported entry is rejected without mutation");
+    bool freeChoiceChecked = false;
+    for (auto const& free : AscensionCompatData::CoASelectableFreeEntries)
+    {
+        auto const* entry = Entry(free.EntryId);
+        if (!entry || !entry->SpellCount)
+            continue;
+        for (auto const& other : AscensionCompatData::CoASelectableFreeEntries)
+        {
+            auto const* sibling = Entry(other.EntryId);
+            if (other.EntryId == free.EntryId || other.GroupId != free.GroupId || !sibling ||
+                sibling->ClassId != entry->ClassId || sibling->SpecId != entry->SpecId || !sibling->SpellCount)
+                continue;
+            Player chosen;
+            chosen.level = 80;
+            chosen.classId = entry->ClassId;
+            chosen.spec = entry->SpecId;
+            chosen.spells.insert(sibling->SpellIds[0]);
+            auto const original = chosen.spells;
+            Check(!PurchaseAscensionBotTalentRank(&chosen, entry->EntryId, 1, refusal) && chosen.spells == original,
+                "actual wrapper retains an existing alternative in a native selectable free group");
+            freeChoiceChecked = true;
+            break;
+        }
+        if (freeChoiceChecked)
+            break;
+    }
+    Check(freeChoiceChecked, "native catalogue contains a conflicting free-choice fixture");
+}
+void RejectedPickChecks()
+{
+    bool skips = true, refuses = true;
+    for (auto const& rejected : RejectedPicks)
+    {
+        auto const& pick = rejected.Pick;
+        sRandomPlayerbotMgr.values.clear();
+        purchaseAttempts.clear();
+        Player bot;
+        bot.classId = uint8(pick[0]);
+        bot.spec = pick[1];
+        bot.level = uint8(pick[2]);
+        sRandomPlayerbotMgr.SetValue(&bot, "coa_auto_spec", bot.spec);
+        ApplyCoaTalents(&bot);
+        std::array<uint32, 4> const invalidAttempt{pick[0], pick[1], pick[4], pick[5]};
+        skips = skips && std::find(purchaseAttempts.begin(), purchaseAttempts.end(), invalidAttempt) ==
+            purchaseAttempts.end() && GetAscensionTalentRank(&bot, pick[4]) <= rejected.SpellCount;
+        auto const before = bot;
+        auto const calls = purchaseCalls;
+        std::string refusal;
+        refuses = refuses && !PurchaseAscensionBotTalentRank(&bot, pick[4], pick[5], refusal) &&
+            !refusal.empty() && bot.spells == before.spells && Preserved(before, bot) && purchaseCalls == calls;
+    }
+    Check(skips, "actual planner skips each exact rejected tuple before native purchasing");
+    Check(refuses, "actual native wrapper independently refuses all four invalid imported selections without mutation");
+}
+bool HoldsEntry(std::vector<AscensionCoATalentState::KnownEntry> const& known, uint32 id)
+{
+    return std::any_of(known.begin(), known.end(), [id](auto const& entry) { return entry.EntryId == id; });
+}
+void SharedSpellBudgetChecks()
+{
+    auto const* shared = Entry(12264);
+    auto const* brewing = Entry(7131);
+    Check(shared && brewing && shared->ClassId == 13 && shared->SpecId == 0 && brewing->ClassId == 13 &&
+        brewing->SpecId == 6 && shared->SpellIds[0] == 503748 && brewing->SpellIds[0] == 503748,
+        "native shared-spell regression uses exact class/Brewing entry aliases for spell503748");
+    Player bot;
+    bot.spec = 4;
+    bot.spells.insert(503748);
+    auto const before = bot;
+    auto const known = KnownTalentEntries(&bot);
+    auto const spent = AscensionCoATalentState::Spent(known);
+    Check(HoldsEntry(known, 12264) && !HoldsEntry(known, 7131) && spent.AE == 1 && spent.TE == 0 &&
+        bot.spells == before.spells && Preserved(before, bot),
+        "actual bot known-state filter prices a class pick as AE without inferring a foreign Brewing purchase");
+    bot.spec = 6;
+    auto const active = KnownTalentEntries(&bot);
+    auto const activeSpent = AscensionCoATalentState::Spent(active);
+    Check(HoldsEntry(active, 7131) && HoldsEntry(active, 12264) && activeSpent.AE == 0 && activeSpent.TE == 1 &&
+        bot.HasSpell(503748), "an active Brewing alias remains known and shared rank spell is charged only once");
+    bot.spec = 0;
+    auto const unassigned = KnownTalentEntries(&bot);
+    Check(HoldsEntry(unassigned, 12264) && !HoldsEntry(unassigned, 7131) && bot.HasSpell(503748),
+        "unassigned bot retains its class spell without inferring another specialization");
+    Player human;
+    human.session.bot = false;
+    human.spec = 4;
+    human.spells.insert(503748);
+    human.settings["core.coa_talent.12264"] = {{1}};
