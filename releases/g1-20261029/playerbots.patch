diff --git a/src/Ai/Dungeon/SFK/SFKTriggers.cpp b/src/Ai/Dungeon/SFK/SFKTriggers.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..4840e5c191a542e53cdd121e9f2b58c6055acbba
