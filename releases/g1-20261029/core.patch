+};
+class ChatHandler
+{
+public:
+    static void BuildChatPacket(WorldPacket& packet, uint32 type, uint32 language, Player* sender,
+        Player* receiver, std::string const& message)
+    {
+        assert(type == CHAT_MSG_WHISPER && language == LANG_ADDON && sender == receiver);
+        packet.Opcode = sender->GameMaster ? 0x3B2 : 0x096;
+        packet.Payload = message;
+    }
+    static void BuildChatPacket(WorldPacket& packet, uint32 type, uint32 language, ObjectGuid sender,
+        ObjectGuid receiver, std::string const& message, uint8 tag, std::string const&, std::string const&,
+        uint32 achievement, bool gmMessage)
+    {
+        assert(type == CHAT_MSG_WHISPER && language == LANG_ADDON && sender == receiver);
+        assert(!tag && !achievement && !gmMessage);
+        packet.Opcode = 0x096;
+        packet.Payload = message;
+    }
+};
+class PlayerScript
+{
