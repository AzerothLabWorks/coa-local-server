+#include "BotSocialChatPolicy.h"
+#include <cassert>
+#include <iostream>
+#include <string>
+
+int main()
+{
+    using namespace BotSocialPolicy;
+    assert(Parse("hello", "Dabsalia Bot", true) == Intent::Hello);
+    assert(Parse("  DABSALIA BOT: Hello!!!  ", "Dabsalia Bot", false) == Intent::Hello);
+    assert(Parse("Dabsalia Bot, thank you.", "Dabsalia Bot", false) == Intent::Thanks);
+    assert(Parse("Dabsalia Bot farewell", "Dabsalia Bot", false) == Intent::Goodbye);
+    assert(Parse("What class are you?", "Dabsalia Bot", true) == Intent::ClassRole);
+    assert(Parse("what's your role?", "Dabsalia Bot", true) == Intent::ClassRole);
+    assert(Parse("Dabsalia Bot: where are you now?", "Dabsalia Bot", false) == Intent::Location);
+    assert(Parse("what zone are you in", "Dabsalia Bot", true) == Intent::Location);
+    assert(Parse("hello", "Dabsalia Bot", false) == Intent::None);
+    assert(Parse("Dabsalia: hello", "Dabsalia Bot", false) == Intent::None);
+    assert(Parse("Dabsalia Bots: hello", "Dabsalia Bot", false) == Intent::None);
+    assert(Parse("Someone said Dabsalia Bot hello", "Dabsalia Bot", false) == Intent::None);
+    assert(Parse("Dabsalia Bot", "Dabsalia Bot", false) == Intent::None);
+    assert(Parse("Dabsalia Bot,", "Dabsalia Bot", false) == Intent::None);
+    assert(Parse("hello", "", true) == Intent::None);
+    assert(Parse("", "Dabsalia Bot", true) == Intent::None);
+    assert(Parse(std::string(201, 'a'), "Dabsalia Bot", true) == Intent::None);
+    for (char const* command : {"follow", "stay", "help", "who", "stats", "co ?", "nc ?", "reset",
+                              "do check mount state", ".hello", "#w hello", "BOT\thello", "hello;follow",
+                              "hello\nfollow", "hello|Hitem:1|h", "hello\\follow", "hello follow", "+follow"})
+        assert(Parse(command, "Dabsalia Bot", true) == Intent::None);
+
+    Cooldown cooldown;
+    assert(!cooldown.Accept(0, Intent::Hello, 100));
+    assert(!cooldown.Accept(1, Intent::None, 100));
+    assert(cooldown.Accept(1, Intent::Hello, 100));
+    assert(!cooldown.Accept(2, Intent::Hello, 10099));
+    assert(cooldown.Accept(2, Intent::Hello, 10100));
+    assert(!cooldown.Accept(1, Intent::Hello, 20100));
+    assert(cooldown.Accept(1, Intent::Thanks, 20100));
+    assert(!cooldown.Accept(1, Intent::Hello, 60099));
+    assert(cooldown.Accept(1, Intent::Hello, 60100));
+
+    SenderBudget budget;
+    assert(!budget.Accept(0, 0));
+    assert(budget.Accept(1, 0));
+    assert(!budget.Accept(1, 4999));
+    assert(budget.Accept(1, 5000));
+    for (unsigned sender = 2; sender <= 256; ++sender)
+        assert(budget.Accept(sender, 5000));
+    assert(!budget.Accept(257, 5000));
+    assert(budget.Accept(257, 10000));
+    assert(!budget.Accept(257, 14999));
+    assert(budget.Accept(257, 15000));
+    std::cout << "G1 social intent and bounded pacing policy passed\n";
+}
