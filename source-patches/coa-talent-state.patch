+    static void RecordTalentSelection(Player* player, AscensionCompatData::CoATalentEntry const& entry, uint32 rank)
+    {
+        uint32 const freeChoiceGroup = GetSelectableFreeGroup(entry.EntryId);
+        if (entry.ClassId != player->getClass() || rank > entry.SpellCount ||
+            (!entry.AECost && !entry.TECost && !freeChoiceGroup))
+            return;
