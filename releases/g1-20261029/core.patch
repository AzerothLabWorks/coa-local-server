+    bool InBattleground() const { return battleground; }
+    bool canFlyInZone(uint32, uint32, SpellInfo const*) const { return zoneAllowed; }
+    auto const& GetAuraEffectsByType(uint32) const { return mounts; }
+    void learnSpell(uint32 id, bool) { spells.insert(id); ++learningCalls; }
+    void SetSkill(uint32, uint16 step, uint16 value, uint16 maximum)
+    {
+        ridingStep = step;
+        riding = value;
+        ridingMaximum = maximum;
+    }
+};
