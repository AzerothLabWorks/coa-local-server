+    bool IsSocialChatRequest(uint32 type, std::string const& text, Player* sender, uint32 lang) const;
+    bool SayToParty(std::string const& text) { return Send(CHAT_MSG_PARTY, text); }
+    bool SayToRaid(std::string const& text) { return Send(CHAT_MSG_RAID, text); }
+    bool Say(std::string const& text) { return Send(CHAT_MSG_SAY, text); }
+    bool Send(uint32 type, std::string const& text)
+    {
+        FixtureMessages.push_back({type, bot->guid, 0, text, {}});
+        return true;
+    }
+};
+
+struct Config
+{
