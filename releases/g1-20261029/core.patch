+    sPlayerbotAIConfig.socialPacingEnabled = true;
+    Require(!AllowAmbient(0, 1, "World", "line"), "enabled wrapper applies invalid-bot rejection");
+    Require(AllowAmbient(1, 1, "World", "first"), "enabled wrapper permits initial ambient line");
+    Require(!AllowAmbient(2, 1, "World", "second"), "enabled wrapper shares channel cooldown");
+    Require(AllowAmbient(3, 2, "World", "first"), "enabled wrapper separates factions");
+    Require(!AllowAmbient(1, 1, "General", "elsewhere"), "enabled wrapper shares per-bot cooldown across channels");
+    previous = SelectTemplate("wrapper-two", 2);
+    for (unsigned turn = 0; turn < 100; ++turn)
+    {
+        auto const next = SelectTemplate("wrapper-two", 2);
+        Require(next < 2 && next != previous, "enabled wrapper remembers prior template selection");
+        previous = next;
+    }
+    Require(uniformCalls == 2 && randomCalls == 101, "enabled wrapper uses history selection random source");
+
+    std::atomic<unsigned> concurrentAccepted = 0;
+    std::atomic<unsigned> concurrentOnes = 0;
+    std::atomic<unsigned> invalidSelections = 0;
+    std::array<std::thread, 16> workers;
+    for (unsigned worker = 0; worker < workers.size(); ++worker)
+        workers[worker] = std::thread([worker, &concurrentAccepted, &concurrentOnes, &invalidSelections]()
