+-- CoA rotations per specialization, for playerbots_custom_strategy.
+--
+-- 71 strategies: one combat rotation per specialization plus the Tinker's
+-- non-combat set, 2544 rules in total. Generated from the per-specialization
+-- guides published by ascensionsidekick.com and checked against the client's
+-- Spell.dbc. Credit for the guide data belongs there.
+--
+-- These rows do nothing on their own. They are applied only when
+-- AiPlayerbot.CoaSpecRotations is on; with the setting off, CoA bots run on
+-- the runtime classifier alone and never look this table up.
+--
+-- Re-applicable by design: every block deletes its own strategy first, so a
+-- regenerated file replaces what it owns and a partial load is not possible.
+-- Per-bot rows (owner != 0) are not touched.
+--
+-- Do not edit by hand. The generator is tools/rotation_bauen.py in
+-- mod-playerbots-coa; the next run overwrites whatever is here.
+
+-- ===== klasse-12-barbarian-ancestry.sql ==================================
+-- Barbarian / Ancestry - combat rotation up to level 20.
+--
+-- Role:      damage  (support)
+-- Position:  close
+-- Spec id:   3
+--
+-- Generated by tools/rotation_bauen.py from the Sidekick spec guide,
+-- checked against Spell.dbc, the class spell list and the resource
+-- table. Not a measured optimum - a rotation a bot can run.
+--
+-- Enable with:  co +custom::barbarian-ancestry
+--
+-- STANDARD RESOURCES this rotation spends:
+--   Energie: Keg Smash, Keg Smash, Breath of The North, Warband, Splash Zone, Jawbreaker, Maiming Spear, Tavern Brawl!, Clanlord's Totem, Spirit of War, Spirit of Conflict, Spirit of Bloodshed, Enduring Shout, Barbaric Whirl, Break, Spirit of Savagery, Whirling Advance, Brutal Shout, Ancestral Strike
+--   These do NOT come from AscensionCustomResourceData.h but from the
+--   standard system. Whether the class actually builds them is in
+--   no data - only the bar in game shows it.
+--   MIND THE TEST TARGET. Generation is read off the spell, not off
+--   the damage dealt, so against a training dummy the bar stays at
+--   zero and every rule that spends the resource looks broken. On
+--   14.09.2026 we read a Reaper bot that way and filed it as a bug;
+--   measured on a live server on 17.09.2026, 14 of 57 Reaper bots
+--   had runic power, several a full bar.
+--   If a rule never fires although it looks affordable: check the
+--   bar on the bot against a real target first, do not change the
+--   rule.
+--
+
+DELETE FROM `playerbots_custom_strategy` WHERE `name` = 'barbarian-ancestry';
+
+INSERT INTO `playerbots_custom_strategy` (`name`, `idx`, `owner`, `action_line`) VALUES
+
+-- 1. Keg Smash (guide/dungeon, from level 0, ID 805808).
+--    [costs 15 Energie, cooldown 10s]
+--    Sidekick Ancestry, dungeon section: 6) Keg Smash on cooldown for AoE
+--    damage and threat across packs, feeding the Honored Ancestor's
+--    Ancestral Whirl via The Spins
+('barbarian-ancestry', 1, 0, 'medium aoe>cast melee::Keg Smash!88'),
+
+-- 2. Ale of The God-King (guide/solo, from level 0, ID 805780).
+--    [cooldown 15s]
+--    Sidekick Ancestry, solo section: 3) Ale of the God-King the instant
+--    your Tankard is full, and don't let a fill go stale
+('barbarian-ancestry', 2, 0, 'can cast::Ale of The God-King>cast melee::Ale of The God-King!87'),
+
+-- 3. Keg Smash (guide/solo, from level 0, ID 805808).
+--    [costs 15 Energie, cooldown 10s]
+--    Sidekick Ancestry, solo section: 2) Keg Smash on cooldown (boosted by
+--    Trip to the Alehouse) as your core AoE/ST frost+physical hit
+('barbarian-ancestry', 3, 0, 'can cast::Keg Smash>cast melee::Keg Smash!86'),
+
+-- 4. Smash (guide/playstyle, from level 0, ID 801755).
+--    [cooldown 3s]
+--    Sidekick Ancestry, playstyle section: A Keg Smash-spamming
+--    frost/physical melee brawler who buffs everyone near you just by
+--    existing
+('barbarian-ancestry', 4, 0, 'can cast::Smash>cast melee::Smash!85'),
+
+-- 5. Breath of The North (guide/solo, from level 0, ID 800838).
+--    [costs 50 Energie]
+--    Sidekick Ancestry, solo section: 4) Breath of the North whenever the
+--    Tankard is empty
+('barbarian-ancestry', 5, 0, 'can cast::Breath of The North>cast melee::Breath of The North!84'),
+
+-- 6. Warband (class spell/early, from level 60, ID 560883).
+--    [costs 30 Energie, cooldown 90s]
+--    Class spell from level 60. Filler for the low levels: the guide
+--    describes the spec at 60, this line carries the bot before that.
+('barbarian-ancestry', 6, 0, 'can cast::Warband>cast melee::Warband!30'),
+
+-- 7. Splash Zone (class spell/early, from level 60, ID 705156).
+--    [costs 25 Energie, cooldown 30s]
+--    Class spell from level 60. Filler for the low levels: the guide
+--    describes the spec at 60, this line carries the bot before that.
+('barbarian-ancestry', 7, 0, 'buff missing::Splash Zone>cast buff party::Splash Zone!29'),
+
+-- 8. Improved Ancestral Combat (class spell/early, from level 60, ID 705209).
+--    Class spell from level 60. Filler for the low levels: the guide
+--    describes the spec at 60, this line carries the bot before that.
+('barbarian-ancestry', 8, 0, 'buff missing::Improved Ancestral Combat>cast buff::Improved Ancestral Combat!28'),
+
+-- 9. Hodir's Wrath (class spell/early, from level 60, ID 800152).
+--    [cooldown 90s]
+--    Class spell from level 60. Filler for the low levels: the guide
+--    describes the spec at 60, this line carries the bot before that.
+('barbarian-ancestry', 9, 0, 'can cast::Hodir''s Wrath>cast melee::Hodir''s Wrath!27'),
+
+-- 10. Jawbreaker (class spell/early, from level 60, ID 802792).
+--    [costs 30 Energie, cooldown 14s]
+--    Class spell from level 60. Filler for the low levels: the guide
+--    describes the spec at 60, this line carries the bot before that.
+('barbarian-ancestry', 10, 0, 'can cast::Jawbreaker>cast melee::Jawbreaker!26'),
+
+-- 11. Headhunter's Spear (class spell/early, from level 60, ID 804137).
+--    [cooldown 6s]
+--    Class spell from level 60. Filler for the low levels: the guide
+--    describes the spec at 60, this line carries the bot before that.
+('barbarian-ancestry', 11, 0, 'can cast::Headhunter''s Spear>cast melee::Headhunter''s Spear!25'),
