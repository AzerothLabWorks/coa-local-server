+        return found == FixtureManagers.end() ? nullptr : found->second;
+    }
+    Channel* GetChannel(std::string const& name, Player*, bool)
+    {
+        auto const found = channels.find(name);
+        return found == channels.end() ? nullptr : found->second;
+    }
