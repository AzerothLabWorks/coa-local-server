 class RunnerTests(unittest.TestCase):
+    def test_bot_mount_acquisition_requires_a_player_spell_and_explicit_boolean_result(self):
+        scenario = run.read_json(Path(__file__).parent / 'scenarios' / 'g1-bot-mount-acquisition.json')
+        self.assertIs(run.validate(scenario), scenario)
+        index = next(index for index, step in enumerate(scenario['steps']) if step['action'] == 'ensure_bot_mount')
+        for change in ({'accepted': 1}, {'accepted': 'true'}, {'actor': 'absent'}, {'spell': 0}):
+            candidate = copy.deepcopy(scenario)
+            candidate['steps'][index].update(change)
+            with self.subTest(change=change), self.assertRaises(ValueError):
+                run.validate(candidate)
+        candidate = copy.deepcopy(scenario)
+        del candidate['steps'][index]['accepted']
+        with self.assertRaises(ValueError):
+            run.validate(candidate)
+        candidate = copy.deepcopy(scenario)
+        candidate['creatures'] = [{'id': 'target', 'owner': 'bot', 'entry': 1501}]
+        candidate['steps'][index]['actor'] = 'target'
+        with self.assertRaises(ValueError):
+            run.validate(candidate)
+        candidate['steps'][index] = {
+            'action': 'assert', 'actor': 'target', 'metric': 'known_spell_count', 'equals': 0}
+        with self.assertRaises(ValueError):
+            run.validate(candidate)
+
     def test_profession_fixture_validation(self):
         scenario = run.read_json(Path(__file__).parent / 'scenarios' / 'profession-xp.json')
         self.assertIs(run.validate(scenario), scenario)
