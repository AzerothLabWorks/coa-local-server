+CLI_DESCRIPTION = "Audit pinned CoA rotations, ownership boundaries, loader policy and bounded in-memory SQL semantics."
+
+import json
+import os
+from pathlib import Path
+import shlex
+import shutil
+import subprocess
+import tempfile
+
+from generate import (
+    EXPECTED_BASE_ROWS,
+    EXPECTED_FINAL_ROWS,
+    EXPECTED_FINAL_SHA256,
+    EXPECTED_KEYS_SHA256,
+    EXPECTED_NAMES,
+    Interpreter,
+    MIGRATION,
+    ROOT,
+    Row,
+    audit,
+    key_hash,
+    load_vendor,
+    render,
+    row_hash,
+)
+
+
+METADATA = MIGRATION.with_name("rev_20261004_00_coa_metadata.sql")
+
+
+def require(condition, message):
+    if not condition:
+        raise AssertionError(message)
+
+
+def rejects(text, rows=()):
+    try:
+        Interpreter(text, rows).apply()
+    except ValueError:
+        return
+    raise AssertionError(f"Unsupported SQL was accepted: {text[:100]}")
+
+
+def check_interpreter():
+    escaped = "INSERT INTO playerbots_custom_strategy (name, idx, owner, action_line) VALUES "
+    escaped += "('quote', 1, 0, 'can cast::Night''s Watch>cast::Night''s Watch!95');"
+    row = Interpreter(escaped).apply()[0]
+    require(row.action_line == "can cast::Night's Watch>cast::Night's Watch!95", "SQL apostrophe decoding failed")
+    duplicate = escaped + escaped
+    rejects(duplicate)
+    rejects("DROP TABLE playerbots_custom_strategy;")
+    rejects("DELETE FROM playerbots_custom_strategy;")
+    rejects("UPDATE characters SET action_line = 'broken' WHERE name = 'quote';")
+    selected = [Row("a", 1, 0, "zero-a"), Row("a", 1, 20, "owned-a"), Row("b", 1, 0, "zero-b")]
+    remaining = Interpreter(
+        "DELETE FROM playerbots_custom_strategy WHERE owner = 0 AND (name = 'a' OR name = 'b');", selected
+    ).apply()
+    require(remaining == [selected[1]], "Owner condition or parenthesized OR precedence failed")
+    remaining = Interpreter(
+        "DELETE FROM playerbots_custom_strategy WHERE name = 'a' OR name = 'b' AND owner = 0;", selected
+    ).apply()
+    require(remaining == [], "SQL AND precedence failed")
+    sample = [Row("function", 2, 0, "buff missing::Night's Watch>cast buff::Night's Watch!6")]
+    updated = Interpreter(
+        "UPDATE playerbots_custom_strategy SET action_line = CONCAT(SUBSTRING_INDEX(action_line, '!', 1), '!95') "
+        "WHERE name IN ('function') AND action_line REGEXP '^buff missing::(Night''s Watch)>';", sample
+    ).apply()
+    require(updated[0].action_line.endswith("!95"), "Pinned REGEXP/CONCAT/SUBSTRING_INDEX semantics failed")
+    updated = Interpreter(
+        "UPDATE playerbots_custom_strategy SET action_line = REPLACE(REPLACE(action_line, 'buff missing::', "
+        "'medium aoe heal>'), 'cast buff::', 'cast heal tank::') WHERE action_line LIKE 'buff missing::%';", sample
+    ).apply()
+    require(updated[0].action_line.startswith("medium aoe heal>"), "Nested REPLACE/LIKE semantics failed")
+
+
+def check_oracle(base, final):
+    require(len(base) == EXPECTED_BASE_ROWS, "Pinned base rule count differs")
+    require(len(final) == EXPECTED_FINAL_ROWS, "Pinned corrected rule count differs")
+    require(len({row.name for row in final}) == EXPECTED_NAMES, "Pinned strategy-name count differs")
+    require(row_hash(final) == EXPECTED_FINAL_SHA256, "Pinned corrected rule hash differs")
+    require(key_hash(final) == EXPECTED_KEYS_SHA256, "Pinned corrected primary-key hash differs")
+    require({row.name for row in base} == {row.name for row in final}, "Corrections changed the owned name set")
+    require(len({row.key() for row in final}) == len(final), "Duplicate logical rotation primary keys")
+    require(all(row.owner == 0 and row.idx > 0 and len(row.action_line) <= 1024 for row in final),
+            "Owner, index or action_line schema bounds differ")
+    summary = audit(base, final)
+    require((summary["inserted_keys"], summary["removed_keys"], summary["changed_rules"]) == (23, 47, 71),
+            "Pinned correction delta differs")
+    lines = {row.action_line for row in final if row.name == "starcaller-moon-priest"}
+    require("can cast::Lunar Eclipse>cast::Lunar Eclipse!79" in lines, "Moon Priest replacement was not applied")
+    lines = {row.action_line for row in final if row.name == "ranger-archery"}
+    require("can cast::Auto Shot>cast::Auto Shot!6" in lines, "Version 1.7 Ranger correction was not applied")
+    require("aura stacks::Advantage,4>cast::Skullpiercer!85" in lines, "Version 1.7 resource gate differs")
+    require(not any("::Parachute Pack!" in row.action_line for row in final if row.name.startswith("tinker-")),
+            "Tinker travel-only spell remained in combat rotations")
+    require(not any("::Moon Gaze!" in row.action_line for row in final if row.name.startswith("bloodmage-")),
+            "Bloodmage immobilizing form remained in rotations")
+    return summary
+
+
+def check_migration(final):
+    migration = MIGRATION.read_text(encoding="utf-8")
+    require(migration == render(final), "Pending migration differs from the reproducible owner-zero rendering")
+    require(all(len(line) <= 120 for line in migration.splitlines()), "Pending SQL exceeds 120 columns")
+    require("`id`" not in migration, "Migration must not assign physical row ids")
+    names = sorted({row.name for row in final})
+    protected = [Row(name, 1, owner, f"owned:{name}:{owner}") for name in names for owner in (105, 999)]
+    protected += [Row("unrelated", 1, 0, "unrelated default"), Row("say", 1, 0, "classic default")]
+    stale = [Row(name, 5000, 0, "obsolete vendor rule") for name in names]
+    interpreter = Interpreter(migration, protected + stale)
+    imported = interpreter.apply()
+    require(interpreter.statements == ["start", "delete", "insert", "commit"],
+            "Migration contains anything beyond transactional replacement")
+    require(all(row in imported for row in protected), "Bounded model changed character-owned or unrelated rows")
+    require(all(row not in imported for row in stale), "Bounded model retained stale owned defaults")
+    require(sorted(row for row in imported if row.name in names and row.owner == 0) == final,
+            "Bounded model imported rules differ from the pinned oracle")
+    require(Interpreter(migration, imported).apply() == imported, "Logical rule replacement is not idempotent")
+    return len(protected)
+
+
+def method(source, signature):
+    start = source.index(signature)
+    opened = source.index("{", start)
+    depth = 1
+    position = opened + 1
+    while depth:
+        if position >= len(source):
+            raise ValueError(f"Unbalanced method {signature}")
+        depth += (source[position] == "{") - (source[position] == "}")
+        position += 1
+    return source[start:position]
+
+
+def check_loader():
+    header = (ROOT / "src/server/database/Database/DatabaseLoader.h").read_text(encoding="utf-8")
+    script = (ROOT / "modules/mod-playerbots/src/Script/Playerbots.cpp").read_text(encoding="utf-8")
+    require('#include "DBUpdater.h"' in script, "Safe loader lacks its updater declaration")
+    require('#include <filesystem>' in script and '#include <system_error>' in script,
+            "Safe loader lacks explicit non-throwing filesystem declarations")
+    require("DATABASE_PLAYERBOTS = 8" in header, "Extracted fixture mask no longer matches the core enum")
+    methods = method(header, "void SetUpdateFlags(") + "\n" + method(header, "void ClearUpdateFlags(")
+    loading = method(script, "bool OnDatabasesLoading() override")
+    loading = "bool RunProductionLoader()\n" + loading[loading.index("{"):]
+    compiler = os.environ.get("CXX") or shutil.which("c++") or shutil.which("g++") or shutil.which("clang++")
+    if not compiler:
+        raise RuntimeError("A portable C++ compiler is required for the extracted loader-policy fixture")
+    with tempfile.TemporaryDirectory(prefix="coa-g1-rotation-loader-") as temporary:
+        directory = Path(temporary)
+        recipes = directory / "recipes"
+        for recipe in (
+            "valid", "missing-directory", "missing-metadata", "missing-rotations",
+            "metadata-directory", "rotations-directory", "metadata-error", "rotations-error",
+        ):
+            source = recipes / recipe / "modules/mod-playerbots"
+            source.mkdir(parents=True)
+            if recipe == "missing-directory":
+                continue
+            migrations = recipes / recipe / "data/sql/updates/pending_db_playerbots"
+            migrations.mkdir(parents=True)
+            for name, part in ((METADATA.name, "metadata"), (MIGRATION.name, "rotations")):
+                path = migrations / name
+                if recipe == f"missing-{part}":
+                    continue
+                if recipe == f"{part}-directory":
+                    path.mkdir()
+                elif recipe == f"{part}-error":
+                    path.symlink_to(path.name)
+                else:
+                    path.write_text("SELECT 1;\n", encoding="utf-8")
+        (directory / "LoaderMethods.h").write_text(methods, encoding="utf-8")
+        (directory / "LoaderPolicy.h").write_text(loading, encoding="utf-8")
+        executable = directory / "fixture"
+        command = shlex.split(compiler) + [
+            "-std=c++20", "-Wall", "-Wextra", "-Werror", "-I", str(directory),
+            str(Path(__file__).with_name("loader_fixture.cpp")), "-o", str(executable),
+        ]
+        subprocess.run(command, check=True)
+        subprocess.run([str(executable), str(recipes)], check=True)
+
+
+def check_metadata():
+    actual = METADATA.read_text(encoding="utf-8")
+    expected = (
+        "ALTER TABLE `updates`\n"
+        "MODIFY COLUMN `state` ENUM('RELEASED', 'ARCHIVED', 'CUSTOM', 'MODULE') NOT NULL DEFAULT 'RELEASED'\n"
+        "COMMENT 'defines if an update is released, archived, custom or module-specific.';\n"
+    )
+    require(actual == expected, "Pending metadata update differs from the non-destructive enum extension")
+    require(METADATA.name < MIGRATION.name, "MODULE enum extension does not precede rotation metadata recording")
+
+
+def main():
+    check_interpreter()
+    base, final = load_vendor()
+    summary = check_oracle(base, final)
+    summary["bounded_model_preserved_rows"] = check_migration(final)
+    check_loader()
+    check_metadata()
+    summary["scope"] = "Pinned source, extracted loader policy and bounded SQL semantics; no native database execution"
+    print(json.dumps(summary, indent=2))
+
+
+if __name__ == "__main__":
+    main()
