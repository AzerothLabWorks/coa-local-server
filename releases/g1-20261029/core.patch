+    if (!refusal.empty())
+        return false;
+    if (rank == GetAscensionTalentRank(player, entryId))
+        return true;
+    if (uint32 const group = AscensionClassService::GetSelectableFreeGroup(entryId))
+        for (auto const& other : AscensionCompatData::CoATalentEntries)
+            if (other.ClassId == player->getClass() && other.SpecId == entry->SpecId &&
+                other.EntryId != entryId && AscensionClassService::GetSelectableFreeGroup(other.EntryId) == group &&
+                GetAscensionTalentRank(player, other.EntryId))
+            {
+                refusal = "An existing free-choice talent is retained.";
+                return false;
+            }
+
+    struct SavedSkill
+    {
+        uint16 Id;
+        uint16 Step;
+        uint16 Value;
+        uint16 Maximum;
+    };
+    std::vector<SavedSkill> skills;
+    for (uint32 id = 1; id < sSkillLineStore.GetNumRows(); ++id)
+        if (player->HasSkill(id))
+            skills.push_back({uint16(id), player->GetSkillStep(id), player->GetPureSkillValue(id),
+                player->GetPureMaxSkillValue(id)});
+    bool const purchased = AscensionClassService::Instance().SetTalentRank(player, *entry, rank, refusal);
+    for (auto const& skill : skills)
