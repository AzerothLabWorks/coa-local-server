+        accepted += shared.Accept(1000, bot, "alliance:World", "hello " + std::to_string(bot), limits);
+    Require(accepted == 1, "1500 simultaneous bots produce only one channel message");
+    Require(!shared.Accept(8999, 2, "alliance:World", "next", limits), "channel minimum interval");
+    Require(shared.Accept(9000, 2, "alliance:World", "next", limits), "channel interval exact boundary");
+    Require(!shared.Accept(10000, 2, "alliance:General-Elwynn", "elsewhere", limits), "bot cooldown across channels");
+    Require(shared.Accept(10000, 3, "alliance:General-Elwynn", "elsewhere", limits), "zone separate from world");
+    Require(shared.Accept(10000, 4, "horde:World", "next", limits), "faction channel independently paced");
+    Require(!shared.Accept(99000, 5, "alliance:World", "next", limits), "repeat blocked across bot identities");
+    Require(shared.Accept(189000, 5, "alliance:World", "next", limits), "repeat cooldown expires");
+    Require(!shared.Accept(200000, 0, "world", "line", limits), "invalid bot rejected");
