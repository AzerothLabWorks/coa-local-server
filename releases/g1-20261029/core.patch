+    Require(messageCapacity.Accept(180000, 1, "World", "overflow", messageLimit),
+            "expired message capacity is reclaimed");
+
+    RecentChoices choices;
+    Require(choices.Pick("none", 0, 0) == 0, "empty catalog safe sentinel");
+    Require(choices.Pick("one", 1, 5) == 0, "single template remains available");
+    std::size_t previous = choices.Pick("two", 2, 0);
+    for (unsigned turn = 0; turn < 100; ++turn)
+    {
+        auto const next = choices.Pick("two", 2, turn);
+        Require(next < 2 && next != previous, "two templates alternate instead of repeat");
+        previous = next;
+    }
+    std::deque<std::size_t> recent;
+    for (unsigned turn = 0; turn < 1000; ++turn)
+    {
+        auto const next = choices.Pick("many", 10, turn * 19);
+        Require(next < 10 && std::find(recent.begin(), recent.end(), next) == recent.end(),
+                "last three templates excluded");
+        recent.push_back(next);
+        if (recent.size() > 3)
+            recent.pop_front();
+    }
+    Require(choices.Pick("many", 2, 22) < 2, "catalog shrinking discards stale indices");
+
+    RecentChoices historyCapacity;
+    for (unsigned key = 0; key < 2048; ++key)
+        Require(historyCapacity.Pick(std::to_string(key), 2, 0) == 0, "history admits bounded keys");
+    Require(historyCapacity.Pick("overflow", 2, 0) == 0 && historyCapacity.Pick("overflow", 2, 0) == 0,
+            "history capacity safely falls back without tracking new keys");
+    Require(historyCapacity.Pick("0", 2, 0) == 1, "full history preserves existing tracked keys");
+
+    Require(AllowAmbient(0, 1, "", ""), "disabled wrapper does not impose new validation");
+    Require(AllowAmbient(1, 1, "World", "same") && AllowAmbient(1, 1, "World", "same"),
+            "disabled wrapper does not impose cooldowns");
+    Require(SelectTemplate("disabled", 0) == 0 && SelectTemplate("disabled", 1) == 0 && uniformCalls == 0,
+            "empty and singleton wrapper catalogs bypass random functions");
+    Require(SelectTemplate("disabled", 5) == 4 && SelectTemplate("disabled", 5) == 4 && uniformCalls == 2 &&
+            randomCalls == 0, "disabled template wrapper retains ordinary random selection");
