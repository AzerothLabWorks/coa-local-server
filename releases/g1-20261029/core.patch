+CLI_DESCRIPTION = "Compile native relog I/O pacing and multi-lane clock-request guards without a database."
+
+import os
+from pathlib import Path
+import runpy
+import shutil
+import subprocess
+import tempfile
+
+
+HERE = Path(__file__).resolve().parent
+ROOT = HERE.parents[2]
+method = runpy.run_path(str(HERE.parent / "client_compat/run.py"))["method"]
+
+
+def main():
+    source = (ROOT / "src/server/coa/CoAGameplayTest.cpp").read_text(encoding="utf-8")
+    compiler = shutil.which(os.environ.get("CXX", "cl.exe" if os.name == "nt" else "c++"))
+    if not compiler:
+        raise RuntimeError("A C++20 compiler is required")
+    with tempfile.TemporaryDirectory(prefix="coa-gameplay-relog-clock-") as temporary:
+        directory = Path(temporary)
+        (directory / "NativeRelogGuard.h").write_text(
+            method(source, "bool RelogExternalWorkPending() const"), encoding="utf-8")
+        (directory / "NativeRequestWorldStep.h").write_text(
+            method(source, "void RequestWorldStep() const"), encoding="utf-8")
+        executable = directory / ("fixture.exe" if os.name == "nt" else "fixture")
+        includes = [directory, ROOT / "src/server/coa", ROOT / "src/common/Utilities"]
+        sources = [HERE / "fixture.cpp", ROOT / "src/server/coa/CoAGameplayClock.cpp"]
+        if Path(compiler).stem.lower() == "cl":
+            flags = ["/nologo", "/std:c++20", "/EHsc", "/W4", "/WX", "/utf-8"]
+            flags += ["/I" + str(path) for path in includes]
+            flags += [str(path) for path in sources] + ["/Fe" + str(executable)]
+        else:
+            flags = ["-std=c++20", "-Wall", "-Wextra", "-Werror"]
+            for path in includes:
+                flags += ["-I", str(path)]
+            flags += [str(path) for path in sources] + ["-o", str(executable)]
+        subprocess.run([compiler, *flags], cwd=directory, check=True, timeout=120)
+        subprocess.run([str(executable)], cwd=directory, check=True, timeout=30)
+
+
+if __name__ == "__main__":
+    main()
