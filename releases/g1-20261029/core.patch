+    Require(accepted == 8, "one minute of 1000-bot attempts respects shared pacing");
+
+    AmbientPolicy bounded;
+    for (unsigned channel = 0; channel < 512; ++channel)
+        Require(bounded.Accept(0, channel + 1, std::to_string(channel), "line", limits), "bounded channel admission");
+    Require(!bounded.Accept(0, 600, "overflow", "line", limits), "channel capacity fails closed");
+    Require(bounded.Accept(180000, 600, "overflow", "line", limits), "expired capacity is reclaimed");
+
+    AmbientPolicy botCapacity;
+    Limits const botLimit{0, 90000, 0};
+    for (unsigned bot = 1; bot <= 4096; ++bot)
+        Require(botCapacity.Accept(0, bot, "World", "line", botLimit), "bot capacity admits bounded population");
+    Require(!botCapacity.Accept(0, 4097, "World", "line", botLimit), "bot capacity fails closed");
+    Require(botCapacity.Accept(90000, 4097, "World", "line", botLimit), "expired bot capacity is reclaimed");
