diff --git a/src/Util/BotChatPacingPolicy.h b/src/Util/BotChatPacingPolicy.h
new file mode 100644
index 0000000000000000000000000000000000000000..ee67cfce2f39ae2f661fb7d27301df99be865d39
--- /dev/null
+++ b/src/Util/BotChatPacingPolicy.h
@@ -0,0 +1,106 @@
+#ifndef PLAYERBOTS_BOT_CHAT_PACING_POLICY_H
+#define PLAYERBOTS_BOT_CHAT_PACING_POLICY_H
+
+#include <algorithm>
+#include <cstdint>
+#include <deque>
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace BotChatPacing
+{
+struct Limits
+{
+    std::uint64_t channelMs = 8000;
+    std::uint64_t botMs = 90000;
+    std::uint64_t repeatMs = 180000;
+};
+
+class AmbientPolicy
+{
+public:
+    bool Accept(std::uint64_t now, std::uint64_t bot, std::string const& channel,
+                std::string const& message, Limits const& limits)
+    {
+        if (!bot || channel.empty() || channel.size() > 192 || message.empty() || message.size() > 1024)
+            return false;
+
+        if (now >= nextSweep)
+        {
+            Prune(bots, now);
+            Prune(channels, now);
+            Prune(messages, now);
+            nextSweep = now + 30000;
+        }
+
+        auto const key = std::make_pair(channel, message);
+        if (Blocked(bots, bot, now) || Blocked(channels, channel, now) || Blocked(messages, key, now))
+            return false;
+
+        if ((!bots.contains(bot) && bots.size() >= 4096) ||
+            (!channels.contains(channel) && channels.size() >= 512) ||
+            (!messages.contains(key) && messages.size() >= 4096))
+            return false;
+
+        bots[bot] = now + limits.botMs;
+        channels[channel] = now + limits.channelMs;
+        messages[key] = now + limits.repeatMs;
+        return true;
+    }
+
+private:
+    template <typename Map, typename Key>
+    static bool Blocked(Map const& entries, Key const& key, std::uint64_t now)
+    {
+        auto const found = entries.find(key);
+        return found != entries.end() && now < found->second;
+    }
+
+    template <typename Map>
+    static void Prune(Map& entries, std::uint64_t now)
+    {
+        std::erase_if(entries, [now](auto const& item) { return now >= item.second; });
+    }
+
+    std::uint64_t nextSweep = 0;
+    std::map<std::uint64_t, std::uint64_t> bots;
+    std::map<std::string, std::uint64_t> channels;
+    std::map<std::pair<std::string, std::string>, std::uint64_t> messages;
+};
+
+class RecentChoices
+{
+public:
+    std::size_t Pick(std::string const& key, std::size_t count, std::uint32_t random)
+    {
+        if (count < 2)
+            return 0;
+        if (!history.contains(key) && history.size() >= 2048)
+            return random % count;
+
+        auto& recent = history[key];
+        std::erase_if(recent, [count](std::size_t value) { return value >= count; });
+        std::size_t const keep = std::min<std::size_t>(3, count - 1);
+        while (recent.size() > keep)
+            recent.pop_front();
+
+        std::vector<std::size_t> eligible;
+        for (std::size_t index = 0; index < count; ++index)
+            if (std::find(recent.begin(), recent.end(), index) == recent.end())
+                eligible.push_back(index);
+
+        std::size_t const chosen = eligible[random % eligible.size()];
+        recent.push_back(chosen);
+        while (recent.size() > keep)
+            recent.pop_front();
+        return chosen;
+    }
+
+private:
+    std::map<std::string, std::deque<std::size_t>> history;
+};
+}
+
+#endif
