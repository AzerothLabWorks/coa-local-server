@@ -0,0 +1,396 @@
+CLI_DESCRIPTION = "Generate an owner-zero-only CoA rotation migration from pinned vendor SQL without a database."
+
+import argparse
+from dataclasses import dataclass
+import hashlib
+import json
+from pathlib import Path
+import re
+import sys
+
+
+ROOT = Path(__file__).resolve().parents[3]
+VENDOR = ROOT / "modules/mod-playerbots/data/sql/playerbots/custom"
+MIGRATION = ROOT / "data/sql/updates/pending_db_playerbots/rev_20261004_00_coa_rotations.sql"
+PINNED_COMMIT = "36c4b93ae0688c19e6baa718f296302071ae30b3"
+VENDOR_SHA256 = {
+    "playerbots_coa_rotations.sql": "7dbfab473f2b810f9e29ce6290ace289a087b14a8997a450053514e458124bf2",
+    "zz_coa_rotation_corrections.sql": "737c1da35e69414e5159f53e4b4fd77b282bb4f613b0edd836ff1a0194696fc2",
+    "zz_coa_rotation_corrections_1_7.sql": "2f26d0a9a158658384204347a70d6188b5d973bbdd8e764afc95b000140a1c21",
+}
+EXPECTED_BASE_ROWS = 2544
+EXPECTED_NAMES = 71
+EXPECTED_FINAL_ROWS = 2520
+EXPECTED_FINAL_SHA256 = "b96b87e06695dbab0e096a406558c3e7bde34b11e52470f29fcd5984a657e0af"
+EXPECTED_KEYS_SHA256 = "6dc810d8493cf020fa9d0f43d9967b1e003e689efeccb8fb78a783cee6913fdb"
+TOKEN = re.compile(
+    r"(?P<space>\s+)|(?P<comment>--[^\n]*)|(?P<string>'(?:''|[^'])*')|"
+    r"(?P<identifier>`[^`]+`)|(?P<number>\d+)|(?P<word>[A-Za-z_][A-Za-z_0-9]*)|"
+    r"(?P<symbol>[(),;=*])"
+)
+ROW_COLUMNS = ("name", "idx", "owner", "action_line")
+
+
+@dataclass(frozen=True, order=True)
+class Row:
+    name: str
+    idx: int
+    owner: int
+    action_line: str
+
+    def key(self):
+        return self.name, self.idx, self.owner
+
+    def fields(self):
+        return dict(zip(ROW_COLUMNS, (self.name, self.idx, self.owner, self.action_line)))
+
+
+def tokens(text):
+    result = []
+    position = 0
+    while position < len(text):
+        match = TOKEN.match(text, position)
+        if not match:
+            raise ValueError(f"Unsupported SQL token at offset {position}: {text[position:position + 50]!r}")
+        position = match.end()
+        kind, value = match.lastgroup, match.group()
+        if kind in ("space", "comment"):
+            continue
+        if kind == "string":
+            value = value[1:-1].replace("''", "'")
+            if "\\" in value:
+                raise ValueError("Backslash-escaped SQL literals are outside the pinned grammar")
+        elif kind == "identifier":
+            kind, value = "word", value[1:-1].lower()
+        elif kind == "word":
+            value = value.lower()
+        elif kind == "number":
+            value = int(value)
+        result.append((kind, value))
+    return result
+
+
+def sql_equal(left, right):
+    if isinstance(left, str) and isinstance(right, str):
+        return left.casefold() == right.casefold()
+    return left == right
+
+
+def function(name, arguments):
+    if name == "replace" and len(arguments) == 3:
+        return arguments[0].replace(arguments[1], arguments[2])
+    if name == "concat":
+        return "".join(str(value) for value in arguments)
+    if name == "substring_index" and len(arguments) == 3:
+        text, delimiter, count = arguments
+        if count <= 0:
+            raise ValueError("Only positive SUBSTRING_INDEX counts are in the pinned grammar")
+        return delimiter.join(text.split(delimiter)[:count])
+    raise ValueError(f"Unsupported SQL function: {name}/{len(arguments)}")
+
+
+class Interpreter:
+    def __init__(self, text, rows=(), allow_vendor_backup=False):
+        self.tokens = tokens(text)
+        self.position = 0
+        rows = list(rows)
+        self.rows = {row.key(): row for row in rows}
+        if len(self.rows) != len(rows):
+            raise ValueError("Duplicate input (name, idx, owner)")
+        self.allow_vendor_backup = allow_vendor_backup
+        self.statements = []
+
+    def peek(self, value=None):
+        token = self.tokens[self.position] if self.position < len(self.tokens) else ("end", None)
+        return token[1] == value if value is not None else token
+
+    def take(self, value=None):
+        token = self.peek()
+        if token[0] == "end" or (value is not None and token[1] != value):
+            raise ValueError(f"Expected {value!r}, found {token!r} at token {self.position}")
+        self.position += 1
+        return token[1]
+
+    def accept(self, value):
+        if self.peek(value):
+            self.take()
+            return True
+        return False
+
+    def value(self):
+        kind, value = self.peek()
+        if kind in ("string", "number"):
+            self.take()
+            return lambda row, literal=value: literal
+        if kind != "word":
+            raise ValueError(f"Unsupported SQL value: {(kind, value)!r}")
+        self.take()
+        if self.accept("("):
+            arguments = self.values()
+            self.take(")")
+            return lambda row, name=value, args=arguments: function(name, [argument(row) for argument in args])
+        return lambda row, column=value: row[column]
+
+    def values(self):
+        values = [self.value()]
+        while self.accept(","):
+            values.append(self.value())
+        return values
+
+    def condition(self):
+        left = self.conjunction()
+        while self.accept("or"):
+            right = self.conjunction()
+            left = lambda row, first=left, second=right: first(row) or second(row)
+        return left
+
+    def conjunction(self):
+        left = self.comparison()
+        while self.accept("and"):
+            right = self.comparison()
+            left = lambda row, first=left, second=right: first(row) and second(row)
+        return left
+
+    def comparison(self):
+        if self.accept("("):
+            condition = self.condition()
+            self.take(")")
+            return condition
+        left = self.value()
+        if self.accept("="):
+            right = self.value()
+            return lambda row: sql_equal(left(row), right(row))
+        if self.accept("between"):
+            lower = self.value()
+            self.take("and")
+            upper = self.value()
+            return lambda row: lower(row) <= left(row) <= upper(row)
+        negative = self.accept("not")
+        if self.accept("in"):
+            self.take("(")
+            choices = self.values()
+            self.take(")")
+            return lambda row: any(sql_equal(left(row), choice(row)) for choice in choices) != negative
+        if negative:
+            raise ValueError("Only NOT IN is in the pinned grammar")
+        if self.accept("like"):
+            right = self.value()
+            return lambda row: re.fullmatch(
+                re.escape(right(row)).replace("%", ".*").replace("_", "."), left(row), re.IGNORECASE
+            ) is not None
+        if self.accept("regexp"):
+            right = self.value()
+            return lambda row: re.search(right(row), left(row), re.IGNORECASE) is not None
+        raise ValueError(f"Unsupported SQL comparison at token {self.position}")
+
+    def insert(self):
+        self.take("into")
+        self.take("playerbots_custom_strategy")
+        self.take("(")
+        columns = [self.take()]
+        while self.accept(","):
+            columns.append(self.take())
+        self.take(")")
+        if set(columns) != set(ROW_COLUMNS) or len(columns) != 4:
+            raise ValueError(f"Unsupported insertion columns: {columns}")
+        if self.accept("values"):
+            inserted = []
+            while True:
+                self.take("(")
+                values = self.values()
+                self.take(")")
+                inserted.append([value({}) for value in values])
+                if not self.accept(","):
+                    break
+        else:
+            self.take("select")
+            selection = self.values()
+            self.take("from")
+            self.take("(")
+            derived = []
+            aliases = []
+            while True:
+                self.take("select")
+                values = []
+                while True:
+                    values.append(self.value()({}))
+                    if self.accept("as"):
+                        alias = self.take()
+                        if len(derived) == 0:
+                            aliases.append(alias)
+                    if not self.accept(","):
+                        break
+                derived.append(values)
+                if not self.accept("union"):
+                    break
+                self.take("all")
+            self.take(")")
+            self.take("as")
+            self.take("rota")
+            inserted = [[value(dict(zip(aliases, values))) for value in selection] for values in derived]
+        for values in inserted:
+            if len(values) != 4:
+                raise ValueError("Insertion value count does not match its columns")
+            row = Row(**dict(zip(columns, values)))
+            if not isinstance(row.idx, int) or not isinstance(row.owner, int):
+                raise ValueError("Rotation index and owner must be integers")
+            if row.key() in self.rows:
+                raise ValueError(f"Duplicate rotation key {row.key()}")
+            self.rows[row.key()] = row
+
+    def update(self):
+        self.take("playerbots_custom_strategy")
+        self.take("set")
+        self.take("action_line")
+        self.take("=")
+        replacement = self.value()
+        self.take("where")
+        condition = self.condition()
+        for key, row in list(self.rows.items()):
+            if condition(row.fields()):
+                self.rows[key] = Row(row.name, row.idx, row.owner, replacement(row.fields()))
+
+    def delete(self):
+        self.take("from")
+        self.take("playerbots_custom_strategy")
+        self.take("where")
+        condition = self.condition()
+        self.rows = {key: row for key, row in self.rows.items() if not condition(row.fields())}
+
+    def skip_vendor_backup(self):
+        expected = ["table", "if", "not", "exists", "playerbots_custom_strategy_bak_v17", "as", "select", "*",
+                    "from", "playerbots_custom_strategy", "where", "name", "in"]
+        if not self.allow_vendor_backup:
+            raise ValueError("DDL is forbidden in a rotation replacement")
+        for value in expected:
+            self.take(value)
+        self.take("(")
+        names = [value({}) for value in self.values()]
+        self.take(")")
+        if len(names) != 11 or not all(isinstance(name, str) for name in names):
+            raise ValueError("Unexpected vendor backup selection")
+
+    def apply(self):
+        while self.peek()[0] != "end":
+            command = self.take()
+            self.statements.append(command)
+            if command == "insert":
+                self.insert()
+            elif command == "update":
+                self.update()
+            elif command == "delete":
+                self.delete()
+            elif command == "start":
+                self.take("transaction")
+            elif command == "commit":
+                pass
+            elif command == "create":
+                self.skip_vendor_backup()
+            else:
+                raise ValueError(f"Unsupported SQL statement: {command}")
+            self.take(";")
+        return sorted(self.rows.values())
+
+
+def canonical_rows(rows):
+    values = [[row.name, row.idx, row.owner, row.action_line] for row in sorted(rows)]
+    return (json.dumps(values, ensure_ascii=False, separators=(",", ":")) + "\n").encode("utf-8")
+
+
+def row_hash(rows):
+    return hashlib.sha256(canonical_rows(rows)).hexdigest()
+
+
+def key_hash(rows):
+    keys = [list(row.key()) for row in sorted(rows)]
+    encoded = (json.dumps(keys, separators=(",", ":")) + "\n").encode("utf-8")
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def load_vendor(directory=VENDOR):
+    rows, base = [], []
+    for index, (name, expected) in enumerate(VENDOR_SHA256.items()):
+        content = (directory / name).read_bytes()
+        actual = hashlib.sha256(content).hexdigest()
+        if actual != expected:
+            raise ValueError(f"Pinned vendor hash mismatch: {name}: {actual}")
+        rows = Interpreter(content.decode("utf-8"), rows, allow_vendor_backup=True).apply()
+        if index == 0:
+            base = list(rows)
+    return base, rows
+
+
+def sql_string(value):
+    return "'" + value.replace("'", "''") + "'"
+
+
+def action_sql(value):
+    if len(sql_string(value)) <= 110:
+        return ["        " + sql_string(value)]
+    pieces, pending = [], value
+    while pending:
+        length = min(92, len(pending))
+        while len(sql_string(pending[:length])) > 104:
+            length -= 1
+        pieces.append(pending[:length])
+        pending = pending[length:]
+    return ["        CONCAT("] + ["            " + sql_string(piece) + ("," if index + 1 < len(pieces) else "")
+                                 for index, piece in enumerate(pieces)] + ["        )"]
+
+
+def render(rows):
+    if not rows or any(row.owner != 0 for row in rows):
+        raise ValueError("Only nonempty owner-zero vendor rules may be rendered")
+    names = sorted({row.name for row in rows})
+    lines = [
+        "-- CoA rotation rules derived from Zyth45/mod-playerbots at " + PINNED_COMMIT + ".",
+        "-- Vendor guide data credits ascensionsidekick.com; module code is GNU GPL v2 or later.",
+        "-- Generated by apps/coa-tests/g1_rotation_import/generate.py; vendor SQL is not replayed.",
+        f"-- {len(names)} names; {len(rows)} rules.",
+        f"-- Canonical owner-zero SHA-256: {row_hash(rows)}.",
+        "START TRANSACTION;", "", "DELETE FROM `playerbots_custom_strategy`",
+        "WHERE `owner` = 0 AND `name` IN (",
+    ]
+    lines.extend("    " + sql_string(name) + ("," if index + 1 < len(names) else "")
+                 for index, name in enumerate(names))
+    lines.extend([");", "", "INSERT INTO `playerbots_custom_strategy` (`name`, `idx`, `owner`, `action_line`) VALUES"])
+    for index, row in enumerate(sorted(rows)):
+        lines.append(f"    ({sql_string(row.name)}, {row.idx}, 0,")
+        action = action_sql(row.action_line)
+        action[-1] += ")" + ("," if index + 1 < len(rows) else ";")
+        lines.extend(action)
+    lines.extend(["", "COMMIT;", ""])
+    return "\n".join(lines)
+
+
+def audit(base, final):
+    base_map = {row.key(): row.action_line for row in base}
+    final_map = {row.key(): row.action_line for row in final}
+    return {
+        "pinned_commit": PINNED_COMMIT,
+        "vendor_sha256": VENDOR_SHA256,
+        "base_rules": len(base),
+        "final_rules": len(final),
+        "strategy_names": len({row.name for row in final}),
+        "final_sha256": row_hash(final),
+        "keys_sha256": key_hash(final),
+        "inserted_keys": len(final_map.keys() - base_map.keys()),
+        "removed_keys": len(base_map.keys() - final_map.keys()),
+        "changed_rules": sum(base_map[key] != final_map[key] for key in base_map.keys() & final_map.keys()),
+    }
+
+
+def main():
+    parser = argparse.ArgumentParser(description=CLI_DESCRIPTION)
+    parser.add_argument("--vendor-directory", type=Path, default=VENDOR)
+    parser.add_argument("--emit", action="store_true")
+    args = parser.parse_args()
+    base, final = load_vendor(args.vendor_directory)
+    if args.emit:
+        sys.stdout.write(render(final))
+    else:
+        print(json.dumps(audit(base, final), indent=2))
+
+
+if __name__ == "__main__":
+    main()
