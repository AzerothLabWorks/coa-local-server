@@ -0,0 +1,254 @@
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cassert>
+#include <cstdint>
+#include <cstdio>
+#include <initializer_list>
+#include <limits>
+#include <map>
+#include <string>
+#include <utility>
+
+using uint32 = std::uint32_t;
+using int32 = std::int32_t;
+
+constexpr uint32 SKILL_FIRST_AID = 129;
+constexpr uint32 SKILL_BLACKSMITHING = 164;
+constexpr uint32 SKILL_LEATHERWORKING = 165;
+constexpr uint32 SKILL_ALCHEMY = 171;
+constexpr uint32 SKILL_COOKING = 185;
+constexpr uint32 SKILL_MINING = 186;
+constexpr uint32 SKILL_TAILORING = 197;
+constexpr uint32 SKILL_ENGINEERING = 202;
+constexpr uint32 SKILL_ENCHANTING = 333;
+constexpr uint32 SKILL_SKINNING = 393;
+constexpr uint32 SKILL_JEWELCRAFTING = 755;
+constexpr uint32 SKILL_INSCRIPTION = 773;
+constexpr uint32 SPELL_EFFECT_CREATE_ITEM = 24;
+constexpr uint32 SPELL_EFFECT_OPEN_LOCK = 33;
+constexpr uint32 SPELL_EFFECT_SKILL_STEP = 44;
+constexpr uint32 SPELL_EFFECT_LEARN_SPELL = 36;
+constexpr uint32 SPELL_EFFECT_ENCHANT_ITEM = 53;
+constexpr uint32 SPELL_EFFECT_ENCHANT_ITEM_TEMPORARY = 54;
+constexpr uint32 SPELL_EFFECT_CREATE_RANDOM_ITEM = 59;
+constexpr uint32 SPELL_EFFECT_SKINNING = 95;
+constexpr uint32 SPELL_EFFECT_SKILL = 118;
+constexpr uint32 SPELL_EFFECT_ENCHANT_ITEM_PRISMATIC = 156;
+constexpr uint32 SPELL_EFFECT_CREATE_ITEM_2 = 157;
+constexpr int32 LOCKTYPE_MINING = 3;
+constexpr uint32 WORLDHOOK_ON_AFTER_CONFIG_LOAD = 1;
+
+struct Unit
+{
+    bool player = true;
+    bool IsPlayer() const { return player; }
+};
+
+struct ObjectGuid
+{
+    uint32 value = 0;
+    bool IsEmpty() const { return value == 0; }
+    explicit operator bool() const { return value != 0; }
+};
+
+struct Spell
+{
+    bool triggered = false;
+    void* m_CastItem = nullptr;
+    ObjectGuid m_castItemGUID;
+    bool IsTriggered() const { return triggered; }
+};
+
+struct SpellEffectInfo
+{
+    uint32 Effect = 0;
+    int32 MiscValue = 0;
+};
+
+struct SpellInfo
+{
+    uint32 Id = 0;
+    bool channeled = false;
+    std::array<SpellEffectInfo, 3> Effects{};
+    bool IsChanneled() const { return channeled; }
+    bool HasEffect(uint32 effect) const
+    {
+        return std::any_of(Effects.begin(), Effects.end(), [effect](SpellEffectInfo const& entry)
+        {
+            return entry.Effect == effect;
+        });
+    }
+};
+
+struct SkillLineAbilityEntry
+{
+    uint32 SkillLine;
+};
+
+struct SpellMgr
+{
+    std::map<std::pair<uint32, uint32>, SkillLineAbilityEntry> entries;
+    std::multimap<uint32, SkillLineAbilityEntry const*> abilities;
+    auto GetSkillLineAbilityMapBounds(uint32 spell) const { return abilities.equal_range(spell); }
+    void Add(uint32 spell, uint32 skill)
+    {
+        auto const result = entries.emplace(std::make_pair(spell, skill), SkillLineAbilityEntry{ skill });
+        if (result.second)
+            abilities.emplace(spell, &result.first->second);
+    }
+} spellManager;
+
+auto sSpellMgr = &spellManager;
+
+struct ConfigManager
+{
+    int32 configured = 0;
+    uint32 reads = 0;
+    template<class T>
+    T GetOption(char const* key, T fallback)
+    {
+        assert(std::string(key) == "CoA.ProfessionCastTimeCapMs");
+        assert(fallback == 0);
+        ++reads;
+        return T(configured);
+    }
+} configuration;
+
+auto sConfigMgr = &configuration;
+
+class WorldScript
+{
+public:
+    WorldScript(char const*, std::initializer_list<uint32>) { }
+    virtual ~WorldScript() = default;
+    virtual void OnAfterConfigLoad(bool) { }
+};
+
+#include "Production.h"
+
+SpellInfo Ability(uint32 id, uint32 skill, uint32 effect)
+{
+    SpellInfo info;
+    info.Id = id;
+    info.Effects[0].Effect = effect;
+    spellManager.Add(id, skill);
+    return info;
+}
+
+int main()
+{
+    using AscensionProfessionCastTime::IsEligible;
+    using AscensionProfessionCastTime::LimitCastTime;
+    AscensionProfessionCastTime::Configuration reload;
+    Unit player;
+    Unit creature;
+    creature.player = false;
+    Spell direct;
+    SpellInfo goggles = Ability(3934, SKILL_ENGINEERING, SPELL_EFFECT_CREATE_ITEM);
+
+    reload.OnAfterConfigLoad(false);
+    assert(LimitCastTime(&player, &goggles, &direct, 12500) == 12500);
+    configuration.configured = 2000;
+    assert(LimitCastTime(&player, &goggles, &direct, 12500) == 12500);
+    reload.OnAfterConfigLoad(true);
+    uint32 const reads = configuration.reads;
+    assert(LimitCastTime(&player, &goggles, &direct, 12500) == 2000);
+    assert(LimitCastTime(&player, &goggles, &direct, 50000) == 2000);
+    assert(LimitCastTime(&player, &goggles, &direct, 2000) == 2000);
+    assert(LimitCastTime(&player, &goggles, &direct, 1500) == 1500);
+    assert(LimitCastTime(&player, &goggles, &direct, 1000) == 1000);
+    assert(LimitCastTime(&player, &goggles, &direct, 500) == 500);
+    assert(LimitCastTime(&player, &goggles, &direct, 0) == 0);
+    assert(LimitCastTime(&player, &goggles, &direct, std::numeric_limits<uint32>::max()) == 2000);
+    assert(LimitCastTime(&creature, &goggles, &direct, 12500) == 12500);
+    assert(LimitCastTime(nullptr, &goggles, &direct, 12500) == 12500);
+    assert(LimitCastTime(&player, nullptr, &direct, 12500) == 12500);
+    assert(LimitCastTime(&player, &goggles, nullptr, 12500) == 12500);
+    direct.triggered = true;
+    assert(LimitCastTime(&player, &goggles, &direct, 12500) == 12500);
+    direct.triggered = false;
+    direct.m_CastItem = &player;
+    assert(LimitCastTime(&player, &goggles, &direct, 12500) == 12500);
+    direct.m_CastItem = nullptr;
+    direct.m_castItemGUID.value = 1;
+    assert(LimitCastTime(&player, &goggles, &direct, 12500) == 12500);
+    direct.m_castItemGUID.value = 0;
+
+    uint32 next = 4000000;
+    for (uint32 skill : {129u, 164u, 165u, 171u, 185u, 186u, 197u, 202u, 333u, 755u, 773u})
+        for (uint32 effect : {24u, 53u, 54u, 59u, 156u, 157u})
+        {
+            SpellInfo recipe = Ability(++next, skill, effect);
+            assert(IsEligible(&recipe));
+            assert(LimitCastTime(&player, &recipe, &direct, 45000) == 2000);
+        }
+
+    SpellInfo sanguine = Ability(968775, SKILL_LEATHERWORKING, SPELL_EFFECT_CREATE_ITEM);
+    assert(IsEligible(&sanguine));
+    assert(LimitCastTime(&player, &sanguine, &direct, 45000) == 2000);
+    SpellInfo mining = Ability(2575, SKILL_MINING, SPELL_EFFECT_OPEN_LOCK);
+    mining.Effects[0].MiscValue = LOCKTYPE_MINING;
+    mining.Effects[1] = { SPELL_EFFECT_SKILL, SKILL_MINING };
+    assert(IsEligible(&mining));
+    assert(LimitCastTime(&player, &mining, &direct, 3000) == 2000);
+    mining.Effects[0].MiscValue = 2;
+    assert(!IsEligible(&mining));
+    mining.Effects[0].MiscValue = 1;
+    assert(!IsEligible(&mining));
+    SpellInfo skinning = Ability(8613, SKILL_SKINNING, SPELL_EFFECT_SKINNING);
+    skinning.Effects[1] = { SPELL_EFFECT_SKILL, SKILL_SKINNING };
+    assert(IsEligible(&skinning));
+    assert(LimitCastTime(&player, &skinning, &direct, 1500) == 1500);
+    assert(LimitCastTime(&player, &skinning, &direct, 3000) == 2000);
+    SpellInfo mechanical = Ability(32606, SKILL_MINING, SPELL_EFFECT_SKINNING);
+    assert(IsEligible(&mechanical));
+    assert(LimitCastTime(&player, &mechanical, &direct, 1600) == 1600);
+
+    for (uint32 skill : {50u, 182u, 356u, 505u, 536u, 806u})
+    {
+        SpellInfo other = Ability(++next, skill, SPELL_EFFECT_CREATE_ITEM);
+        assert(!IsEligible(&other));
+        assert(LimitCastTime(&player, &other, &direct, 3000) == 3000);
+    }
+    SpellInfo herbs = Ability(2366, 182, SPELL_EFFECT_OPEN_LOCK);
+    herbs.Effects[0].MiscValue = 2;
+    herbs.Effects[1] = { SPELL_EFFECT_SKILL, 182 };
+    assert(!IsEligible(&herbs));
+    SpellInfo fishing = Ability(7620, 356, 50);
+    fishing.channeled = true;
+    fishing.Effects[1] = { SPELL_EFFECT_SKILL, 356 };
+    assert(!IsEligible(&fishing));
+    assert(LimitCastTime(&player, &fishing, &direct, 20000) == 20000);
+    goggles.channeled = true;
+    assert(!IsEligible(&goggles));
+    assert(LimitCastTime(&player, &goggles, &direct, 12500) == 12500);
+    goggles.channeled = false;
+
+    for (uint32 effect : {2u, 6u, 10u, 33u, 36u, 44u, 95u, 118u})
+    {
+        SpellInfo nonRecipe = Ability(++next, SKILL_ENGINEERING, effect);
+        assert(!IsEligible(&nonRecipe));
+        assert(LimitCastTime(&player, &nonRecipe, &direct, 3000) == 3000);
+    }
+    SpellInfo conjure;
+    conjure.Id = 587;
+    conjure.Effects[0].Effect = SPELL_EFFECT_CREATE_ITEM;
+    assert(!IsEligible(&conjure));
+    assert(LimitCastTime(&player, &conjure, &direct, 3000) == 3000);
+    for (uint32 effect : {36u, 44u})
+    {
+        SpellInfo learning = Ability(++next, SKILL_ENGINEERING, SPELL_EFFECT_CREATE_ITEM);
+        learning.Effects[1].Effect = effect;
+        assert(!IsEligible(&learning));
+    }
+    assert(configuration.reads == reads);
+    configuration.configured = -1;
+    reload.OnAfterConfigLoad(true);
+    assert(LimitCastTime(&player, &goggles, &direct, 12500) == 12500);
+    configuration.configured = 0;
+    reload.OnAfterConfigLoad(true);
+    assert(LimitCastTime(&player, &goggles, &direct, 12500) == 12500);
+    std::puts("PASS: actual profession cast policy clamps slow crafting and mining, preserves fast casts "
+        "and excludes channels, item uses, triggered spells and unrelated skills");
+}
