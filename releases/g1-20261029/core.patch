+std::string LfgStatusSnapshot(Player* player, std::string_view nonce)
+{
+    std::string const unavailable = Acore::StringFormat("N|1|{}", nonce);
+    Map const* map = player->FindMap();
+    Group const* group = player->GetGroup();
+    if (!player->IsInWorld() || !map || !map->IsDungeon() || map->IsRaid() || !map->GetInstanceId()
+        || !group || !group->isLFGGroup() || !group->IsMember(player->GetGUID()))
+        return unavailable;
+
+    uint32 const dungeonId = sLFGMgr->GetDungeon(group->GetGUID());
+    lfg::LFGDungeonData const* dungeon = sLFGMgr->GetLFGDungeon(dungeonId);
+    if (!dungeon || dungeon->expansion > 2 || dungeon->difficulty > DUNGEON_DIFFICULTY_HEROIC
+        || (dungeon->type != lfg::LFG_TYPE_DUNGEON && dungeon->type != lfg::LFG_TYPE_HEROIC)
+        || dungeon->map != map->GetId() || dungeon->difficulty != map->GetDifficulty())
+        return unavailable;
+
+    DungeonEncounterList const* encounters = sObjectMgr->GetDungeonEncounterList(map->GetId(), map->GetDifficulty());
+    DungeonEncounter const* finalEncounter = nullptr;
+    if (encounters)
+        for (DungeonEncounter const* encounter : *encounters)
+            if (encounter && encounter->dbcEntry && encounter->lastEncounterDungeon == dungeonId)
+            {
+                if (finalEncounter)
+                    return unavailable;
+                finalEncounter = encounter;
+            }
+
+    if (!finalEncounter)
+        return unavailable;
+
+    InstanceScript const* instance = map->ToInstanceMap()->GetInstanceScript();
+    if (!instance || finalEncounter->dbcEntry->encounterIndex >= 32)
+        return unavailable;
+    bool const completed = sLFGMgr->GetState(group->GetGUID()) == lfg::LFG_STATE_FINISHED_DUNGEON
+        && (instance->GetCompletedEncounterMask() & (uint32(1) << finalEncounter->dbcEntry->encounterIndex));
+
+    return Acore::StringFormat("S|1|{}|{}|{}|{}|{}|{}|{}|{}|{}|{}", nonce, map->GetId(),
+        uint32(map->GetDifficulty()), map->GetInstanceId(), group->GetGUID().GetRawValue(), dungeonId,
+        finalEncounter->dbcEntry->id, uint32(finalEncounter->creditType), finalEncounter->creditEntry,
+        uint32(completed));
+}
 
