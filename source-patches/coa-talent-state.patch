+        // not proof of a purchase: progression and older grants may share it.
+        if (rank && freeChoiceGroup)
+            for (auto const& other : AscensionCompatData::CoATalentEntries)
+                if (other.ClassId == entry.ClassId && other.SpecId == entry.SpecId &&
+                    other.EntryId != entry.EntryId && GetSelectableFreeGroup(other.EntryId) == freeChoiceGroup &&
+                    GetRecordedTalentRank(player, other.EntryId))
+                    player->UpdatePlayerSetting(
+                        std::string(ASCENSION_TALENT_SETTING_PREFIX) + std::to_string(other.EntryId), 0, 0);
+
+        player->UpdatePlayerSetting(
+            std::string(ASCENSION_TALENT_SETTING_PREFIX) + std::to_string(entry.EntryId), 0, rank);
+        if (entry.SpecId)
+            player->UpdatePlayerSetting(ASCENSION_TALENT_RECORDS_SETTING, 1, entry.SpecId);
+        else
+            player->UpdatePlayerSetting(ASCENSION_TALENT_RECORDS_SETTING, 0, 1);
+    }
