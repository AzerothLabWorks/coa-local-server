index 0000000000000000000000000000000000000000..bb4906ef2c27e140047509f1e9e57c1a5e8a9fa4
--- /dev/null
+++ b/apps/coa-tests/g1_artisans_catalog/run.py
@@ -0,0 +1,102 @@
+from pathlib import Path
+import re
+import sqlite3
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[3]
+MIGRATION = ROOT / 'data/sql/updates/pending_db_world/rev_1792866104643742047.sql'
+UPSTREAM = ROOT / 'modules/mod-book-of-artisans/data/sql/db-world/book_of_artisans.sql'
+ADDED = [
+    (200001, 54083, 0, 356, 125, 7731, 0, 0, 10, None),
+    (200001, 54084, 0, 356, 275, 18248, 0, 0, 10, None),
+    (200001, 54254, 0, 129, 125, 3274, 0, 0, 0, None),
+    (200001, 54255, 0, 129, 275, 10846, 0, 0, 0, None),
+    (200001, 54256, 0, 185, 275, 18260, 0, 0, 0, None),
+    (200001, 54257, 0, 185, 125, 3102, 0, 0, 0, None),
+    (200001, 61464, 0, 202, 350, 30350, 0, 0, 65, None),
+]
+LEGACY = [
+    (200001, 2020, 0, 0, 0, 0, 0, 0, 0, 0),
+    (200001, 2387, 0, 197, 0, 0, 0, 0, 0, 0),
+    (200001, 3912, 0, 197, 50, 0, 0, 0, 0, 0),
+    (200001, 4039, 0, 0, 0, 0, 0, 0, 0, 0),
+    (200001, 94713, 0, 197, 0, 0, 0, 0, 0, 0),
+    (200002, 3911, 0, 0, 0, 0, 0, 0, 0, 0),
+    (98765, 61464, 1000, 202, 350, 30350, 0, 0, 65, 12340),
+]
+
+
+class ArtisansCatalog(unittest.TestCase):
+    def setUp(self):
+        self.db = sqlite3.connect(':memory:')
+        self.addCleanup(self.db.close)
+        self.db.executescript(
+            'CREATE TABLE trainer_spell ('
+            'TrainerId INTEGER, SpellId INTEGER, MoneyCost INTEGER, ReqSkillLine INTEGER, ReqSkillRank INTEGER, '
+            'ReqAbility1 INTEGER, ReqAbility2 INTEGER, ReqAbility3 INTEGER, ReqLevel INTEGER, VerifiedBuild INTEGER, '
+            'PRIMARY KEY (TrainerId, SpellId));'
+            'CREATE TABLE character_spell (guid INTEGER, spell INTEGER, active INTEGER);'
+            'CREATE TABLE character_skills (guid INTEGER, skill INTEGER, value INTEGER, maximum INTEGER);'
+            'INSERT INTO character_spell VALUES (42,2387,1),(42,51306,1);'
+            'INSERT INTO character_skills VALUES (42,197,76,150),(42,202,390,450);')
+        self.db.executemany('INSERT INTO trainer_spell VALUES (?,?,?,?,?,?,?,?,?,?)', LEGACY)
+
+    def rows(self):
+        return self.db.execute('SELECT * FROM trainer_spell ORDER BY TrainerId,SpellId').fetchall()
+
+    def characters(self):
+        return {table: self.db.execute('SELECT * FROM ' + table + ' ORDER BY guid').fetchall()
+                for table in ('character_spell', 'character_skills')}
+
+    def migrate(self):
+        self.db.executescript(MIGRATION.read_text(encoding='utf-8'))
+
+    def test_exactly_seven_missing_ranks_added_without_catalog_or_character_changes(self):
+        before, characters = self.rows(), self.characters()
+        self.migrate()
+        self.assertEqual(self.rows(), sorted(before + ADDED))
+        self.assertEqual(self.characters(), characters)
+
+    def test_reapplication_is_identical(self):
+        self.migrate()
+        before = self.rows()
+        self.migrate()
+        self.assertEqual(self.rows(), before)
+
+    def test_custom_existing_rank_is_preserved(self):
+        custom = (200001, 61464, 123, 202, 400, 30350, 7, 8, 70, 12340)
+        self.db.execute('INSERT INTO trainer_spell VALUES (?,?,?,?,?,?,?,?,?,?)', custom)
+        before = self.rows()
+        self.migrate()
+        self.migrate()
+        self.assertEqual(self.rows(), sorted(before + ADDED[:-1]))
+
+    def test_partial_install_keeps_all_existing_rows(self):
+        self.db.executemany('INSERT INTO trainer_spell VALUES (?,?,?,?,?,?,?,?,?,?)', ADDED[:3])
+        self.migrate()
+        self.assertEqual(self.rows(), sorted(LEGACY + ADDED))
+
+    def test_existing_verified_metadata_is_preserved(self):
+        verified = (*ADDED[0][:-1], 12340)
+        self.db.execute('INSERT INTO trainer_spell VALUES (?,?,?,?,?,?,?,?,?,?)', verified)
+        self.migrate()
+        self.assertEqual(self.rows(), sorted(LEGACY + [verified] + ADDED[1:]))
+
+    def test_rank_metadata_matches_upstream_canonical_rows(self):
+        blocks = re.findall(r'INSERT INTO `trainer_spell`\s*\([^;]+?\)\s*VALUES\s*(.*?);',
+                            UPSTREAM.read_text(encoding='utf-8'), re.DOTALL)
+        self.assertEqual(len(blocks), 1)
+        upstream = {}
+        for body in re.findall(r'\(([^()]*)\)', blocks[0]):
+            fields = tuple(None if value.strip() == 'NULL' else int(value.strip()) for value in body.split(','))
+            self.assertEqual(len(fields), 10)
+            self.assertEqual(fields[0], 200001)
+            self.assertNotIn(fields[1], upstream)
+            upstream[fields[1]] = fields
+        for row in ADDED:
+            self.assertEqual(row, upstream[row[1]])
+
+
+if __name__ == '__main__':
+    unittest.main()
