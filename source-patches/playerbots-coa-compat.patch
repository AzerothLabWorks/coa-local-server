@@ -0,0 +1,119 @@
+#include "CoaAiObjectContext.h"
+
+#include "Player.h"
+#include "PlayerbotAI.h"
+#include "Playerbots.h"
+#include "SpellInfo.h"
+#include "SpellMgr.h"
+
+#include <algorithm>
+
+namespace
+{
+bool IsDamageSpell(SpellInfo const* spell)
+{
+    if (!spell || spell->IsPassive() || spell->IsPositive())
+        return false;
+
+    for (SpellEffectInfo const& effect : spell->Effects)
+        switch (effect.Effect)
+        {
+            case SPELL_EFFECT_SCHOOL_DAMAGE:
+            case SPELL_EFFECT_WEAPON_DAMAGE:
+            case SPELL_EFFECT_WEAPON_DAMAGE_NOSCHOOL:
+            case SPELL_EFFECT_NORMALIZED_WEAPON_DMG:
+            case SPELL_EFFECT_WEAPON_PERCENT_DAMAGE:
+            case SPELL_EFFECT_HEALTH_LEECH:
+            case SPELL_EFFECT_POWER_DRAIN:
+                return true;
+            default:
+                break;
+        }
+
+    return false;
+}
+
+class CoaAttackAction final : public Action
+{
+public:
+    explicit CoaAttackAction(PlayerbotAI* ai) : Action(ai, "coa attack") {}
+
+    bool Execute(Event) override
+    {
+        Unit* target = AI_VALUE(Unit*, "current target");
+        if (!target || !target->IsAlive())
+            return false;
+
+        Player* bot = botAI->GetBot();
+        std::vector<SpellInfo const*> candidates;
+        for (auto const& [spellId, playerSpell] : bot->GetSpellMap())
+        {
+            if (!playerSpell->Active || playerSpell->State == PLAYERSPELL_REMOVED)
+                continue;
+            SpellInfo const* spell = sSpellMgr->GetSpellInfo(spellId);
+            if (IsDamageSpell(spell))
+                candidates.push_back(spell);
+        }
+
+        std::sort(candidates.begin(), candidates.end(), [](SpellInfo const* left, SpellInfo const* right)
+        {
+            if (left->SpellLevel != right->SpellLevel)
+                return left->SpellLevel > right->SpellLevel;
+            return left->Id > right->Id;
+        });
+
+        for (SpellInfo const* spell : candidates)
+            if (botAI->CanCastSpell(spell->Id, target) && botAI->CastSpell(spell->Id, target))
+                return true;
+
+        return false;
+    }
+
+    bool isUseful() override { return AI_VALUE(Unit*, "current target") != nullptr; }
+    ActionThreatType getThreatType() override { return ActionThreatType::Single; }
+};
+
+class CoaCombatStrategy final : public Strategy
+{
+public:
+    explicit CoaCombatStrategy(PlayerbotAI* ai) : Strategy(ai) {}
+    std::string const getName() override { return "coa"; }
+    uint32 GetType() const override { return STRATEGY_TYPE_COMBAT | STRATEGY_TYPE_DPS; }
+    std::vector<NextAction> getDefaultActions() override
+    {
+        return {NextAction("coa attack", ACTION_NORMAL), NextAction("melee", ACTION_DEFAULT)};
+    }
+};
+
+class CoaStrategyFactory final : public NamedObjectContext<Strategy>
+{
+public:
+    CoaStrategyFactory() { creators["coa"] = [](PlayerbotAI* ai) -> Strategy* { return new CoaCombatStrategy(ai); }; }
+};
+
+class CoaActionFactory final : public NamedObjectContext<Action>
+{
+public:
+    CoaActionFactory() { creators["coa attack"] = [](PlayerbotAI* ai) -> Action* { return new CoaAttackAction(ai); }; }
+};
+}
+
+SharedNamedObjectContextList<Strategy> CoaAiObjectContext::sharedStrategyContexts;
+SharedNamedObjectContextList<Action> CoaAiObjectContext::sharedActionContexts;
+SharedNamedObjectContextList<Trigger> CoaAiObjectContext::sharedTriggerContexts;
+SharedNamedObjectContextList<UntypedValue> CoaAiObjectContext::sharedValueContexts;
+
+CoaAiObjectContext::CoaAiObjectContext(PlayerbotAI* ai)
+    : AiObjectContext(ai, sharedStrategyContexts, sharedActionContexts, sharedTriggerContexts, sharedValueContexts)
+{
+}
+
+void CoaAiObjectContext::BuildSharedContexts()
+{
+    AiObjectContext::BuildSharedStrategyContexts(sharedStrategyContexts);
+    sharedStrategyContexts.Add(new CoaStrategyFactory());
+    AiObjectContext::BuildSharedActionContexts(sharedActionContexts);
+    sharedActionContexts.Add(new CoaActionFactory());
+    AiObjectContext::BuildSharedTriggerContexts(sharedTriggerContexts);
+    AiObjectContext::BuildSharedValueContexts(sharedValueContexts);
+}
