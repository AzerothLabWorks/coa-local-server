+        {
+            grid = std::make_unique<GridTerrainData>();
+            std::string const name = Acore::StringFormat("{:03}{:02}{:02}.map", point.map, x, y);
+            if (grid->Load((_path / "maps" / name).string()) != TerrainMapDataReadResult::Success)
+                throw std::runtime_error("cannot read native grid terrain: " + name);
+        }
+        return grid->getHeight(point.x, point.y);
+    }
+
+    float Collision(Point const& point, float queryZ, float distance)
+    {
+        auto const pos = VMAP::VMapMgr2::convertPositionToInternalRep(point.x, point.y, queryZ);
+        return Tree(point).getHeight(pos, distance);
+    }
+
+    void Floor(Point const& point, bool required)
+    {
+        float const ground = Ground(point);
+        float const floor = Collision(point, point.z + 2.0f, 12.0f);
+        float const top = Collision(point, 100000.0f, 200000.0f);
+        float const selected = point.interior ? floor : ground;
+        std::string const evidence = Acore::StringFormat(
+            "map={} xyz=({:.3f},{:.3f},{:.3f}) terrain={:.3f} z-aware-vmap={:.3f} top-vmap={:.3f} error={:.3f}",
+            point.map, point.x, point.y, point.z, ground, floor, top, selected - point.z);
+        if (required)
+            Check(std::isfinite(selected) && std::fabs(selected - point.z) <= 0.5f,
+                  std::string("floor: ") + point.name, evidence);
+        else
+            std::cout << "OBSERVATION: " << point.name << ' ' << evidence << '\n';
+    }
+
+    void Origin(Point const& point)
+    {
+        VMAP::ModelInstance* models = nullptr;
+        uint32 count = 0;
+        Tree(point).GetModelInstances(models, count);
+        float nearest = 100000.0f;
+        std::string name;
+        for (uint32 index = 0; index < count; ++index)
+        {
+            VMAP::ModelInstance const& model = models[index];
+            if (model.name.empty() || (model.flags & VMAP::MOD_M2))
+                continue;
+            auto const pos = VMAP::VMapMgr2::convertPositionToInternalRep(model.iPos.x, model.iPos.y, model.iPos.z);
+            float const distance = std::hypot(pos.x - point.x, pos.y - point.y);
+            if (distance < nearest)
+            {
+                nearest = distance;
+                name = Acore::StringFormat("model={} world-origin=({:.4f},{:.4f},{:.4f}) rotation=({},{},{})",
+                                          model.name, pos.x, pos.y, pos.z, model.iRot.x, model.iRot.y, model.iRot.z);
+            }
+        }
+        Check(nearest <= 0.03f, std::string("origin: ") + point.name,
+              Acore::StringFormat("expected=({:.4f},{:.4f}) error={:.4f} {}", point.x, point.y, nearest, name));
+    }
+
+    dtNavMeshQuery& Navigation(Point const& from, Point const& to)
+    {
+        auto& query = _queries[from.map];
+        auto& mesh = _meshes[from.map];
+        if (!mesh)
+        {
+            std::ifstream input(_path / "mmaps" / Acore::StringFormat("{:03}.mmap", from.map), std::ios::binary);
+            dtNavMeshParams params{};
+            if (!input.read(reinterpret_cast<char*>(&params), sizeof(params)))
+                throw std::runtime_error(Acore::StringFormat("cannot read MMAP parameters for map {}", from.map));
+            mesh.reset(dtAllocNavMesh());
+            if (!mesh || dtStatusFailed(mesh->init(&params)))
+                throw std::runtime_error("cannot initialize Detour mesh");
+        }
+        uint32 loaded = 0;
+        auto const [fromX, fromY] = Tile(from);
+        auto const [toX, toY] = Tile(to);
+        for (uint32 x = std::min(fromX, toX) - 1; x <= std::max(fromX, toX) + 1; ++x)
+        {
+            for (uint32 y = std::min(fromY, toY) - 1; y <= std::max(fromY, toY) + 1; ++y)
+            {
+                std::string const name = Acore::StringFormat("{:03}{:02}{:02}.mmtile", from.map, x, y);
+                auto const file = _path / "mmaps" / name;
+                if (!std::filesystem::exists(file) || !_navLoaded.insert({from.map, x, y}).second)
+                    continue;
+                std::ifstream tile(file, std::ios::binary);
+                MmapTileHeader header;
+                if (!tile.read(reinterpret_cast<char*>(&header), sizeof(header)) || header.mmapMagic != MMAP_MAGIC
+                    || header.mmapVersion != MMAP_VERSION || header.dtVersion != DT_NAVMESH_VERSION
+                    || header.size < sizeof(dtMeshHeader) || header.size > 128 * 1024 * 1024)
+                    throw std::runtime_error("invalid native MMAP header: " + name);
+                auto* data = static_cast<unsigned char*>(dtAlloc(header.size, DT_ALLOC_PERM));
+                if (!data)
+                    throw std::runtime_error("cannot allocate Detour tile");
+                if (!tile.read(reinterpret_cast<char*>(data), header.size)
+                    || dtStatusFailed(mesh->addTile(data, header.size, DT_TILE_FREE_DATA, 0, nullptr)))
+                {
+                    dtFree(data);
+                    throw std::runtime_error("cannot load Detour tile: " + name);
+                }
+                ++loaded;
+            }
+        }
+        if (!query)
+        {
+            query.reset(dtAllocNavMeshQuery());
+            if (!loaded || !query || dtStatusFailed(query->init(mesh.get(), 1024)))
+                throw std::runtime_error("cannot initialize populated Detour query");
+        }
+        std::cout << Acore::StringFormat("EVIDENCE: map {} added {} native navigation tiles\n", from.map, loaded);
+        return *query;
+    }
+
+    void Route(Point const& from, Point const& to, std::string const& name)
+    {
+        dtNavMeshQuery& query = Navigation(from, to);
+        dtQueryFilter filter;
+        filter.setIncludeFlags(NAV_GROUND);
+        float const extents[3] = {2.0f, 1.0f, 2.0f};
+        float const start[3] = {from.y, from.z, from.x};
+        float const end[3] = {to.y, to.z, to.x};
+        dtPolyRef startRef = 0;
+        dtPolyRef endRef = 0;
+        float nearestStart[3]{};
+        float nearestEnd[3]{};
+        dtStatus const a = query.findNearestPoly(start, extents, &filter, &startRef, nearestStart);
+        dtStatus const b = query.findNearestPoly(end, extents, &filter, &endRef, nearestEnd);
+        std::array<dtPolyRef, 1024> path{};
+        int count = 0;
+        dtStatus status = DT_FAILURE;
+        bool const references = dtStatusSucceed(a) && dtStatusSucceed(b) && startRef && endRef;
+        bool const endpoints = references
+            && std::fabs(nearestStart[1] - from.z) <= 1.0f && std::fabs(nearestEnd[1] - to.z) <= 1.0f
+            && std::hypot(nearestStart[0] - from.y, nearestStart[2] - from.x) <= 2.0f
+            && std::hypot(nearestEnd[0] - to.y, nearestEnd[2] - to.x) <= 2.0f;
+        if (references)
+            status = query.findPath(startRef, endRef, nearestStart, nearestEnd, &filter,
+                                    path.data(), &count, path.size());
+        bool const complete = references && dtStatusSucceed(status) && count && path[count - 1] == endRef
+            && !dtStatusDetail(status, DT_PARTIAL_RESULT) && !dtStatusDetail(status, DT_BUFFER_TOO_SMALL)
+            && !dtStatusDetail(status, DT_OUT_OF_NODES);
+        Check(endpoints, "route-endpoints: " + name,
+              Acore::StringFormat("map={} start-z-error={:.3f} end-z-error={:.3f} vertical-cap=1.000 horizontal-cap=2.000",
+                                  from.map, nearestStart[1] - from.z, nearestEnd[1] - to.z));
+        Check(complete, "route: " + name,
+              Acore::StringFormat("map={} start-z={:.3f}/{:.3f} end-z={:.3f}/{:.3f} polygons={} status={:#x}",
+                                  from.map, nearestStart[1], from.z, nearestEnd[1], to.z, count, status));
+    }
+
+private:
+    struct MeshDeleter
+    {
+        void operator()(dtNavMesh* mesh) const { dtFreeNavMesh(mesh); }
+    };
+
+    struct QueryDeleter
+    {
+        void operator()(dtNavMeshQuery* query) const { dtFreeNavMeshQuery(query); }
+    };
+
+    std::filesystem::path _path;
+    std::map<uint32, std::unique_ptr<VMAP::StaticMapTree>> _trees;
+    std::map<std::array<uint32, 3>, std::unique_ptr<GridTerrainData>> _grids;
+    std::set<std::array<uint32, 3>> _loaded;
+    std::set<std::array<uint32, 3>> _navLoaded;
+    std::map<uint32, std::unique_ptr<dtNavMesh, MeshDeleter>> _meshes;
+    std::map<uint32, std::unique_ptr<dtNavMeshQuery, QueryDeleter>> _queries;
+};
+}
+
+int main(int argc, char** argv)
+{
+    if (argc != 2)
+        return 2;
+    try
+    {
+        Terrain terrain(argv[1]);
+        terrain.Origin({"Dolanaar inn", 1, 9821.9019f, 898.0601f, 0.0f, true});
+        terrain.Origin({"Dolanaar druid tower", 1, 9955.5738f, 888.7574f, 0.0f, true});
+        terrain.Origin({"Goldshire inn", 0, -9483.1654f, -10.1595f, 0.0f, true});
+        for (Point const& point : Floors)
+            terrain.Floor(point, true);
+        for (Point const& point : Reported)
+            terrain.Floor(point, false);
+        Point const thada{"Thada saved logout", 1, 9825.18f, 907.702f, 1303.51f, true};
+        terrain.Floor(thada, false);
+        float const aboveSaved = terrain.Collision(thada, thada.z + 8.0f, 12.0f);
+        std::cout << Acore::StringFormat("OBSERVATION: Thada saved-z={:.3f} floor-from-above={:.3f} delta={:.3f}\n",
+                                      thada.z, aboveSaved, aboveSaved - thada.z);
+        terrain.Route(Floors[0], Floors[1], "Dolanaar raised dining room");
+        terrain.Route(Floors[6], Floors[7], "Dolanaar termite bottom chamber");
+        terrain.Route(Floors[8], Floors[9], "Goldshire main room");
+        terrain.Route(Floors[12], Floors[13], "Cain crypt entrance room");
+        for (std::size_t index = 0; index < Ironhorn.size(); ++index)
+        {
+            auto const& a = Ironhorn[index];
+            auto const& b = Ironhorn[(index + 1) % Ironhorn.size()];
+            terrain.Route({"Ironhorn start", 1, a[0], a[1], a[2], false},
+                          {"Ironhorn end", 1, b[0], b[1], b[2], false},
+                          Acore::StringFormat("Bloodhoof Ironhorn waypoint {} to {}", index + 1,
+                                              (index + 1) % Ironhorn.size() + 1));
+        }
+        std::cout << Acore::StringFormat("TERRAIN RESULT: {} failures; reported-location observations are not assertions\n",
+                                      Failures);
+        return Failures ? 1 : 0;
+    }
+    catch (std::exception const& error)
+    {
+        std::cerr << "PREREQUISITE ERROR: " << error.what() << '\n';
+        return 2;
+    }
+}
diff --git a/apps/coa-tests/g1_terrain_alignment/run.py b/apps/coa-tests/g1_terrain_alignment/run.py
