+#ifndef PLAYERBOTS_BOTSOCIALCHAT_H
+#define PLAYERBOTS_BOTSOCIALCHAT_H
+
+#include "BotSocialChatPolicy.h"
+#include "ObjectGuid.h"
+#include <mutex>
+#include <optional>
+#include <string>
+
+class PlayerbotAI;
