-        float emissive[3];
-        float diffuse[3];
-        for (int c = 0; c < 3; ++c)
-        {
-            emissive[c] = layer.emissive[c] + (layer.shadowEmissive[c] - layer.emissive[c]) * shadow;
-            diffuse[c] = layer.diffuse[c] * (1.0f - shadow);
-        }
-        const float density = layer.density * (1.0f + (layer.shadowDensity - 1.0f) * shadow);
