+#ifndef PLAYERBOTS_BOTSOCIALCHATPOLICY_H
+#define PLAYERBOTS_BOTSOCIALCHATPOLICY_H
+
+#include <array>
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+namespace BotSocialPolicy
+{
+enum class Intent : std::uint8_t
+{
+    None,
+    Hello,
+    Thanks,
+    Goodbye,
+    ClassRole,
+    Location
+};
+
+inline std::string Lower(std::string_view input)
+{
+    std::string result(input);
+    for (char& value : result)
+        if (value >= 'A' && value <= 'Z')
+            value = char(value - 'A' + 'a');
+    return result;
+}
+
+inline void Trim(std::string& value)
+{
+    std::size_t const first = value.find_first_not_of(' ');
+    if (first == std::string::npos)
+    {
+        value.clear();
+        return;
+    }
+    value = value.substr(first, value.find_last_not_of(' ') - first + 1);
+}
+
+inline Intent Parse(std::string_view input, std::string_view botName, bool whisper)
+{
+    if (input.empty() || input.size() > 200 || botName.empty())
+        return Intent::None;
+    for (unsigned char value : input)
+        if (value < 32 || value == 127 || value == '|' || value == ';' || value == '\\')
+            return Intent::None;
+
+    std::string text = Lower(input);
+    Trim(text);
+    std::string const name = Lower(botName);
+    bool const named = text.size() > name.size() && text.compare(0, name.size(), name) == 0 &&
+        (text[name.size()] == ' ' || text[name.size()] == ',' || text[name.size()] == ':');
+    if (!whisper && !named)
+        return Intent::None;
+    if (named)
+    {
+        text.erase(0, name.size());
+        if (!text.empty() && (text.front() == ',' || text.front() == ':'))
+            text.erase(0, 1);
+        Trim(text);
+    }
+    while (!text.empty() && (text.back() == '!' || text.back() == '?' || text.back() == '.'))
+        text.pop_back();
+    Trim(text);
+
+    if (text == "hi" || text == "hello" || text == "hey" || text == "greetings")
+        return Intent::Hello;
+    if (text == "thanks" || text == "thank you" || text == "thank you very much")
+        return Intent::Thanks;
+    if (text == "bye" || text == "goodbye" || text == "see you" || text == "farewell")
+        return Intent::Goodbye;
+    if (text == "what class are you" || text == "what is your class" || text == "what's your class" ||
+        text == "what role are you" || text == "what is your role" || text == "what's your role")
+        return Intent::ClassRole;
+    if (text == "where are you" || text == "where are you now" || text == "what zone are you in")
+        return Intent::Location;
+    return Intent::None;
+}
+
+class Cooldown
+{
+public:
+    bool Accept(std::uint64_t sender, Intent intent, std::uint64_t now)
+    {
+        if (!sender || intent == Intent::None || now < next)
+            return false;
+        for (auto const& entry : history)
+            if (entry.sender == sender && entry.intent == intent && now < entry.until)
+                return false;
+        history[cursor] = {sender, intent, now + 60000};
+        cursor = (cursor + 1) % history.size();
+        next = now + 10000;
+        return true;
+    }
+
+private:
+    struct Entry
+    {
+        std::uint64_t sender = 0;
+        Intent intent = Intent::None;
+        std::uint64_t until = 0;
+    };
+    std::array<Entry, 8> history{};
+    std::size_t cursor = 0;
+    std::uint64_t next = 0;
+};
+
+class SenderBudget
+{
+public:
+    bool Accept(std::uint64_t sender, std::uint64_t now)
+    {
+        if (!sender)
+            return false;
+        Entry* available = nullptr;
+        for (auto& entry : senders)
+        {
+            if (entry.sender == sender)
+            {
+                if (now < entry.until)
+                    return false;
+                entry.until = now + 5000;
+                return true;
+            }
+            if (!available && now >= entry.until)
+                available = &entry;
+        }
+        if (!available)
+            return false;
+        *available = {sender, now + 5000};
+        return true;
+    }
+
+private:
+    struct Entry
+    {
+        std::uint64_t sender = 0;
+        std::uint64_t until = 0;
+    };
+    std::array<Entry, 256> senders{};
+};
+}
+
+#endif
