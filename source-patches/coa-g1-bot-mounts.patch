@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+CLI_DESCRIPTION = "Check bounded bot mount acquisition, idempotence, refusals and preserved build observations."
+
+import argparse
+import json
+import math
+from pathlib import Path
+
+
+def observations(directory):
+    summary = json.loads((directory / 'summary.json').read_text(encoding='utf-8'))
+    result = json.loads((directory / 'result.json').read_text(encoding='utf-8'))
+    scenario = json.loads((directory / 'scenario.json').read_text(encoding='utf-8'))
+    if summary['status'] != 'passed' or result['status'] != 'passed':
+        raise ValueError('A completed native scenario pass is required')
+    values = {}
+    acquisitions = []
+    for definition, step in zip(scenario['steps'], result['steps'], strict=True):
+        if definition['action'] == 'ensure_bot_mount':
+            actual = float(step['actual'])
+            expected = int(definition['accepted'])
+            if not math.isfinite(actual) or actual != expected:
+                raise ValueError(f"Incorrect acquisition result for {definition['actor']} spell {definition['spell']}")
+            acquisitions.append((definition['actor'], definition['spell'], actual))
+        if step['action'] != 'snapshot':
+            continue
+        label = step['label']
+        if label in values:
+            raise ValueError(f'Duplicate snapshot: {label}')
+        value = float(step['actual'])
+        if not math.isfinite(value):
+            raise ValueError(f'Non-finite snapshot: {label}')
+        values[label] = value
+    if acquisitions != [('bot', 91737, 1), ('bot', 91737, 1), ('bot', 900125, 1), ('bot', 900125, 1),
+                        ('bot', 133, 0), ('bot', 750750, 0), ('bot', 2147483647, 0), ('human', 91737, 0),
+                        ('classic', 91737, 0), ('untrained', 91737, 0)]:
+        raise ValueError('The required positive, repeated and refused acquisition controls are incomplete')
+    return values
+
+
+def check(values):
+    spell_counts = ('initial_bot_spells', 'furline_bot_spells', 'repeated_furline_bot_spells',
+                    'blossom_bot_spells', 'repeated_blossom_bot_spells', 'after_refused_bot_spells')
+    initial = values['initial_bot_spells']
+    control_counts = tuple(f'{phase}_{actor}_spells'
+                           for actor in ('human', 'classic', 'untrained') for phase in ('initial', 'after'))
+    if any(values[label] < 0 or not values[label].is_integer() for label in (*spell_counts, *control_counts)):
+        raise ValueError('Known spell counts must be nonnegative integers')
+    for label, delta in zip(spell_counts, (0, 1, 1, 2, 2, 2), strict=True):
+        if values[label] != initial + delta:
+            raise ValueError(f'{label}: spell count changed by {values[label] - initial}, expected {delta}')
+    for actor in ('human', 'classic', 'untrained'):
+        if values[f'after_{actor}_spells'] != values[f'initial_{actor}_spells']:
+            raise ValueError(f'{actor}: a refused acquisition changed the known spell count')
+    for field in ('spec', 'points', 'nonmount', 'book'):
+        if values[f'after_bot_{field}'] != values[f'initial_bot_{field}']:
+            raise ValueError(f'{field}: acquiring mounts changed an existing build or companion observation')
+    for mount in ('furline', 'blossom'):
+        if not math.isclose(values[f'{mount}_ground_speed'], 2, rel_tol=0, abs_tol=0.000001):
+            raise ValueError(f'{mount}: the mounted ground speed must be twice ordinary speed')
+        if not math.isclose(values[f'{mount}_dismount_speed'], 1, rel_tol=0, abs_tol=0.000001):
+            raise ValueError(f'{mount}: dismounting must restore ordinary speed')
+    print('Two requested mounts acquired once; all refusal controls and existing build observations preserved')
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=CLI_DESCRIPTION)
+    parser.add_argument('result_directory', type=Path)
+    arguments = parser.parse_args()
+    check(observations(arguments.result_directory))
