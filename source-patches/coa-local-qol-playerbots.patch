+// Both catalog generations of Sunwarmed Furline apply the correct permanent
+// mount aura, but this custom client build does not turn that aura's creature
+// entry into a visible mount. Preserve the native aura for speed and removal,
+// and repair only the missing display after a successful cast.
+class spell_ascension_sunwarmed_furline : public SpellScript
+{
+    PrepareSpellScript(spell_ascension_sunwarmed_furline);
+
+    static constexpr uint32 DisplayId = 99008;
+    static constexpr uint32 CreatureEntry = 80403;
+
+    bool Load() override
+    {
+        return ascensionCompatConfig.GetConfigValue<bool>(AscensionCompatConfig::ENABLED) &&
+            GetCaster()->IsPlayer();
+    }
+
+    void EnsureMountDisplay()
+    {
+        Player* player = GetCaster()->ToPlayer();
+        if (player && player->HasAura(GetSpellInfo()->Id) &&
+            player->GetUInt32Value(UNIT_FIELD_MOUNTDISPLAYID) != DisplayId)
+            player->Mount(DisplayId, 0, CreatureEntry);
+    }
+
+    void Register() override
+    {
+        AfterCast += SpellCastFn(spell_ascension_sunwarmed_furline::EnsureMountDisplay);
+    }
+};
