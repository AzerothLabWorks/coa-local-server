+#include "fixture.h"
+#include "BotPartySocialProduction.h"
+#include <iostream>
+#include <stdexcept>
+
+namespace
+{
+    void Check(bool value, char const* name)
+    {
+        if (!value)
+            throw std::runtime_error(name);
+    }
+
+    struct Party
+    {
+        Party()
+        {
+            static std::uint64_t nextGroup = 1;
+            group.guid = nextGroup++;
+            group.Add(&bot);
+            group.Add(&human);
+            bot.sitting = true;
+            bot.auras[SPELL_AURA_MOD_POWER_REGEN].push_back(&drink);
+            FixtureNow += 100000;
+        }
+
+        void Tick(std::uint64_t elapsed = 1000)
+        {
+            FixtureNow += elapsed;
+            social.Update(&ai);
+        }
+
+        void Finish(float mana = 100.0f)
+        {
+            bot.sitting = false;
+            bot.auras.clear();
+            bot.mana = mana;
+        }
+
+        Player bot;
+        Player human;
+        Group group;
+        AuraEffect drink;
+        PlayerbotAI ai{&bot};
+        BotPartySocial social;
+    };
+
+    void TestEpisodePolicy()
+    {
+        using namespace bot_party_social;
+        Episode episode;
+        Snapshot snapshot{1, true, true, 30.0f};
+        Check(episode.Observe(snapshot, 0) == Notice::Drinking, "initial drinking notice");
+        episode.Confirm(Notice::Drinking, 0);
+        Check(episode.Observe(snapshot, 1000) == Notice::None, "no repeated drinking");
+        snapshot.drinking = false;
+        snapshot.manaPercent = 90;
+        Check(episode.Observe(snapshot, 10000) == Notice::ManaReady, "ready boundary");
+        Check(episode.Observe(snapshot, 11000) == Notice::None, "ready once");
+        snapshot.drinking = true;
+        snapshot.manaPercent = 20;
+        Check(episode.Observe(snapshot, 12000) == Notice::None, "bot cooldown");
+        snapshot.drinking = false;
+        snapshot.manaPercent = 100;
+        Check(episode.Observe(snapshot, 20000) == Notice::None, "unannounced episode no ready");
+        snapshot.drinking = true;
+        snapshot.manaPercent = 20;
+        Check(episode.Observe(snapshot, 90000) == Notice::Drinking, "bot cooldown expires");
+        episode.Confirm(Notice::Drinking, 90000);
+        snapshot.group = 2;
+        snapshot.drinking = false;
+        snapshot.manaPercent = 100;
+        Check(episode.Observe(snapshot, 100000) == Notice::None, "group change discards ready");
+        snapshot.drinking = true;
+        snapshot.manaPercent = 20;
+        Check(episode.Observe(snapshot, 101000) == Notice::None, "group change preserves bot cooldown");
+        episode.Reset();
+        Check(episode.Observe(snapshot, 180000) == Notice::Drinking, "new episode after reset");
+        episode.Confirm(Notice::Drinking, 180000);
+        snapshot.drinking = false;
+        snapshot.manaPercent = 100;
+        Check(episode.Observe(snapshot, 301000) == Notice::None, "stale episode cannot announce ready");
+
+        GroupBudget budget;
+        Check(!budget.Acquire(0, 0), "invalid group denied");
+        Check(budget.Acquire(1, 0), "first group notice allowed");
+        Check(!budget.Acquire(1, 5999), "group cooldown");
+        Check(budget.Acquire(1, 6000), "group cooldown expires");
+        for (std::uint64_t group = 2; group <= GroupBudget::MaximumGroups; ++group)
+            Check(budget.Acquire(group, 6000), "independent group budgets");
+        Check(!budget.Acquire(2000, 6000), "group state bounded");
+        Check(budget.Size() == GroupBudget::MaximumGroups, "bounded group capacity");
+        Check(budget.Acquire(2000, 66000), "expired group entries reclaimed");
+        Check(budget.Size() == 1, "group cleanup removes old entries");
+    }
+
+    void TestNormalLifecycle()
+    {
+        Party party;
+        party.Tick();
+        Check(party.ai.messages.size() == 1, "observed actual drink announces");
+        for (int i = 0; i < 10; ++i)
+            party.Tick();
+        Check(party.ai.messages.size() == 1, "ongoing drink stays quiet");
+        party.Finish();
+        party.Tick();
+        Check(party.ai.messages.size() == 2, "finished drink announces mana ready");
+        party.Tick();
+        Check(party.ai.messages.size() == 2, "ready not repeated");
+        Check(party.ai.messages[0] != party.ai.messages[1], "distinct start and end phrasing");
+
+        Party poll;
+        poll.social.Update(&poll.ai);
+        poll.Finish();
+        poll.Tick(1);
+        Check(poll.ai.messages.size() == 1, "poll throttles high frequency updates");
+    }
+
+    void TestEligibility()
+    {
+        for (int condition = 0; condition < 17; ++condition)
+        {
+            Party party;
+            PlayerbotAI humanBot(&party.human);
+            party.human.ai = nullptr;
+            switch (condition)
+            {
+                case 0: party.group.raid = true; break;
+                case 1: party.human.ai = &humanBot; break;
+                case 2: party.human.distance = 51.0f; break;
+                case 3: party.human.map = 2; break;
+                case 4: party.human.phase = 2; break;
+                case 5: party.human.inWorld = false; break;
+                case 6: party.human.alive = false; break;
+                case 7: party.human.combat = true; break;
+                case 8: party.bot.inWorld = false; break;
+                case 9: party.bot.alive = false; break;
+                case 10: party.bot.combat = true; break;
+                case 11: party.bot.teleporting = true; break;
+                case 12: party.bot.mounted = true; break;
+                case 13: party.bot.manaMax = 0; break;
+                case 14: party.bot.group = nullptr; break;
+                case 15: party.human.hasSession = false; break;
+                case 16: party.human.session.bot = true; break;
+            }
+            party.Tick();
+            Check(party.ai.messages.empty(), "irrelevant or unsafe party must stay quiet");
+        }
+
+        Party disabled;
+        sPlayerbotAIConfig.socialPartyEnabled = false;
+        disabled.Tick();
+        Check(disabled.ai.messages.empty(), "disabled feature remains quiet");
+        sPlayerbotAIConfig.socialPartyEnabled = true;
+    }
+
+    void TestDrinkClassification()
+    {
+        for (int condition = 0; condition < 5; ++condition)
+        {
+            Party party;
+            switch (condition)
+            {
+                case 0: party.bot.sitting = false; break;
+                case 1: party.drink.power = 1; break;
+                case 2: party.drink.amount = 0; break;
+                case 3: party.drink.info.AuraInterruptFlags = 0; break;
+                case 4: party.bot.auras.clear(); break;
+            }
+            party.Tick();
+            Check(party.ai.messages.empty(), "non-drinking regen or sitting must not announce");
+        }
+        for (AuraType type : {SPELL_AURA_MOD_POWER_REGEN_PERCENT, SPELL_AURA_PERIODIC_ENERGIZE})
+        {
+            Party party;
+            party.bot.auras.clear();
+            party.bot.auras[type].push_back(&party.drink);
+            party.Tick();
+            Check(party.ai.messages.size() == 1, "alternative actual mana drink aura recognized");
+        }
+    }
+
+    void TestInterruptedEpisodes()
+    {
+        for (int condition = 0; condition < 8; ++condition)
+        {
+            Party party;
+            party.Tick();
+            Check(party.ai.messages.size() == 1, "episode start before interruption");
+            switch (condition)
+            {
+                case 0: party.bot.combat = true; break;
+                case 1: party.bot.alive = false; break;
+                case 2: party.bot.inWorld = false; break;
+                case 3: party.bot.teleporting = true; break;
+                case 4: party.human.distance = 100.0f; break;
+                case 5: party.group.guid += 10000; break;
+                case 6: party.Finish(89.0f); break;
+                case 7: sPlayerbotAIConfig.socialPartyEnabled = false; break;
+            }
+            party.Tick(7000);
+            party.bot.combat = false;
+            party.bot.alive = true;
+            party.bot.inWorld = true;
+            party.bot.teleporting = false;
+            party.human.distance = 0.0f;
+            sPlayerbotAIConfig.socialPartyEnabled = true;
+            party.Finish();
+            party.Tick();
+            Check(party.ai.messages.size() == 1, "interrupted episode cannot announce ready later");
+        }
+
+        Party failed;
+        failed.ai.sendSuccess = false;
+        failed.Tick();
+        failed.ai.sendSuccess = true;
+        failed.Finish();
+        failed.Tick(10000);
+        Check(failed.ai.messages.empty(), "failed start delivery must not announce ready");
+    }
+
+    void TestPartyChorusSuppression()
+    {
+        Party party;
+        Player second;
+        second.sitting = true;
+        second.auras[SPELL_AURA_MOD_POWER_REGEN].push_back(&party.drink);
+        PlayerbotAI secondAI(&second);
+        BotPartySocial secondSocial;
+        party.group.Add(&second);
+        party.Tick();
+        secondSocial.Update(&secondAI);
+        Check(party.ai.messages.size() == 1 && secondAI.messages.empty(), "same party avoids drinking chorus");
+        second.sitting = false;
+        second.auras.clear();
+        second.mana = 100;
+        FixtureNow += 10000;
+        secondSocial.Update(&secondAI);
+        Check(secondAI.messages.empty(), "suppressed drink must not produce orphan ready");
+    }
+
+    void TestWrapperLifecycleReset()
+    {
+        Party party;
+        party.Tick();
+        Check(party.ai.messages.size() == 1, "drink announced before lifecycle guard");
+        party.social.Reset();
+        party.Finish();
+        party.Tick(10000);
+        Check(party.ai.messages.size() == 1, "wrapper invalid-state guard prevents stale ready on return");
+        party.bot.sitting = true;
+        party.bot.auras[SPELL_AURA_MOD_POWER_REGEN].push_back(&party.drink);
+        party.bot.mana = 20;
+        party.Tick();
+        Check(party.ai.messages.size() == 1, "wrapper reset preserves per-bot rate limit");
+    }
+}
+
+int main()
+{
+    TestEpisodePolicy();
+    TestNormalLifecycle();
+    TestEligibility();
+    TestDrinkClassification();
+    TestInterruptedEpisodes();
+    TestPartyChorusSuppression();
+    TestWrapperLifecycleReset();
+    std::cout << "Party social adapter and policy fixtures passed\n";
+}
