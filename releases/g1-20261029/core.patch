+
+namespace
+{
+void Check(bool value, char const* name)
+{
+    if (!value)
+        throw std::runtime_error(name);
+}
+
+struct Conversation
+{
+    Conversation()
+    {
+        static std::uint64_t nextGuid = 100;
+        bot.guid = nextGuid++;
+        human.guid = nextGuid++;
+        human.name = "Thada";
+        human.controlled = false;
+        bot.session.bot = true;
+        bot.group = human.group = &group;
+        FixtureNow += 100000;
+        FixtureMessages.clear();
+        sPlayerbotAIConfig = Config{};
+        FixturePlayers[bot.guid] = &bot;
+        FixturePlayers[human.guid] = &human;
+        general.name = "General - Elwynn Forest";
+        general.id = 1;
+        FixtureChannelMembers[&world] = {bot.guid, human.guid};
+        FixtureChannelMembers[&general] = {bot.guid, human.guid};
+        manager.channels[world.name] = &world;
+        manager.channels[general.name] = &general;
+        FixtureManagers[bot.team] = &manager;
+    }
+
+    ~Conversation()
+    {
+        FixturePlayers.erase(bot.guid);
+        FixturePlayers.erase(human.guid);
+        FixtureManagers.erase(bot.team);
+        FixtureChannelMembers.erase(&world);
+        FixtureChannelMembers.erase(&general);
+    }
+
+    bool Queue(uint32 type = CHAT_MSG_WHISPER, std::string const& text = "hello",
+               std::string const& channel = "World")
+    {
+        return social.Handle(ai, type, human.GetGUID(), text, channel);
+    }
+
+    void Tick(std::uint64_t elapsed = 1000)
+    {
+        FixtureNow += elapsed;
+        social.Update(ai);
+    }
+
+    Player bot;
+    Player human;
+    Group group;
+    Channel world;
+    Channel general;
+    ChannelMgr manager;
+    PlayerbotAI ai{&bot};
+    BotSocialChat social;
+};
+
+void TestRoutingAndDelay()
+{
+    for (uint32 type : {CHAT_MSG_WHISPER, CHAT_MSG_PARTY, CHAT_MSG_RAID, CHAT_MSG_SAY, CHAT_MSG_CHANNEL})
+    {
+        Conversation c;
+        c.group.raid = type == CHAT_MSG_RAID;
+        Check(c.Queue(type, type == CHAT_MSG_WHISPER ? "hello" : "Pablo, hello"), "supported request consumed");
+        c.Tick(999);
+        Check(FixtureMessages.empty(), "response waits for typing delay");
+        c.Tick(1);
+        Check(FixtureMessages.size() == 1 && FixtureMessages.front().type == type,
+              "reply uses the originating chat scope");
+        Check(FixtureMessages.front().text.find("Thada") != std::string::npos, "reply addresses live sender name");
+        if (type == CHAT_MSG_WHISPER)
+            Check(FixtureMessages.front().target == c.human.guid, "whisper is delivered only to its sender");
+        if (type == CHAT_MSG_CHANNEL)
+            Check(FixtureMessages.front().channel == "World", "world reply uses actual channel");
+        c.Tick();
+        Check(FixtureMessages.size() == 1, "pending reply is sent once");
+    }
+    Conversation c;
+    Check(c.Queue(CHAT_MSG_CHANNEL, "Pablo, hello", c.general.name), "zone channel request accepted");
+    c.Tick();
+    Check(FixtureMessages.size() == 1 && FixtureMessages.front().channel == c.general.name,
+          "zone reply stays in the originating zone channel");
+}
+
+void TestHumanAndLifecycleEligibility()
+{
+    for (int condition = 0; condition < 15; ++condition)
+    {
+        Conversation c;
+        switch (condition)
+        {
+            case 0: c.human.controlled = true; break;
+            case 1: c.human.hasSession = false; break;
+            case 2: c.human.session.bot = true; break;
+            case 3: c.human.inWorld = false; break;
+            case 4: c.human.teleporting = true; break;
+            case 5: c.human.removing = true; break;
+            case 6: c.human.map = 0; break;
+            case 7: c.bot.inWorld = false; break;
+            case 8: c.bot.teleporting = true; break;
+            case 9: c.bot.removing = true; break;
+            case 10: c.bot.map = 0; break;
+            case 11: c.human.social.ignored.insert(c.bot.guid); break;
+            case 12: FixturePlayers.erase(c.human.guid); break;
+            case 13: FixturePlayers[c.human.guid] = &c.bot; break;
+            case 14: c.ai.bot = nullptr; break;
+        }
+        c.Queue();
+        c.Tick();
+        Check(FixtureMessages.empty(), "unsafe or nonhuman sender never receives social reply");
+    }
+}
+
+void TestScopeEligibility()
+{
+    for (int condition = 0; condition < 15; ++condition)
+    {
+        Conversation c;
+        Channel other;
+        other.name = "UnrelatedCustomChannel";
+        uint32 type = CHAT_MSG_SAY;
+        switch (condition)
+        {
+            case 0: c.human.distance = 25.1f; break;
+            case 1: c.human.map = 2; break;
+            case 2: c.human.phase = 2; break;
+            case 3: c.human.friendly = false; break;
+            case 4: type = CHAT_MSG_PARTY; c.human.group = nullptr; break;
+            case 5: type = CHAT_MSG_PARTY; c.bot.group = nullptr; break;
+            case 6: type = CHAT_MSG_RAID; break;
+            case 7: type = CHAT_MSG_CHANNEL; FixtureChannelMembers[&c.world].erase(c.bot.guid); break;
+            case 8: type = CHAT_MSG_CHANNEL; FixtureChannelMembers[&c.world].erase(c.human.guid); break;
+            case 9: type = CHAT_MSG_CHANNEL; FixtureManagers.clear(); break;
+            case 10: type = CHAT_MSG_CHANNEL; c.manager.channels.clear(); break;
+            case 11: type = CHAT_MSG_GUILD; break;
+            case 12: type = CHAT_MSG_YELL; break;
+            case 13:
+                type = CHAT_MSG_CHANNEL;
+                FixtureChannelMembers[&c.world].erase(c.bot.guid);
+                FixtureChannelMembers[&other] = {c.bot.guid};
+                break;
+            case 14:
+                type = CHAT_MSG_CHANNEL;
+                FixtureChannelMembers[&c.world].erase(c.human.guid);
+                FixtureChannelMembers[&other] = {c.human.guid};
+                break;
+        }
+        c.Queue(type, "Pablo, hello");
+        c.Tick();
+        Check(FixtureMessages.empty(), "unshared or unsupported scope remains silent");
+        FixtureChannelMembers.erase(&other);
+    }
+    {
+        Conversation c;
+        c.general.id = 2;
+        c.Queue(CHAT_MSG_CHANNEL, "Pablo, hello", c.general.name);
+        c.Tick();
+        Check(FixtureMessages.empty(), "unapproved public channel stays silent");
+    }
+    {
+        Conversation c;
+        c.human.distance = 25.0f;
+        c.Queue(CHAT_MSG_SAY, "Pablo, hello");
+        c.Tick();
+        Check(FixtureMessages.size() == 1, "exact local distance boundary accepted");
+    }
+}
+
+void TestPendingRevalidation()
+{
+    for (int condition = 0; condition < 11; ++condition)
+    {
+        Conversation c;
+        uint32 const type = condition == 7 ? CHAT_MSG_PARTY : condition == 8 ? CHAT_MSG_CHANNEL :
+                            condition == 9 ? CHAT_MSG_SAY : CHAT_MSG_WHISPER;
+        c.Queue(type, "Pablo, hello");
+        switch (condition)
+        {
+            case 0: FixturePlayers.erase(c.human.guid); break;
+            case 1: c.human.hasSession = false; break;
+            case 2: c.human.teleporting = true; break;
+            case 3: c.human.session.bot = true; break;
+            case 4: c.human.social.ignored.insert(c.bot.guid); break;
+            case 5: c.bot.removing = true; break;
+            case 6: c.bot.map = 0; break;
+            case 7: c.human.group = nullptr; break;
+            case 8: FixtureChannelMembers[&c.world].erase(c.human.guid); break;
+            case 9: c.human.phase = 2; break;
+            case 10: c.ai.bot = nullptr; break;
+        }
+        c.Tick();
+        Check(FixtureMessages.empty(), "pending delivery revalidates sender and routing lifecycle");
+        FixturePlayers[c.human.guid] = &c.human;
+        c.human.hasSession = true;
+        c.human.teleporting = false;
+        c.human.session.bot = false;
+        c.human.social.ignored.clear();
+        c.bot.removing = false;
+        c.bot.map = 1;
+        c.human.group = &c.group;
+        FixtureChannelMembers[&c.world].insert(c.human.guid);
+        c.human.phase = 1;
+        c.ai.bot = &c.bot;
+        c.Tick();
+        Check(FixtureMessages.empty(), "discarded reply does not reappear after eligibility returns");
+    }
+    {
+        Conversation c;
+        c.Queue();
+        c.Tick(10001);
+        Check(FixtureMessages.empty(), "expired pending reply is discarded");
+    }
+    {
+        Conversation c;
+        c.Queue();
+        c.Tick(10000);
+        Check(FixtureMessages.size() == 1, "reply remains valid at exact expiry boundary");
+    }
+}
+
+void TestFeatureToggleAndFlood()
+{
+    {
+        Conversation c;
+        c.Queue();
+        c.social.Reset();
+        c.Tick();
+        Check(FixtureMessages.empty(), "lifecycle reset cancels pending delivery");
+        c.Tick(10000);
+        c.Queue();
+        c.Tick();
+        Check(FixtureMessages.empty(), "lifecycle reset preserves anti-spam intent history");
+    }
+    for (bool cancelThroughHandle : {false, true})
+    {
+        Conversation c;
+        c.Queue();
+        sPlayerbotAIConfig.socialChatEnabled = false;
+        if (cancelThroughHandle)
+            Check(!c.Queue(), "disabled Handle defers to ordinary behavior");
+        else
+            c.Tick();
+        sPlayerbotAIConfig.socialChatEnabled = true;
+        c.Tick();
+        Check(FixtureMessages.empty(), "disabling social chat cancels pending delivery");
+    }
+    {
+        Conversation c;
+        auto const start = FixtureNow;
+        c.Queue();
+        for (unsigned attempt = 0; attempt < 1000; ++attempt)
+            c.Queue(CHAT_MSG_WHISPER, "where are you");
+        c.Tick();
+        Check(FixtureMessages.size() == 1 && FixtureMessages.front().text.find("Thada") != std::string::npos,
+              "repeated requests cannot replace or multiply pending greeting");
+        FixtureNow = start + 10000;
+        c.Queue(CHAT_MSG_WHISPER, "thanks");
+        c.Tick();
+        Check(FixtureMessages.size() == 2, "different intent allowed after per-bot cooldown");
+        FixtureNow = start + 20000;
+        c.Queue();
+        c.Tick();
+        Check(FixtureMessages.size() == 2, "same sender intent remains suppressed for one minute");
+        FixtureNow = start + 60000;
+        c.Queue();
+        c.Tick();
+        Check(FixtureMessages.size() == 3, "same intent allowed after history expiry");
+    }
+    {
+        Conversation c;
+        Player second;
+        second.guid = c.bot.guid + 100000;
+        second.name = "Amaryla";
+        PlayerbotAI secondAI(&second);
+        BotSocialChat secondSocial;
+        c.Queue();
+        FixtureNow += 1000;
+        secondSocial.Handle(secondAI, CHAT_MSG_WHISPER, c.human.GetGUID(), "hello", "");
+        c.social.Update(c.ai);
+        secondSocial.Update(secondAI);
+        Check(FixtureMessages.size() == 1, "one human cannot trigger a chorus across multiple bots");
+        FixtureNow += 5000;
+        secondSocial.Handle(secondAI, CHAT_MSG_WHISPER, c.human.GetGUID(), "hello", "");
+        FixtureNow += 1000;
+        secondSocial.Update(secondAI);
+        Check(FixtureMessages.size() == 2 && FixtureMessages.back().sender == second.guid,
+              "sender-budget denial does not consume second bot's local intent cooldown");
+    }
+}
+
+void TestLiveContext()
+{
+    for (int role = 0; role < 3; ++role)
+    {
+        Conversation c;
+        c.Queue(CHAT_MSG_WHISPER, "what role are you");
+        c.bot.classId = role == 1 ? 14 : 13;
+        c.bot.level = 30;
+        c.bot.tank = role == 0;
+        c.bot.heal = role == 1;
+        c.Tick();
+        std::string const expected = std::string("I'm a level 30 ") + (role == 1 ? "Sun Cleric" : "Primalist") +
+            ", focused on " + (role == 0 ? "tanking" : role == 1 ? "healing" : "dealing damage") + ".";
+        Check(FixtureMessages.size() == 1 && FixtureMessages.front().text == expected,
+              "role response uses current native class level and role API values");
+    }
+    {
+        Conversation c;
+        c.Queue(CHAT_MSG_WHISPER, "where are you");
+        c.ai.zone.name = "The Barrens";
+        c.Tick();
+        Check(FixtureMessages.size() == 1 && FixtureMessages.front().text == "I'm in The Barrens.",
+              "location response reads current zone at delivery time");
+    }
+    {
+        Conversation c;
+        c.ai.hasZone = false;
+        c.Queue(CHAT_MSG_WHISPER, "where are you");
+        c.Tick();
+        Check(FixtureMessages.size() == 1 && FixtureMessages.front().text == "I'm between destinations right now.",
+              "missing zone has safe truthful fallback");
+    }
+}
+
+void TestActualCommandGate()
+{
+    Conversation c;
+    auto request = [&c](uint32 type, std::string const& text, uint32 lang = LANG_UNIVERSAL)
+    {
+        return c.ai.IsSocialChatRequest(type, text, &c.human, lang);
+    };
+    Check(request(CHAT_MSG_WHISPER, "hello"), "ordinary human greeting qualifies");
+    Check(!request(CHAT_MSG_WHISPER, "hello", LANG_ADDON), "addon-language messages never become social chat");
+    Check(!request(CHAT_MSG_SAY, "hello") && request(CHAT_MSG_SAY, "Pablo, hello"),
+          "public messages require exact leading bot name");
+    for (std::string const command : {"follow", "stay", "co ?", "nc ?", "do check mount state", "lfg bot tank",
+                                     "hello;follow", ".reset", "|Hitem:2672|h[item]|h", "hello\nfollow"})
+        Check(!request(CHAT_MSG_WHISPER, command), "commands and encoded content stay outside social routing");
+    Check(!request(CHAT_MSG_GUILD, "Pablo, hello") && !request(CHAT_MSG_YELL, "Pablo, hello"),
+          "unsupported incoming types remain outside social routing");
+    sPlayerbotAIConfig.commandPrefix = "!";
+    Check(!request(CHAT_MSG_WHISPER, "!hello"), "configured command prefix remains command-owned");
+    sPlayerbotAIConfig.commandPrefix.clear();
+    sPlayerbotAIConfig.commandSeparator = "hello";
+    Check(!request(CHAT_MSG_WHISPER, "hello"), "configured command separator takes precedence");
+    sPlayerbotAIConfig.commandSeparator = ";";
+    c.human.session.bot = true;
+    Check(!request(CHAT_MSG_WHISPER, "hello"), "bot sessions cannot create reply loops");
+    c.human.session.bot = false;
+    c.human.hasSession = false;
+    Check(!request(CHAT_MSG_WHISPER, "hello"), "sessionless senders are not social requests");
+    c.human.hasSession = true;
+    sPlayerbotAIConfig.socialChatEnabled = false;
+    Check(!request(CHAT_MSG_WHISPER, "hello"), "disabled gate preserves prior chat routing");
+}
+}
+
+int main()
+{
+    TestRoutingAndDelay();
+    TestHumanAndLifecycleEligibility();
+    TestScopeEligibility();
+    TestPendingRevalidation();
+    TestFeatureToggleAndFlood();
+    TestLiveContext();
+    TestActualCommandGate();
+    std::cout << "PASS actual direct-chat routing, human gates, context, cooldowns and delayed lifecycle checks\n";
+}
