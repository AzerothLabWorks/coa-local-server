+void TestHeaderCrypt()
+{
+    struct Case
+    {
+        bool Enabled;
+        bool Loopback;
+        bool AllowRemote;
+        bool Plaintext;
+        bool Cluster;
+        bool Encrypted;
+        char const* Name;
+    };
+    Case const cases[] =
+    {
+        {true, true, false, true, false, false, "explicit loopback plaintext mode preserves client world headers"},
+        {true, false, true, true, false, false, "explicit allowed-remote plaintext mode preserves world headers"},
+        {true, true, false, false, false, true, "default loopback header mode keeps stock encryption"},
+        {true, false, true, false, false, true, "allowed remote clients retain encryption with plaintext mode off"},
+        {false, true, false, true, false, true, "disabled compatibility keeps loopback headers encrypted"},
+        {false, false, true, true, false, true, "disabled compatibility keeps allowed remote headers encrypted"},
+        {true, false, false, true, false, true, "disallowed remote clients keep stock header encryption"},
+        {false, false, false, false, false, true, "ordinary unconfigured clients keep stock header encryption"},
+        {true, true, false, false, true, false, "existing cluster mode does not initialize header encryption"},
+        {true, false, true, true, true, false, "cluster mode remains independent of plaintext compatibility"}
+    };
+    for (Case const& test : cases)
+    {
+        config.Enabled = test.Enabled;
+        config.AllowRemote = test.AllowRemote;
+        config.PlaintextHeaders = test.Plaintext;
+        sidecar.Cluster = test.Cluster;
+        WorldSocket socket(IoContextTcpSocket{test.Loopback});
+        socket.InitializeHeaderCrypt();
+        Check(socket._authCrypt.IsInitialized() == test.Encrypted &&
+            socket._authCrypt.Initializations == uint32(test.Encrypted), test.Name);
+    }
+
+    sidecar.Cluster = false;
+    config.Enabled = true;
+    config.AllowRemote = true;
+    config.PlaintextHeaders = true;
+    WorldSocket plaintext(IoContextTcpSocket{false});
+    config.Enabled = false;
+    config.AllowRemote = false;
+    config.PlaintextHeaders = false;
+    plaintext.InitializeHeaderCrypt();
+    Check(!plaintext._authCrypt.IsInitialized(), "plaintext header mode is cached per connection");
+
+    WorldSocket encrypted(IoContextTcpSocket{true});
+    config.Enabled = true;
+    config.AllowRemote = true;
+    config.PlaintextHeaders = true;
+    encrypted.InitializeHeaderCrypt();
+    Check(encrypted._authCrypt.IsInitialized() && encrypted._authCrypt.Initializations == 1,
+        "stock encrypted header mode is cached per connection");
+    config.PlaintextHeaders = false;
+}
