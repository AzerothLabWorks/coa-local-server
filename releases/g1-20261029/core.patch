+constexpr uint32 MAP_KALIMDOR = 1;
+constexpr uint32 MAP_OUTLAND = 530;
+constexpr uint32 MAP_NORTHREND = 571;
+constexpr uint32 AREA_FLAG_NO_FLY_ZONE = 1;
+constexpr uint32 SPELL_AURA_MOUNTED = 78;
+constexpr uint32 SPELL_AURA_MOD_INCREASE_MOUNTED_SPEED = 32;
+constexpr uint32 SPELL_AURA_FLY = 201;
+constexpr uint32 SPELL_AURA_MOD_INCREASE_FLIGHT_SPEED = 206;
+constexpr uint32 SPELL_AURA_MOD_INCREASE_MOUNTED_FLIGHT_SPEED = 207;
+constexpr uint32 SPELL_AURA_MOD_FLIGHT_SPEED_MOUNTED_NOT_STACKING = 211;
+constexpr uint32 MAX_SPELL_EFFECTS = 3;
+constexpr uint32 ALLSPELLHOOK_ON_CALCULATED_TARGET = 1;
+constexpr uint32 WORLDHOOK_ON_AFTER_CONFIG_LOAD = 2;
+constexpr uint32 WORLDHOOK_ON_STARTUP = 3;
+constexpr uint32 PLAYERHOOK_ON_UPDATE_AREA = 4;
+constexpr uint32 UNITHOOK_ON_AFTER_AURA_EFFECT_CALCULATE_AMOUNT = 5;
+constexpr uint32 SPELL_RIDING_APPRENTICE = 33388;
+constexpr uint32 SPELL_RIDING_JOURNEYMAN = 33391;
+constexpr uint32 SPELL_RIDING_EXPERT = 34090;
+constexpr uint32 SPELL_RIDING_ARTISAN = 34091;
+constexpr uint32 SPELL_COLD_WEATHER_FLYING = 54197;
+enum SpellCastResult { SPELL_CAST_OK, SPELL_FAILED_NOT_HERE };
+
+#include "RidingProduction.h"
+
+struct Player;
+struct AuraEffect;
+struct Unit
+{
+    virtual ~Unit() = default;
+    virtual Player* ToPlayer() { return nullptr; }
+};
+
+struct SpellEffectInfo
+{
+    uint32 ApplyAuraName = 0;
+    uint8 EffectIndex = 0;
+    bool IsAura(uint32 type) const { return ApplyAuraName == type; }
+};
+
+struct SpellInfo
+{
+    uint32 Id = 0;
+    std::array<SpellEffectInfo, 3> effects{};
+    bool locationAllowed = true;
+    bool flyingAreasOnly = false;
+    auto const& GetEffects() const { return effects; }
+    bool HasAura(uint32 type) const
+    {
+        for (auto const& effect : effects)
+            if (effect.IsAura(type))
+                return true;
+        return false;
+    }
+    SpellCastResult CheckLocation(uint32 map, uint32, uint32, Player*) const
+    {
+        return locationAllowed && (!flyingAreasOnly || map == MAP_OUTLAND || map == MAP_NORTHREND) ?
+            SPELL_CAST_OK : SPELL_FAILED_NOT_HERE;
+    }
+};
+
+struct Player : Unit
+{
+    uint16 riding = 300;
+    uint16 ridingStep = 5;
+    uint16 ridingMaximum = 300;
+    uint32 map = MAP_EASTERN_KINGDOMS;
+    uint32 guid = 1;
+    bool battleground = false;
+    bool zoneAllowed = true;
+    uint32 learningCalls = 0;
+    std::unordered_set<uint32> spells{900125};
+    std::vector<AuraEffect const*> mounts;
+    Player* ToPlayer() override { return this; }
+    uint16 GetBaseSkillValue(uint32) const { return riding; }
+    bool HasSpell(uint32 id) const { return spells.contains(id); }
+    uint32 GetMapId() const { return map; }
