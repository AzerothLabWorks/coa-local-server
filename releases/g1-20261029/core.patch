+namespace Acore
+{
+inline void Format(std::ostringstream& output, std::string_view value) { output << value; }
+template<class T, class... Rest>
+void Format(std::ostringstream& output, std::string_view value, T const& first, Rest const&... rest)
+{
+    auto const position = value.find("{}");
+    assert(position != std::string_view::npos);
+    output << value.substr(0, position) << first;
+    Format(output, value.substr(position + 2), rest...);
+}
+template<class... Values>
+std::string StringFormat(std::string_view value, Values const&... values)
+{
+    std::ostringstream output;
+    Format(output, value, values...);
+    return output.str();
+}
+}
+
+struct ObjectGuid
