+CLI_DESCRIPTION = "Compile the actual ambient chat pacing and template history against bounded load fixtures."
+
+import os
+from pathlib import Path
+import re
+import shlex
+import shutil
+import subprocess
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[3]
+POLICY = ROOT / "modules/mod-playerbots/src/Util"
+
+
+CONFIG_STUB = r"""
+#pragma once
+#include <cstdint>
+struct TestPlayerbotConfig
+{
+    bool socialPacingEnabled = false;
+    std::uint32_t socialAmbientChannelIntervalSeconds = 8;
+    std::uint32_t socialAmbientBotIntervalSeconds = 90;
+    std::uint32_t socialAmbientRepeatSeconds = 180;
+};
+extern TestPlayerbotConfig sPlayerbotAIConfig;
+"""
+
+RANDOM_STUB = r"""
+#pragma once
+#include <atomic>
+#include <cstdint>
+inline std::atomic<unsigned> uniformCalls = 0;
+inline std::atomic<unsigned> randomCalls = 0;
+inline std::uint32_t urand(std::uint32_t, std::uint32_t maximum)
+{
+    ++uniformCalls;
+    return maximum;
+}
+inline std::uint32_t rand32()
+{
+    return randomCalls.fetch_add(1);
+}
+"""
+
+
+def main():
+    compiler = os.environ.get("CXX") or shutil.which("c++") or shutil.which("g++") or shutil.which("clang++")
+    if not compiler:
+        raise RuntimeError("A C++20 compiler is required")
+    with tempfile.TemporaryDirectory(prefix="coa-social-pacing-") as temporary:
+        directory = Path(temporary)
+        (directory / "PlayerbotAIConfig.h").write_text(CONFIG_STUB, encoding="utf-8")
+        (directory / "Random.h").write_text(RANDOM_STUB, encoding="utf-8")
+        executable = directory / "fixture"
+        subprocess.run(shlex.split(compiler) + [
+            "-std=c++20", "-Wall", "-Wextra", "-Werror", "-pthread", "-I", str(directory), "-I", str(POLICY),
+            str(Path(__file__).with_name("fixture.cpp")), str(POLICY / "BotChatPacing.cpp"), "-o", str(executable),
+        ], check=True)
+        subprocess.run([str(executable)], check=True)
+    source = (ROOT / "modules/mod-playerbots/src/Bot/PlayerbotAI.cpp").read_text(encoding="utf-8")
+    texts = (ROOT / "modules/mod-playerbots/src/Mgr/Text/PlayerbotTextMgr.cpp").read_text(encoding="utf-8")
+    if source.count("BotChatPacing::AllowAmbient(") != 2:
+        raise RuntimeError("World and zone-channel sends must both use the shared pacing policy")
+    if texts.count("BotChatPacing::SelectTemplate(") != 2:
+        raise RuntimeError("Both template selection routes must use recent-history exclusion")
+    config = (ROOT / "modules/mod-playerbots/src/PlayerbotAIConfig.cpp").read_text(encoding="utf-8")
+    for field, option, default, minimum, maximum in (
+        ("socialAmbientChannelIntervalSeconds", "ChannelIntervalSeconds", 8, 3, 300),
+        ("socialAmbientBotIntervalSeconds", "BotIntervalSeconds", 90, 15, 900),
+        ("socialAmbientRepeatSeconds", "RepeatSeconds", 180, 30, 1800),
+    ):
+        pattern = (rf'{field}\s*=\s*std::clamp<uint32>\(\s*sConfigMgr->GetOption<uint32>\('
+                   rf'"AiPlayerbot\.SocialChat\.{option}",\s*{default}\),\s*{minimum},\s*{maximum}\)')
+        if not re.search(pattern, config):
+            raise RuntimeError("Ambient timing configuration lost its documented bounded range: " + field)
+    if 'socialPacingEnabled = sConfigMgr->GetOption<bool>("AiPlayerbot.SocialChat.AmbientPacing", false)' not in config:
+        raise RuntimeError("Ambient pacing must retain an explicit opt-in configuration default")
+    print("SOURCE-DOUBLES SCOPE: actual policy/wrapper and concurrent calls; not native chat delivery or gameplay.")
+
+
+if __name__ == "__main__":
+    main()
