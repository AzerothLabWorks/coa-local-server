new file mode 100644
index 0000000000000000000000000000000000000000..f83f18521735f2e5e9e85019fb74bd02b8f17466
--- /dev/null
+++ b/src/Util/BotPartySocial.cpp
@@ -0,0 +1,113 @@
+#include "BotPartySocial.h"
+#include "Group.h"
+#include "Player.h"
+#include "PlayerbotAI.h"
+#include "PlayerbotAIConfig.h"
+#include "SpellAuraEffects.h"
+#include "SpellInfo.h"
+#include "WorldSession.h"
+#include <array>
+#include <chrono>
+#include <mutex>
+
+namespace
+{
+    bot_party_social::Milliseconds MonotonicMilliseconds()
+    {
+        return std::chrono::duration_cast<std::chrono::milliseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+
+    bool HasDrinkAura(Player const* bot)
+    {
+        if (!bot->IsSitState())
+            return false;
+
+        for (AuraType const type : {SPELL_AURA_MOD_POWER_REGEN, SPELL_AURA_MOD_POWER_REGEN_PERCENT,
+                                   SPELL_AURA_PERIODIC_ENERGIZE})
+            for (AuraEffect const* effect : bot->GetAuraEffectsByType(type))
+                if (effect->GetMiscValue() == POWER_MANA && effect->GetAmount() > 0 &&
+                    (effect->GetSpellInfo()->AuraInterruptFlags & AURA_INTERRUPT_FLAG_NOT_SEATED))
+                    return true;
+
+        return false;
+    }
+
+    bool HasNearbyHumanParty(Player* bot, Group* group)
+    {
+        if (!group || group->isRaidGroup())
+            return false;
+
+        bool nearbyHuman = false;
+        for (GroupReference* ref = group->GetFirstMember(); ref; ref = ref->next())
+        {
+            Player* member = ref->GetSource();
+            if (!member || !member->IsInWorld() || member->IsBeingTeleported() ||
+                !bot->IsWithinDistInMap(member, 50.0f) || !bot->InSamePhase(member))
+                continue;
+
+            if (member->IsInCombat())
+                return false;
+
+            if (member->IsAlive() && IsRealPlayer(member) && member->GetSession() &&
+                !member->GetSession()->IsBot())
+                nearbyHuman = true;
+        }
+        return nearbyHuman;
+    }
+
+    bool AcquireGroupBudget(std::uint64_t group, bot_party_social::Milliseconds now)
+    {
+        static std::mutex mutex;
+        static bot_party_social::GroupBudget budget;
+        std::lock_guard<std::mutex> lock(mutex);
+        return budget.Acquire(group, now);
+    }
+}
+
+void BotPartySocial::Update(PlayerbotAI* ai)
+{
+    if (!sPlayerbotAIConfig.socialPartyEnabled || !ai)
+    {
+        episode.Reset();
+        return;
+    }
+
+    auto const now = MonotonicMilliseconds();
+    if (now < nextPoll)
+        return;
+    nextPoll = now + 1000;
+
+    Player* bot = ai->GetBot();
+    if (!bot || !bot->IsInWorld() || bot->IsBeingTeleported() || !bot->IsAlive() || bot->IsInCombat() ||
+        bot->IsMounted() || bot->GetMaxPower(POWER_MANA) == 0)
+    {
+        episode.Reset();
+        return;
+    }
+
+    Group* group = bot->GetGroup();
+    bot_party_social::Snapshot snapshot;
+    snapshot.group = group ? group->GetGUID().GetRawValue() : 0;
+    snapshot.eligible = HasNearbyHumanParty(bot, group);
+    snapshot.drinking = HasDrinkAura(bot);
+    snapshot.manaPercent = bot->GetPowerPct(POWER_MANA);
+    auto const notice = episode.Observe(snapshot, now);
+    if (notice == bot_party_social::Notice::None || !AcquireGroupBudget(snapshot.group, now))
+        return;
+
+    static constexpr std::array<char const*, 3> DrinkingLines = {
+        "Drinking to recover mana. Give me a moment.",
+        "Taking a quick drink for mana.",
+        "Recovering mana with a drink. One moment."
+    };
+    static constexpr std::array<char const*, 3> ReadyLines = {
+        "Mana is back. Ready when you are.",
+        "Finished drinking. My mana is ready.",
+        "Mana recovered. Ready to continue."
+    };
+    auto const style = bot->GetGUID().GetRawValue() % DrinkingLines.size();
+    char const* text = notice == bot_party_social::Notice::Drinking ? DrinkingLines[style] : ReadyLines[style];
+    if (ai->SayToParty(text))
+        episode.Confirm(notice, now);
+}
