diff --git a/src/Ai/Class/Coa/CoaBrewingProfile.cpp b/src/Ai/Class/Coa/CoaBrewingProfile.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..73a5af52294bc150ad81b609396b877feaab896b
--- /dev/null
+++ b/src/Ai/Class/Coa/CoaBrewingProfile.cpp
@@ -0,0 +1,424 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+#include "CoaBrewingProfile.h"
+
+#include "CombatStrategy.h"
+#include "Group.h"
+#include "MovementActions.h"
+#include "NonCombatStrategy.h"
+#include "Player.h"
+#include "PlayerbotAI.h"
+#include "Playerbots.h"
+#include "SpellInfo.h"
+#include "SpellMgr.h"
+#include "Trigger.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+namespace
+{
+constexpr float BREWING_HEAL_BELOW_PCT = 80.0f;
+constexpr float BREWING_CRITICAL_HEALTH_PCT = 40.0f;
+constexpr float BREWING_RECOVERY_LEASH = 60.0f;
+constexpr float BREWING_MANA_RESERVE_PCT = 40.0f;
+
+// Verified against the installed CoA Spell.dbc. Highest ranks are first.
+// Native base spells remain usable before the first ranked upgrade is learned.
+constexpr std::array<uint32, 10> LOAS_BREW =
+    {501206, 501205, 501204, 501203, 501202, 501201, 501200, 501199, 501198, 801670};
+constexpr std::array<uint32, 8> SPIRIT_IN_A_BOTTLE =
+    {501213, 501212, 501211, 501210, 501209, 501208, 501207, 801696};
+constexpr std::array<uint32, 7> POTION_TOSS =
+    {573435, 573434, 573433, 573432, 573431, 573430, 801661};
+
+bool IsBrewingPlayerReady(Player* player)
+{
+    return player && player->IsInWorld() && player->IsAlive() && player->FindMap() &&
+        !player->IsBeingTeleported();
+}
+
+bool HasKnownBrewingHeal(Player* bot)
+{
+    auto known = [bot](auto const& ranks)
+    {
+        return std::any_of(ranks.begin(), ranks.end(), [bot](uint32 id) { return bot->HasSpell(id); });
+    };
+    return known(LOAS_BREW) || known(SPIRIT_IN_A_BOTTLE) || known(POTION_TOSS);
+}
+
+float BrewingHealingRange(Player* bot, float health = 0.0f)
+{
+    float range = 0.0f;
+    auto include = [bot, &range](auto const& ranks)
+    {
+        for (uint32 id : ranks)
+            if (bot->HasSpell(id) && !bot->HasSpellCooldown(id))
+                if (SpellInfo const* info = sSpellMgr->GetSpellInfo(id))
+                {
+                    if (info->PowerType == POWER_MANA &&
+                        info->CalcPowerCost(bot, info->GetSchoolMask()) > int32(bot->GetPower(POWER_MANA)))
+                        continue;
+
+                    float candidate = info->GetMaxRange(true, bot);
+                    if (std::isfinite(candidate))
+                        range = std::max(range, candidate);
+                }
+    };
+    include(LOAS_BREW);
+    if (health < BREWING_CRITICAL_HEALTH_PCT)
+        include(SPIRIT_IN_A_BOTTLE);
+    if (health < 65.0f)
+        include(POTION_TOSS);
+    return range;
+}
+
+Player* FindBrewingWoundedTarget(Player* bot, float range, bool requireReach)
+{
+    if (!IsBrewingPlayerReady(bot))
+        return nullptr;
+
+    Player* target = bot->GetHealthPct() < BREWING_HEAL_BELOW_PCT ? bot : nullptr;
+    if (Group* group = bot->GetGroup())
+        for (GroupReference* member = group->GetFirstMember(); member; member = member->next())
+        {
+            Player* player = member->GetSource();
+            if (!IsBrewingPlayerReady(player) || player->FindMap() != bot->FindMap() ||
+                !bot->InSamePhase(player) || !bot->IsFriendlyTo(player))
+                continue;
+
+            float allowedRange = requireReach ?
+                std::min(range, BrewingHealingRange(bot, player->GetHealthPct())) : range;
+            if ((requireReach && allowedRange <= 0.0f) || !bot->IsWithinDistInMap(player, allowedRange) ||
+                (requireReach && !bot->IsWithinLOSInMap(player)))
+                continue;
+
+            if (player->GetHealthPct() < BREWING_HEAL_BELOW_PCT &&
+                (!target || player->GetHealthPct() < target->GetHealthPct()))
+                target = player;
+        }
+
+    return target;
+}
+
+Player* FindBrewingHealTarget(Player* bot)
+{
+    return IsBrewingPlayerReady(bot) ? FindBrewingWoundedTarget(bot, BrewingHealingRange(bot), true) : nullptr;
+}
+
+Player* FindBrewingRecoveryTarget(Player* bot)
+{
+    if (!IsBrewingPlayerReady(bot) || BrewingHealingRange(bot) <= 0.0f)
+        return nullptr;
+
+    Player* target = FindBrewingWoundedTarget(bot, BREWING_RECOVERY_LEASH, false);
+    if (!target || target == bot || target->IsFlying() || target->HasUnitState(UNIT_STATE_IN_FLIGHT))
+        return nullptr;
+
+    float range = BrewingHealingRange(bot, target->GetHealthPct());
+    if (range <= 0.0f || (bot->IsWithinDistInMap(target, range) && bot->IsWithinLOSInMap(target)))
+        return nullptr;
+
+    if (Player* reachable = FindBrewingHealTarget(bot))
+        if (reachable->GetHealthPct() < BREWING_CRITICAL_HEALTH_PCT ||
+            target->GetHealthPct() >= BREWING_CRITICAL_HEALTH_PCT)
+            return nullptr;
+
+    return target;
+}
+
+bool CanRecoverBrewingPosition(PlayerbotAI* ai)
+{
+    Player* bot = ai->GetBot();
+    return IsBrewingPlayerReady(bot) && !bot->IsMounted() && !bot->IsFlying() &&
+        !bot->HasUnitState(UNIT_STATE_IN_FLIGHT) &&
+        !bot->HasUnitMovementFlag(MOVEMENTFLAG_FALLING | MOVEMENTFLAG_FALLING_FAR) &&
+        !bot->IsNonMeleeSpellCast(false) && !ai->HasStrategy("stay", ai->GetState());
+}
+
+bool ShouldReserveBrewingMana(PlayerbotAI* ai, SpellInfo const* spell)
+{
+    Player* bot = ai->GetBot();
+    if (!ai->HasStrategy("coa brewing", BOT_STATE_COMBAT) || spell->PowerType != POWER_MANA ||
+        !HasKnownBrewingHeal(bot))
+        return false;
+
+    int32 cost = spell->CalcPowerCost(bot, spell->GetSchoolMask());
+    if (cost <= 0)
+        return false;
+
+    return FindBrewingHealTarget(bot) || FindBrewingRecoveryTarget(bot) ||
+        float(bot->GetPower(POWER_MANA)) - float(cost) <
+            float(bot->GetMaxPower(POWER_MANA)) * BREWING_MANA_RESERVE_PCT / 100.0f;
+}
+
+template <std::size_t N>
+bool CastFirstAvailableHeal(PlayerbotAI* ai, Player* bot, Unit* target, std::array<uint32, N> const& ranks)
+{
+    for (uint32 spellId : ranks)
+    {
+        if (!bot->HasSpell(spellId) || bot->HasSpellCooldown(spellId))
+            continue;
+
+        SpellInfo const* spell = sSpellMgr->GetSpellInfo(spellId);
+        if (!spell || (spell->PowerType == POWER_MANA &&
+            spell->CalcPowerCost(bot, spell->GetSchoolMask()) > int32(bot->GetPower(POWER_MANA))))
+            continue;
+
+        if (target != bot && (!bot->IsWithinDistInMap(target, spell->GetMaxRange(true, bot)) ||
+            !bot->IsWithinLOSInMap(target)))
+            continue;
+
+        if (bot->isMoving() && spell->CalcCastTime(bot))
+            bot->StopMoving();
+
+        if (ai->CanCastSpell(spellId, target))
+        {
+            if (!bot->IsStandState())
+                bot->SetStandState(UNIT_STAND_STATE_STAND);
+
+            if (ai->CastSpell(spellId, target))
+                return true;
+        }
+    }
+
+    return false;
+}
+
+class CoaBrewingReachAction final : public MovementAction
+{
+public:
+    explicit CoaBrewingReachAction(PlayerbotAI* ai) : MovementAction(ai, "coa brewing reach") {}
+
+    bool Execute(Event) override
+    {
+        if (!CanRecoverBrewingPosition(botAI))
+            return false;
+
+        Player* target = FindBrewingRecoveryTarget(botAI->GetBot());
+        if (!target)
+            return false;
+
+        if (!botAI->GetBot()->IsWithinLOSInMap(target))
+            return MoveToLOS(target, true);
+
+        return MoveNear(target,
+            std::max(1.0f, BrewingHealingRange(botAI->GetBot(), target->GetHealthPct()) - 3.0f));
+    }
+
+    bool isUseful() override
+    {
+        return CanRecoverBrewingPosition(botAI) && FindBrewingRecoveryTarget(botAI->GetBot());
+    }
+};
+
+class CoaBrewingHealthTrigger final : public Trigger
+{
+public:
+    CoaBrewingHealthTrigger(PlayerbotAI* ai, std::string const& name, float health) :
+        Trigger(ai, name), _health(health) {}
+
+    bool IsActive() override
+    {
+        Player* target = FindBrewingHealTarget(botAI->GetBot());
+        return target && target->GetHealthPct() < _health;
+    }
+
+private:
+    float _health;
+};
+
+class CoaBrewingReachTrigger final : public Trigger
+{
+public:
+    explicit CoaBrewingReachTrigger(PlayerbotAI* ai) : Trigger(ai, "coa brewing reach") {}
+
+    bool IsActive() override
+    {
+        return CanRecoverBrewingPosition(botAI) && FindBrewingRecoveryTarget(botAI->GetBot());
+    }
+};
+
+void InitBrewingRecoveryTriggers(std::vector<TriggerNode*>& triggers)
+{
+    triggers.push_back(new TriggerNode("coa brewing urgent",
+        {NextAction("coa brewing heal", ACTION_CRITICAL_HEAL + 4.0f)}));
+    triggers.push_back(new TriggerNode("coa brewing reach",
+        {NextAction("coa brewing reach", ACTION_CRITICAL_HEAL + 1.0f)}));
+    triggers.push_back(new TriggerNode("coa brewing wounded",
+        {NextAction("coa brewing heal", ACTION_MEDIUM_HEAL + 2.0f)}));
+}
+
+bool IsDamageSpell(SpellInfo const* spell)
+{
+    if (!spell || spell->IsPassive() || spell->IsPositive())
+        return false;
+
+    for (SpellEffectInfo const& effect : spell->Effects)
+        switch (effect.Effect)
+        {
+            case SPELL_EFFECT_SCHOOL_DAMAGE:
+            case SPELL_EFFECT_WEAPON_DAMAGE:
+            case SPELL_EFFECT_WEAPON_DAMAGE_NOSCHOOL:
+            case SPELL_EFFECT_NORMALIZED_WEAPON_DMG:
+            case SPELL_EFFECT_WEAPON_PERCENT_DAMAGE:
+            case SPELL_EFFECT_HEALTH_LEECH:
+            case SPELL_EFFECT_POWER_DRAIN:
+                return true;
+            default:
+                break;
+        }
+
+    return false;
+}
+
+class CoaBrewingAttackAction final : public Action
+{
+public:
+    explicit CoaBrewingAttackAction(PlayerbotAI* ai) : Action(ai, "coa brewing attack") {}
+
+    bool Execute(Event) override
+    {
+        Unit* target = AI_VALUE(Unit*, "current target");
+        if (!target || !target->IsAlive())
+            return false;
+
+        Player* bot = botAI->GetBot();
+        std::vector<SpellInfo const*> candidates;
+        for (auto const& [spellId, playerSpell] : bot->GetSpellMap())
+        {
+            if (!playerSpell->Active || playerSpell->State == PLAYERSPELL_REMOVED)
+                continue;
+            SpellInfo const* spell = sSpellMgr->GetSpellInfo(spellId);
+            if (IsDamageSpell(spell) && !ShouldReserveBrewingMana(botAI, spell))
+                candidates.push_back(spell);
+        }
+
+        std::sort(candidates.begin(), candidates.end(), [](SpellInfo const* left, SpellInfo const* right)
+        {
+            if (left->SpellLevel != right->SpellLevel)
+                return left->SpellLevel > right->SpellLevel;
+            return left->Id > right->Id;
+        });
+
+        for (SpellInfo const* spell : candidates)
+            if (botAI->CanCastSpell(spell->Id, target) && botAI->CastSpell(spell->Id, target))
+                return true;
+
+        return false;
+    }
+
+    bool isUseful() override { return AI_VALUE(Unit*, "current target") != nullptr; }
+    ActionThreatType getThreatType() override { return ActionThreatType::Single; }
+};
+
+class CoaBrewingHealAction final : public Action
+{
+public:
+    explicit CoaBrewingHealAction(PlayerbotAI* ai) : Action(ai, "coa brewing heal") {}
+
+    bool Execute(Event) override
+    {
+        Player* bot = botAI->GetBot();
+        Player* target = FindBrewingHealTarget(bot);
+        if (!target)
+            return false;
+
+        if (target->GetHealthPct() < BREWING_CRITICAL_HEALTH_PCT &&
+            CastFirstAvailableHeal(botAI, bot, target, SPIRIT_IN_A_BOTTLE))
+            return true;
+
+        if (target->GetHealthPct() < 65.0f &&
+            CastFirstAvailableHeal(botAI, bot, target, POTION_TOSS))
+            return true;
+
+        return CastFirstAvailableHeal(botAI, bot, target, LOAS_BREW);
+    }
+
+    bool isUseful() override { return FindBrewingHealTarget(botAI->GetBot()) != nullptr; }
+    ActionThreatType getThreatType() override { return ActionThreatType::Aoe; }
+};
+
+class CoaBrewingStrategy final : public CombatStrategy
+{
+public:
+    explicit CoaBrewingStrategy(PlayerbotAI* ai) : CombatStrategy(ai) {}
+    std::string const getName() override { return "coa brewing"; }
+    uint32 GetType() const override { return STRATEGY_TYPE_COMBAT | STRATEGY_TYPE_HEAL | STRATEGY_TYPE_RANGED; }
+    void InitTriggers(std::vector<TriggerNode*>& triggers) override
+    {
+        CombatStrategy::InitTriggers(triggers);
+        InitBrewingRecoveryTriggers(triggers);
+    }
+    std::vector<NextAction> getDefaultActions() override
+    {
+        return {NextAction("coa brewing heal", ACTION_HIGH), NextAction("coa brewing attack", ACTION_NORMAL),
+                NextAction("melee", ACTION_DEFAULT)};
+    }
+};
+
+class CoaBrewingRecoveryStrategy final : public Strategy
+{
+public:
+    explicit CoaBrewingRecoveryStrategy(PlayerbotAI* ai) : Strategy(ai) {}
+    std::string const getName() override { return "coa brewing recovery"; }
+    uint32 GetType() const override { return STRATEGY_TYPE_HEAL; }
+    void InitTriggers(std::vector<TriggerNode*>& triggers) override
+    {
+        InitBrewingRecoveryTriggers(triggers);
+    }
+    std::vector<NextAction> getDefaultActions() override
+    {
+        return {NextAction("coa brewing heal", ACTION_NORMAL)};
+    }
+};
+
+class CoaStrategyFactory final : public NamedObjectContext<Strategy>
+{
+public:
+    CoaStrategyFactory()
+    {
+        creators["coa brewing"] = [](PlayerbotAI* ai) -> Strategy* { return new CoaBrewingStrategy(ai); };
+        creators["coa brewing recovery"] = [](PlayerbotAI* ai) -> Strategy* { return new CoaBrewingRecoveryStrategy(ai); };
+    }
+};
+
+class CoaActionFactory final : public NamedObjectContext<Action>
+{
+public:
+    CoaActionFactory()
+    {
+        creators["coa brewing attack"] = [](PlayerbotAI* ai) -> Action* { return new CoaBrewingAttackAction(ai); };
+        creators["coa brewing heal"] = [](PlayerbotAI* ai) -> Action* { return new CoaBrewingHealAction(ai); };
+        creators["coa brewing reach"] = [](PlayerbotAI* ai) -> Action* { return new CoaBrewingReachAction(ai); };
+    }
+};
+
+class CoaTriggerFactory final : public NamedObjectContext<Trigger>
+{
+public:
+    CoaTriggerFactory()
+    {
+        creators["coa brewing urgent"] = [](PlayerbotAI* ai) -> Trigger*
+            { return new CoaBrewingHealthTrigger(ai, "coa brewing urgent", BREWING_CRITICAL_HEALTH_PCT); };
+        creators["coa brewing wounded"] = [](PlayerbotAI* ai) -> Trigger*
+            { return new CoaBrewingHealthTrigger(ai, "coa brewing wounded", BREWING_HEAL_BELOW_PCT); };
+        creators["coa brewing reach"] = [](PlayerbotAI* ai) -> Trigger* { return new CoaBrewingReachTrigger(ai); };
+    }
+};
+}
+
+void RegisterCoaBrewingSharedContexts(
+    SharedNamedObjectContextList<Strategy>& sharedStrategyContexts,
+    SharedNamedObjectContextList<Action>& sharedActionContexts,
+    SharedNamedObjectContextList<Trigger>& sharedTriggerContexts)
+{
+    sharedStrategyContexts.Add(new CoaStrategyFactory());
+    sharedActionContexts.Add(new CoaActionFactory());
+    sharedTriggerContexts.Add(new CoaTriggerFactory());
+}
