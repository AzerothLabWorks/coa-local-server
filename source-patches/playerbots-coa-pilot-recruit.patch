+ */
+#ifndef PLAYERBOTS_COATESTPILOTACCESS_H
+#define PLAYERBOTS_COATESTPILOTACCESS_H
+
+#include <algorithm>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// An explicit test allowlist, not a prefix or wildcard match. Invalid input
+// disables the exception. At most four named companions can form a party.
+inline std::vector<std::string> ParseCoaTestPilotNames(std::string_view input)
+{
+    std::vector<std::string> names;
+    if (input.empty())
+        return names;
+
+    std::size_t start = 0;
+    while (start <= input.size())
+    {
+        std::size_t const comma = input.find(',', start);
+        std::string_view token = input.substr(start,
+            comma == std::string_view::npos ? input.size() - start : comma - start);
+        std::size_t const first = token.find_first_not_of(" \t\r\n");
+        if (first == std::string_view::npos)
+            return {};
+        token = token.substr(first, token.find_last_not_of(" \t\r\n") - first + 1);
+        if (token.size() < 2 || token.size() > 12)
+            return {};
+
+        std::string name;
+        for (char value : token)
+        {
+            if (!((value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z')))
+                return {};
+            name.push_back(value >= 'A' && value <= 'Z' ? char(value - 'A' + 'a') : value);
+        }
+        name[0] = char(name[0] - 'a' + 'A');
+        if (std::find(names.begin(), names.end(), name) == names.end())
+            names.push_back(name);
+        if (names.size() > 4)
+            return {};
+        if (comma == std::string_view::npos)
+            break;
+        start = comma + 1;
+    }
+    return names;
+}
+
+constexpr bool CanRecruitCoaTestPilot(bool realGameMaster, bool generatedAccount, bool unassignedAccount,
+    bool offline, bool groupAllowed, std::uint8_t classId, std::uint8_t botLevel,
+    std::uint8_t masterLevel, std::uint32_t specializationId)
+{
+    // The first supported pilot is Brewing (Witch Doctor class 13, spec 6).
+    return realGameMaster && generatedAccount && unassignedAccount && offline && groupAllowed &&
+        classId == 13 && botLevel > 0 && botLevel <= masterLevel &&
+        (specializationId == 0 || specializationId == 6);
+}
+
+#endif
