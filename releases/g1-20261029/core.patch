+#include <cstdint>
+#include <filesystem>
+#include <iostream>
+#include <optional>
+#include <stdexcept>
+#include <string>
+#include <system_error>
+#include <vector>
+
+using uint32 = std::uint32_t;
+
+struct Inputs
+{
+    uint32 globalMask = 7;
+    std::optional<bool> safeProfiles;
+    bool updatesEnabled = true;
+    bool schemaExists = true;
+    bool loadSucceeded = true;
+    bool updateSucceeded = true;
+    std::string recipe = "valid";
+};
+
+struct Observed
+{
+    uint32 registeredMask = 0;
+    bool registered = false;
+    bool populated = false;
+    bool vendorUpdated = false;
+    bool loaded = false;
+    bool safeUpdated = false;
+    bool sourceDirectoryRequested = false;
+    uint32 loggedErrors = 0;
+    std::vector<std::string> directories;
+};
+
+Inputs inputs;
+Observed observed;
+std::filesystem::path fixtureRoot;
+
+template<class... Args>
+void FixtureLogError(char const*, char const*, Args const&...)
+{
+    ++observed.loggedErrors;
+}
+
+#define LOG_ERROR(...) FixtureLogError(__VA_ARGS__)
+
+struct FixtureConfig
+{
+    template<class T>
+    T GetOption(char const* name, T fallback)
+    {
+        if (std::string(name) == "Playerbots.Updates.CoaSafeProfiles")
+            return inputs.safeProfiles.value_or(fallback);
+        if (std::string(name) == "Playerbots.Updates.EnableDatabases")
+            return inputs.updatesEnabled;
+        throw std::runtime_error("Unexpected configuration access");
+    }
+};
+
+FixtureConfig config;
+FixtureConfig* sConfigMgr = &config;
+
+struct PlayerbotsDatabaseConnection
+{
+};
+
+int PlayerbotsDatabase = 0;
+
+class DatabaseLoader
+{
+public:
+    static constexpr uint32 DATABASE_PLAYERBOTS = 8;
+
+    explicit DatabaseLoader(char const*) : _updateFlags(inputs.globalMask) {}
+
+#include "LoaderMethods.h"
+
+    void AddDatabase(int&, char const* name)
+    {
+        if (std::string(name) != "Playerbots")
+            throw std::runtime_error("Unexpected database registered");
+        observed.registered = true;
+        observed.registeredMask = _updateFlags;
+    }
+
+    bool Load()
+    {
+        observed.loaded = true;
+        bool const updaterEnabled = (observed.registeredMask & DATABASE_PLAYERBOTS) != 0;
+        observed.populated = !inputs.schemaExists && updaterEnabled;
+        observed.vendorUpdated = updaterEnabled;
+        return inputs.loadSucceeded && (inputs.schemaExists || updaterEnabled);
+    }
+
+private:
+    uint32 _updateFlags;
+};
+
+template<class T>
+struct DBUpdater
+{
+    static std::string GetSourceDirectory()
+    {
+        observed.sourceDirectoryRequested = true;
+        return (fixtureRoot / inputs.recipe / "modules" / "mod-playerbots").generic_string();
+    }
+
+    static bool Update(int&, std::vector<std::string> const* directories)
+    {
+        if (!observed.loaded)
+            throw std::runtime_error("Safe updater called before database loading");
+        observed.safeUpdated = true;
+        observed.directories = *directories;
+        return inputs.updateSucceeded;
+    }
+};
+
+#include "LoaderPolicy.h"
+
+void Require(bool condition, std::string const& message)
+{
+    if (!condition)
+        throw std::runtime_error(message);
+}
+
+void Reset()
+{
+    inputs = Inputs{};
+    observed = Observed{};
+}
+
+int main(int argc, char** argv)
+{
+    Require(argc == 2, "The isolated filesystem fixture root is required");
+    fixtureRoot = std::filesystem::path(argv[1]);
+    Require(fixtureRoot.is_absolute(), "The isolated filesystem fixture root must be absolute");
+    for (uint32 mask : {0u, 7u, 8u, 15u, 0xffffffffu})
+    {
+        for (bool enabled : {false, true})
+        {
+            for (std::optional<bool> safe : {std::optional<bool>{}, std::optional<bool>{true},
+                                            std::optional<bool>{false}})
+            {
+                Reset();
+                inputs.globalMask = mask;
+                inputs.safeProfiles = safe;
+                inputs.updatesEnabled = enabled;
+                bool const safeEnabled = safe.value_or(true);
+                Require(RunProductionLoader(), "Valid existing schema was rejected");
+                uint32 const expectedMask = (mask & ~8u) | (!safeEnabled && enabled ? 8u : 0u);
+                Require(observed.registered && observed.registeredMask == expectedMask,
+                        "PB mask clearing did not preserve every other bit before registration");
+                Require(observed.vendorUpdated == (!safeEnabled && enabled),
+                        "Vendor path did not require explicit unsafe opt-in and updates enabled");
+                Require(observed.safeUpdated == (safeEnabled && enabled),
+                        "Safe updater ignored its configuration gate");
+                Require(observed.sourceDirectoryRequested == (safeEnabled && enabled),
+                        "Disabled or legacy updates touched the safe migration recipe");
+                Require(!observed.loggedErrors, "Valid migration recipe was rejected");
+                Require(!observed.populated, "Existing schema was unexpectedly populated");
+                if (observed.safeUpdated)
+                    Require(observed.directories ==
+                                std::vector<std::string>{"/../../data/sql/updates/pending_db_playerbots"},
+                            "Safe updater scanned anything beyond the pending owner-zero directory");
+            }
+        }
+    }
+
+    Reset();
+    inputs.globalMask = 15;
+    inputs.schemaExists = false;
+    Require(!RunProductionLoader(), "Safe mode accepted a missing PB schema");
+    Require(!observed.populated && !observed.vendorUpdated && !observed.safeUpdated,
+            "Missing-schema failure fell back to vendor population or updates");
+
+    Reset();
+    inputs.loadSucceeded = false;
+    Require(!RunProductionLoader() && !observed.safeUpdated, "Failed loading still ran the safe updater");
+
+    Reset();
+    inputs.updateSucceeded = false;
+    Require(!RunProductionLoader() && observed.safeUpdated, "Safe updater failure was ignored");
+
+    Reset();
+    DatabaseLoader loader("mask fixture");
+    loader.ClearUpdateFlags(1 | 4);
+    loader.AddDatabase(PlayerbotsDatabase, "Playerbots");
+    Require(observed.registeredMask == 2, "Generic ClearUpdateFlags did not clear only its selected bits");
+
+    for (char const* recipe : {"missing-directory", "missing-metadata", "missing-rotations",
+                              "metadata-directory", "rotations-directory", "metadata-error", "rotations-error"})
+    {
+        std::string const recipeName = recipe;
+        if (recipeName == "metadata-error" || recipeName == "rotations-error")
+        {
+            char const* filename = recipeName == "metadata-error" ? "rev_20261004_00_coa_metadata.sql" :
+                "rev_20261004_00_coa_rotations.sql";
+            std::filesystem::path const path = fixtureRoot / recipeName /
+                "data/sql/updates/pending_db_playerbots" / filename;
+            std::error_code error;
+            Require(!std::filesystem::is_regular_file(path, error) && bool(error),
+                    "The error recipe did not produce a non-throwing filesystem error");
+        }
+        Reset();
+        inputs.globalMask = 15;
+        inputs.recipe = recipe;
+        Require(!RunProductionLoader(), "Safe updates accepted missing or inaccessible migration files");
+        Require(observed.loaded && observed.sourceDirectoryRequested && observed.loggedErrors == 1,
+                "Unsafe migration recipe was not checked and reported");
+        Require(!observed.safeUpdated && !observed.vendorUpdated && !observed.populated,
+                "Migration file failure reached an updater or vendor fallback");
+
+        Reset();
+        inputs.recipe = recipe;
+        inputs.updatesEnabled = false;
+        Require(RunProductionLoader() && !observed.sourceDirectoryRequested && !observed.loggedErrors &&
+                    !observed.safeUpdated && !observed.vendorUpdated,
+                "Disabled updates checked migration files or invoked an updater");
+
+        Reset();
+        inputs.recipe = recipe;
+        inputs.safeProfiles = false;
+        Require(RunProductionLoader() && !observed.sourceDirectoryRequested && !observed.loggedErrors &&
+                    !observed.safeUpdated && observed.vendorUpdated,
+                "Explicit legacy opt-in used the safe migration file guard");
+    }
+
+    std::cout << "Extracted loader policy: 30 configuration/mask, four failure/method and "
+                 "21 migration recipe cases passed\n";
+}
