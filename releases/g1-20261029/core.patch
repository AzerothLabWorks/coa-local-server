+// NATIVE_SOURCE
+
+int main()
+{
+    InstanceScript instance;
+    Map map;
+    map.Script = &instance;
+    Group group;
+    WorldSession session;
+    Player player;
+    player.Session = &session;
+    player.CurrentMap = &map;
+    player.CurrentGroup = &group;
+    Player other;
+    DungeonEncounterEntry dbc;
+    DungeonEncounter encounter{&dbc, ENCOUNTER_CREDIT_KILL_CREATURE, 18373, 149};
+    objectManager.Encounters.push_back(&encounter);
+    lfg_objective_dungeon responder;
+    unsigned checks = 0;
+    auto check = [&](bool value) { ++checks; assert(value); };
+    auto query = [&](std::string payload = "Q|1|n_1-X", bool advance = true)
+    {
+        if (advance)
+            clockMs += 1000;
+        session.Packets.clear();
+        std::string message = "COA_LFG_STATUS\t" + payload;
+        check(!responder.OnPlayerCanUseChat(&player, CHAT_MSG_WHISPER, LANG_ADDON, message, &player));
+        return session.Packets.empty() ? std::string() : session.Packets.back().Payload;
+    };
+    std::string const snapshot = "COA_LFG_STATUS\tS|1|n_1-X|558|0|17|18446462598732840961|149|202|0|18373|";
+    std::string const neutral = "COA_LFG_STATUS\tN|1|n_1-X";
+    check(query() == snapshot + "0");
+    check(player.GameMaster && session.Packets.back().Opcode == 0x096);
+    check(query("Q|1|n_1-X", false).empty());
+    clockMs += 999;
+    check(query("Q|1|n_1-X", false).empty());
+    ++clockMs;
+    check(query("Q|1|n_1-X", false) == snapshot + "0");
+    lfgManager.State = lfg::LFG_STATE_FINISHED_DUNGEON;
+    check(query() == snapshot + "0");
+    instance.Mask = 1;
+    check(query() == snapshot + "0");
+    instance.Mask = 3;
+    check(query() == snapshot + "1");
+    lfgManager.State = lfg::LFG_STATE_DUNGEON;
+    check(query() == snapshot + "0");
+    for (auto const& payload : {"", "Q|2|nonce", "S|1|nonce", "Q|1|", "Q|1|a|b", "Q|1|a b", "Q|1|a\tb"})
