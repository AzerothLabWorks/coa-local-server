+    virtual void OnAfterUpdateEncounterState(Map*, EncounterCreditType, uint32, Unit*, Difficulty,
+        DungeonEncounterList const*, uint32, bool) { }
+};
+namespace lfg
+{
+enum LfgType { LFG_TYPE_DUNGEON = 1, LFG_TYPE_HEROIC = 5, LFG_TYPE_RANDOM = 6 };
