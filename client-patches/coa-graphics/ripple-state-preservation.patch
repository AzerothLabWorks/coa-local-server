+        {L"water-real-lake-high", {-20, 0, 40}, {150, -20, -10}, kLakeBasin},
+        {L"water-real-lake-sun", {0, 0, 9}, {100, 12, 6}, kLakeBasin},
+        {L"water-real-classes", {0, 0, 12}, {140, 0, 0}, kClassStrips},
+    };
+    for (const auto& view : views)
+    {
+        vf_test_set_config(&cfg);
