+bool LearnOwnedMount(Player* bot, uint32 id)
+{
+    ++bot->grants;
+    auto const* info = sSpellMgr->GetSpellInfo(id);
+    if (!bot->session.bot || bot->classId < 12 || bot->classId > 32 || bot->riding < 75 ||
+        !bot->ownership || !info || !info->HasAura(SPELL_AURA_MOUNTED))
+        return false;
+    bot->spells.insert(id);
+    return true;
+}
