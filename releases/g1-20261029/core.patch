@@ -0,0 +1,134 @@
+import argparse
+import importlib.util
+import os
+from pathlib import Path
+import sqlite3
+import struct
+import unittest
+
+
+ROOT = Path(__file__).resolve().parents[3]
+MIGRATION = ROOT / 'data/sql/updates/pending_db_world/rev_1792365477029742178.sql'
+LEGACY = [
+    (259, 64, 24887, 24895),
+    (259, 70, 24888, 24896),
+    (260, 70, 24922, 24923),
+    (261, 80, 24790, 24791),
+    (262, 80, 24788, 24789),
+]
+ADDED = [
+    (417, 64, 24887, 24895),
+    (417, 70, 24888, 24896),
+    (418, 70, 24922, 24923),
+    (465, 80, 24790, 24791),
+    (466, 80, 24788, 24789),
+]
+UNRELATED = [(258, 60, 24886, 24894), (1258, 60, 90189, 90191), (2258, 60, 90209, 90211),
+             (285, 80, 25482, 0), (98765, 80, 54321, 54322)]
+
+
+class ExpansionRewards(unittest.TestCase):
+    dbc_dir = None
+
+    def setUp(self):
+        self.db = sqlite3.connect(':memory:')
+        self.addCleanup(self.db.close)
+        self.db.execute('CREATE TABLE lfg_dungeon_rewards ('
+                        'dungeonId INTEGER, maxLevel INTEGER, firstQuestId INTEGER, otherQuestId INTEGER, '
+                        'PRIMARY KEY(dungeonId,maxLevel))')
+        self.db.executemany('INSERT INTO lfg_dungeon_rewards VALUES (?,?,?,?)', LEGACY + UNRELATED)
+
+    def rows(self):
+        return self.db.execute('SELECT * FROM lfg_dungeon_rewards ORDER BY dungeonId,maxLevel').fetchall()
+
+    def migrate(self):
+        self.db.executescript(MIGRATION.read_text(encoding='utf-8'))
+
+    def reward(self, dungeon, level):
+        rows = self.db.execute('SELECT * FROM lfg_dungeon_rewards WHERE dungeonId=? ORDER BY maxLevel',
+                               (dungeon & 0x00ffffff,)).fetchall()
+        return next((row for row in rows if row[1] >= level), rows[-1] if rows else None)
+
+    def test_missing_expansion_rewards_reproduced_then_fixed(self):
+        cases = [(417, 64, 24887, 24895), (417, 65, 24888, 24896), (418, 70, 24922, 24923),
+                 (465, 71, 24790, 24791), (466, 80, 24788, 24789)]
+        for dungeon, level, first, repeat in cases:
+            self.assertIsNone(self.reward(dungeon, level))
+        before = self.rows()
+        self.migrate()
+        for dungeon, level, first, repeat in cases:
+            self.assertEqual(self.reward(dungeon, level)[2:], (first, repeat))
+            self.assertEqual(self.reward(dungeon | (6 << 24), level)[2:], (first, repeat))
+        self.assertEqual(self.rows(), sorted(before + ADDED))
+
+    def test_reapplication_is_identical(self):
+        self.migrate()
+        once = self.rows()
+        self.migrate()
+        self.assertEqual(self.rows(), once)
+
+    def test_custom_destination_and_other_brackets_are_preserved(self):
+        custom = [(417, 64, 60001, 60002), (465, 75, 60003, 60004)]
+        self.db.executemany('INSERT INTO lfg_dungeon_rewards VALUES (?,?,?,?)', custom)
+        self.migrate()
+        self.migrate()
+        self.assertEqual(self.rows(), sorted(LEGACY + UNRELATED + custom + ADDED[1:]))
+
+    def test_custom_legacy_rewards_are_not_reinterpreted(self):
+        self.db.execute('UPDATE lfg_dungeon_rewards SET firstQuestId=60005 WHERE dungeonId=259 AND maxLevel=64')
+        before = self.rows()
+        self.migrate()
+        self.assertEqual(self.rows(), sorted(before + ADDED[1:]))
+
+    def test_missing_legacy_reward_does_not_create_a_new_default(self):
+        self.db.execute('DELETE FROM lfg_dungeon_rewards WHERE dungeonId=259 AND maxLevel=64')
+        before = self.rows()
+        self.migrate()
+        self.assertEqual(self.rows(), sorted(before + ADDED[1:]))
+
+    def test_installed_reward_survives_legacy_removal_on_replay(self):
+        self.migrate()
+        self.db.execute('DELETE FROM lfg_dungeon_rewards WHERE dungeonId=259 AND maxLevel=64')
+        before = self.rows()
+        self.migrate()
+        self.assertEqual(self.rows(), before)
+        self.assertEqual(self.reward(417, 64)[2:], (24887, 24895))
+
+    def test_installed_reward_survives_legacy_customization_on_replay(self):
+        self.migrate()
+        self.db.execute('UPDATE lfg_dungeon_rewards SET firstQuestId=60005 WHERE dungeonId=259 AND maxLevel=64')
+        before = self.rows()
+        self.migrate()
+        self.assertEqual(self.rows(), before)
+        self.assertEqual(self.reward(417, 64)[2:], (24887, 24895))
+
+    def test_classic_holiday_and_mythic_rewards_are_unchanged(self):
+        before = {dungeon: self.reward(dungeon, level) for dungeon, level, _, _ in UNRELATED}
+        self.migrate()
+        for dungeon, level, _, _ in UNRELATED:
+            self.assertEqual(self.reward(dungeon, level), before[dungeon])
+        for dungeon in (419, 467):
+            self.assertIsNone(self.reward(dungeon, 80))
+
+    def test_accepted_dbc_maps_targets_to_matching_random_groups(self):
+        spec = importlib.util.spec_from_file_location('coa_client_dbc', ROOT / 'apps/coa-dbc/client_dbc.py')
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        table = module.Table.read(self.dbc_dir / 'LFGDungeons.dbc')
+        self.assertEqual((table.fields, table.record_size), (49, 196))
+        rows = {fields[0]: fields for index in range(table.rows)
+                for fields in [struct.unpack('<49I', table.record(index))]}
+        for dungeon, expansion, group in ((417, 1, 2), (418, 1, 3), (465, 2, 4), (466, 2, 5)):
+            self.assertEqual((rows[dungeon][26], rows[dungeon][29], rows[dungeon][31]), (6, expansion, group))
+        self.assertEqual((rows[149][23], rows[149][24], rows[149][31]), (558, 0, 2))
+        self.assertEqual(rows[259][26], 1)
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--dbc-dir', type=Path, default=os.environ.get('COA_DBC_DIR'))
+    args, remaining = parser.parse_known_args()
+    if args.dbc_dir is None:
+        parser.error('--dbc-dir or COA_DBC_DIR must identify the accepted server DBC directory')
+    ExpansionRewards.dbc_dir = Path(args.dbc_dir).resolve()
+    unittest.main(argv=[__file__, *remaining])
