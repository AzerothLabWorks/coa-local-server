+void AddSlope(std::vector<SceneVertex>& v, float x0, float z0, float x1, float z1, float halfWidth, DWORD colour)
+{
+    AddQuad(v, {x0, -halfWidth, z0}, {x1, -halfWidth, z1}, {x1, halfWidth, z1}, {x0, halfWidth, z0}, colour);
+}
