diff --git a/src/Ai/Class/Coa/CoaRoleProfile.h b/src/Ai/Class/Coa/CoaRoleProfile.h
new file mode 100644
--- /dev/null
+++ b/src/Ai/Class/Coa/CoaRoleProfile.h
@@ -0,0 +1,31 @@
+#ifndef PLAYERBOTS_COAROLEPROFILE_H
+#define PLAYERBOTS_COAROLEPROFILE_H
+
+#include <cstdint>
+
+enum class CoaCombatRole : std::uint8_t
+{
+    Damage,
+    Healer,
+    Tank
+};
+
+struct CoaRoleProfile
+{
+    CoaCombatRole Role;
+    bool Ranged;
+};
+
+// This describes implemented AI profiles, not every role in the repack catalog.
+// Class 13/spec 6 is Witch Doctor Brewing in the installed COA data.
+constexpr CoaRoleProfile GetCoaRoleProfile(std::uint8_t classId, std::uint32_t specializationId)
+{
+    if (classId == 13 && specializationId == 6)
+        return {CoaCombatRole::Healer, true};
+
+    // Unassigned/unsupported specs keep generic offense and the existing
+    // by-spec ranged fallback. No tank role is advertised without tank AI.
+    return {CoaCombatRole::Damage, true};
+}
+
+#endif
