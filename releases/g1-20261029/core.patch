@@ -0,0 +1,199 @@
+import decimal
+import os
+from pathlib import Path
+import re
+import shutil
+import subprocess
+import unittest
+import uuid
+
+
+ROOT = Path(__file__).resolve().parents[3]
+PENDING = ROOT / 'data/sql/updates/pending_db_world'
+KEEPER = PENDING / 'zz_manastorm_treasure_keeper_attackable.sql'
+TUNING = PENDING / 'zz_manastorm_tuning_curve.sql'
+UPSTREAM = 'bfe93aa95a25c4e60c82995df0d93e083f3bba94'
+LIVE_UUID = '08d0dc92-c748-11f1-bd2f-f2a6bbe163a7'
+TABLES = ('manastorm_scaling_curve', 'manastorm_group_scaling')
+
+
+class OptionalModuleSQL(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        config = os.environ.get('COA_G1_OPTIONAL_MYSQL_CONFIG', '')
+        expected = os.environ.get('COA_G1_OPTIONAL_DB_UUID', '')
+        if not config or not expected or not shutil.which('mysql'):
+            raise RuntimeError('UNAVAILABLE: isolated MySQL client config and explicit clone UUID are required')
+        path = Path(config)
+        if not path.is_absolute() or not path.is_file() or path.is_symlink() or path.stat().st_mode & 0o077:
+            raise RuntimeError('Private ordinary isolated MySQL client config required')
+        if not re.fullmatch(r'[0-9a-f-]{36}', expected) or expected == LIVE_UUID:
+            raise RuntimeError('Independent qualification database UUID required')
+        cls.command = ['mysql', '--defaults-extra-file=' + str(path), '--host=127.0.0.1', '--port=3306',
+                       '--batch', '--raw', '--skip-column-names', '--default-character-set=utf8mb4']
+        actual = cls.run_sql('SELECT @@server_uuid;').stdout.strip()
+        if actual != expected:
+            raise RuntimeError('MySQL UUID mismatch; no fixture schemas were created')
+        cls.expected_uuid = expected
+        cls.upstream_tuning = subprocess.check_output(
+            ['git', '-C', str(ROOT), 'show', UPSTREAM + ':' + str(TUNING.relative_to(ROOT))], text=True)
+
+    @classmethod
+    def run_sql(cls, sql, schema=None, success=True):
+        result = subprocess.run(cls.command + (['--database=' + schema] if schema else []), input=sql,
+                                capture_output=True, text=True, timeout=90, check=False)
+        if success and (result.returncode or result.stderr.strip()):
+            raise AssertionError('Fixture SQL failed: ' + result.stderr.strip())
+        return result
+
+    def setUp(self):
+        self.schemas = []
+        self.schema = self.create_schema()
+
+    def create_schema(self):
+        self.assertEqual(self.run_sql('SELECT @@server_uuid;').stdout.strip(), self.expected_uuid)
+        name = 'coa_test_g1_optional_' + uuid.uuid4().hex
+        self.assertRegex(name, r'^coa_test_g1_optional_[0-9a-f]{32}$')
+        self.run_sql('CREATE DATABASE `' + name + '`;')
+        self.schemas.append(name)
+        return name
+
+    def tearDown(self):
+        self.assertEqual(self.run_sql('SELECT @@server_uuid;').stdout.strip(), self.expected_uuid)
+        for name in self.schemas:
+            self.assertRegex(name, r'^coa_test_g1_optional_[0-9a-f]{32}$')
+            self.run_sql('DROP DATABASE `' + name + '`;')
+
+    def sql(self, statement, success=True):
+        return self.run_sql(statement, self.schema, success)
+
+    def rows(self, table, order):
+        return self.sql('SELECT * FROM `' + table + '` ORDER BY ' + order + ';').stdout.strip()
+
+    def make_tuning(self, tables=TABLES, schema=None):
+        target = schema or self.schema
+        for table in tables:
+            if table == TABLES[0]:
+                definition = ('depth INT PRIMARY KEY, health_multiplier DECIMAL(14,6), '
+                              'global_damage_multiplier DECIMAL(14,6), melee_multiplier DECIMAL(14,6), '
+                              'spell_multiplier DECIMAL(14,6)')
+                seed = '(1,99,99,99,99),(2001,7,8,9,10)'
+            else:
+                definition = ('min_members INT PRIMARY KEY, max_members INT, health_multiplier DECIMAL(14,6), '
+                              'global_damage_multiplier DECIMAL(14,6), melee_multiplier DECIMAL(14,6), '
+                              'spell_multiplier DECIMAL(14,6), enabled INT')
+                seed = '(1,1,99,99,99,99,0),(6,8,7,8,9,10,0)'
+            self.run_sql('CREATE TABLE `' + table + '` (' + definition + ') ENGINE=InnoDB; '
+                         'INSERT INTO `' + table + '` VALUES ' + seed + ';', target)
+
+    def make_keeper(self):
+        match = re.search(r'INSERT INTO `creature_template`\s*\((.*?)\)\s*SELECT',
+                          KEEPER.read_text(encoding='utf-8'), re.S)
+        self.assertIsNotNone(match)
+        self.columns = re.findall(r'`(\w+)`', match[1])
+        self.assertIn('unit_flags', self.columns)
+        numeric = {'entry', 'faction', 'npcflag', 'unit_flags', 'type'}
+        fields = [f'`{name}` ' + ('BIGINT' if name in numeric else 'VARCHAR(255)') + " DEFAULT '0'"
+                  for name in self.columns]
+        self.sql('CREATE TABLE creature_template (' + ','.join(fields) + ',PRIMARY KEY(entry)) ENGINE=InnoDB;'
+                 'CREATE TABLE creature_template_model (CreatureID INT, Idx INT, CreatureDisplayID INT, '
+                 'DisplayScale DECIMAL(8,4), Probability DECIMAL(8,4), VerifiedBuild INT, '
+                 'PRIMARY KEY(CreatureID,Idx)) ENGINE=InnoDB;'
+                 "INSERT INTO creature_template(entry,name,faction,npcflag,unit_flags,type) VALUES "
+                 "(10111377,'donor',35,1,832,12),(900026,'retained-name',35,1,832,12),(42,'unrelated',1,2,3,4);"
+                 'INSERT INTO creature_template_model VALUES '
+                 '(10111377,0,123,1,1,0),(900026,1,456,1,1,0),(42,0,789,1,1,0);')
+
+    def add_keeper_rule(self):
+        self.sql('CREATE TABLE manastorm_treasure_keeper_rule '
+                 '(rule_id INT PRIMARY KEY,creature_entry INT) ENGINE=InnoDB;'
+                 'INSERT INTO manastorm_treasure_keeper_rule VALUES (1,10111377),(2,10111377),(3,42);')
+
+    def keeper_snapshot(self):
+        return [self.rows('creature_template', 'entry'), self.rows('creature_template_model', 'CreatureID,Idx')]
+
+    def test_absent_module_is_a_complete_noop(self):
+        self.make_keeper()
+        before = self.keeper_snapshot()
+        tables = self.sql('SHOW TABLES;').stdout
+        for _ in range(2):
+            self.sql(KEEPER.read_text(encoding='utf-8'))
+            self.sql(TUNING.read_text(encoding='utf-8'))
+        self.assertEqual(self.keeper_snapshot(), before)
+        self.assertEqual(self.sql('SHOW TABLES;').stdout, tables)
+
+    def test_foreign_database_tables_do_not_enable_optional_content(self):
+        self.make_keeper()
+        other = self.create_schema()
+        self.make_tuning(schema=other)
+        self.run_sql('CREATE TABLE manastorm_treasure_keeper_rule '
+                     '(rule_id INT PRIMARY KEY,creature_entry INT) ENGINE=InnoDB;', other)
+        before = self.keeper_snapshot()
+        self.sql(KEEPER.read_text(encoding='utf-8'))
+        self.sql(TUNING.read_text(encoding='utf-8'))
+        self.assertEqual(self.keeper_snapshot(), before)
+
+    def test_installed_tuning_preserves_values_and_unrelated_rows(self):
+        self.make_tuning()
+        expected = {}
+        for table in TABLES:
+            match = re.search(r'INSERT INTO `' + table + r'`\s*\([^;]*?\) VALUES\s*(.*?);',
+                              self.upstream_tuning, re.S)
+            self.assertIsNotNone(match)
+            expected[table] = [tuple(decimal.Decimal(cell.strip()) for cell in row.split(','))
+                               for row in re.findall(r'\(([^()]*)\)', match[1])]
+        self.assertEqual(len(expected[TABLES[0]]), 2000)
+        self.assertEqual(len(expected[TABLES[1]]), 5)
+        expected[TABLES[0]].append(tuple(map(decimal.Decimal, (2001, 7, 8, 9, 10))))
+        expected[TABLES[1]].append(tuple(map(decimal.Decimal, (6, 8, 7, 8, 9, 10, 0))))
+        for _ in range(2):
+            self.sql(TUNING.read_text(encoding='utf-8'))
+            for table in TABLES:
+                actual = [tuple(decimal.Decimal(cell) for cell in row.split('\t'))
+                          for row in self.rows(table, '1').splitlines()]
+                self.assertEqual(actual, expected[table])
+
+    def test_each_partial_tuning_schema_fails_and_rolls_back(self):
+        for present in TABLES:
+            with self.subTest(present=present):
+                self.make_tuning((present,))
+                before = self.rows(present, '1')
+                result = self.sql(TUNING.read_text(encoding='utf-8'), success=False)
+                self.assertNotEqual(result.returncode, 0)
+                missing = next(table for table in TABLES if table != present)
+                self.assertIn(missing, result.stderr)
+                self.assertEqual(self.rows(present, '1'), before)
+                self.sql('DROP TABLE `' + present + '`;')
+
+    def test_installed_keeper_preserves_unrelated_fields_and_replays(self):
+        self.make_keeper()
+        self.add_keeper_rule()
+        before = dict((row.split('\t')[0], row.split('\t'))
+                      for row in self.rows('creature_template', 'entry').splitlines())
+        expected = dict((key, list(value)) for key, value in before.items())
+        for field, value in {'faction': '14', 'npcflag': '0', 'unit_flags': '64', 'type': '7'}.items():
+            expected['900026'][self.columns.index(field)] = value
+        for _ in range(2):
+            self.sql(KEEPER.read_text(encoding='utf-8'))
+            actual = dict((row.split('\t')[0], row.split('\t'))
+                          for row in self.rows('creature_template', 'entry').splitlines())
+            self.assertEqual(actual, expected)
+            self.assertEqual(self.rows('manastorm_treasure_keeper_rule', 'rule_id'),
+                             '1\t900026\n2\t10111377\n3\t42')
+            self.assertEqual(self.rows('creature_template_model', 'CreatureID,Idx'),
+                             '42\t0\t789\t1.0000\t1.0000\t0\n'
+                             '900026\t0\t123\t1.0000\t1.0000\t0\n'
+                             '10111377\t0\t123\t1.0000\t1.0000\t0')
+
+    def test_installed_keeper_can_create_private_template(self):
+        self.make_keeper()
+        self.add_keeper_rule()
+        self.sql('DELETE FROM creature_template WHERE entry=900026;')
+        self.sql(KEEPER.read_text(encoding='utf-8'))
+        self.assertEqual(self.sql('SELECT name,faction,npcflag,unit_flags,type FROM creature_template '
+                                  'WHERE entry=900026;').stdout.strip(),
+                         'Manastorm Treasure Keeper\t14\t0\t64\t7')
+
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
