+
+bool CheckMountStateAction::TryUpgradeMasterMount(Player* master, bool noAttackers)
+{
+    if (!master || master == bot || !master->IsMounted())
+    {
+        failedMountUpgradeSpellId = 0;
+        return false;
+    }
+
+    auto const& mountAuras = master->GetAuraEffectsByType(SPELL_AURA_MOUNTED);
+    if (mountAuras.empty())
+    {
+        failedMountUpgradeSpellId = 0;
+        return false;
+    }
+
+    SpellInfo const* spellInfo = mountAuras.front()->GetSpellInfo();
+    uint32 const spellId = spellInfo->Id;
+    if (failedMountUpgradeSpellId != spellId)
+        failedMountUpgradeSpellId = 0;
+
+    if (!bot->GetSession() || !bot->GetSession()->IsBot() ||
+        !master->GetSession() || master->GetSession()->IsBot() || !botAI->HasGameClientMaster() ||
+        !botAI->HasStrategy("mount", BOT_STATE_NON_COMBAT) ||
+        bot->getClass() < 12 || bot->getClass() > 32 || !bot->GetGroup() ||
+        bot->GetGroup() != master->GetGroup() || bot->GetMapId() != master->GetMapId() ||
+        bot->InBattleground() || !noAttackers ||
+        master->IsInCombat() || bot->IsInCombat() || botAI->GetState() == BOT_STATE_COMBAT ||
+        !master->IsAlive() || !master->IsInWorld() || master->IsBeingTeleported() ||
+        !bot->IsAlive() || !bot->IsInWorld() || bot->IsBeingTeleported() ||
+        !master->IsFlying() || !bot->IsMounted() || bot->IsFlying() ||
+        bot->HasIncreaseMountedFlightSpeedAura() || bot->HasFlyAura() ||
+        bot->HasUnitState(UNIT_STATE_IN_FLIGHT) ||
+        bot->HasUnitMovementFlag(MOVEMENTFLAG_FALLING | MOVEMENTFLAG_FALLING_FAR) ||
+        bot->IsNonMeleeSpellCast(true) || failedMountUpgradeSpellId == spellId ||
+        !spellInfo->HasAura(SPELL_AURA_MOUNTED) ||
+        !spellInfo->HasAura(SPELL_AURA_MOD_INCREASE_MOUNTED_FLIGHT_SPEED))
+        return false;
+
+    float const groundLevel = bot->GetMapWaterOrGroundLevel(bot->GetPositionX(), bot->GetPositionY(), bot->GetPositionZ());
+    if (!std::isfinite(groundLevel) || !std::isfinite(bot->GetPositionZ()) ||
+        groundLevel == INVALID_HEIGHT || groundLevel == VMAP_INVALID_HEIGHT_VALUE ||
+        std::abs(bot->GetPositionZ() - groundLevel) > 2.0f)
+        return false;
+
+    if (!bot->HasSpell(spellId) && !AscensionBotMounts::LearnOwnedMount(bot, spellId))
+        return false;
+
+    if (!bot->HasSpell(spellId) || bot->HasSpellCooldown(spellId) ||
+        spellInfo->CheckLocation(bot->GetMapId(), bot->GetZoneId(), bot->GetAreaId(), bot) != SPELL_CAST_OK)
+        return false;
+
+    if (bot->isMoving())
+        bot->StopMoving();
+
+    Spell preflight(bot, spellInfo, TRIGGERED_IGNORE_CASTER_MOUNTED_OR_ON_VEHICLE);
+    preflight.m_targets.SetUnitTarget(bot);
+    if (preflight.CheckCast(true) != SPELL_CAST_OK)
+        return false;
+
+    Dismount();
+    if (botAI->CanCastSpell(spellId, bot) && botAI->CastSpell(spellId, bot))
+        return true;
+
+    failedMountUpgradeSpellId = spellId;
     return false;
 }
 
