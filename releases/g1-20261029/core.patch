+++ b/apps/coa-tests/g1_social_adapter/run.py
@@ -0,0 +1,68 @@
+CLI_DESCRIPTION = "Compile actual direct-chat routing and delayed delivery against bounded lifecycle fixtures."
+
+import os
+from pathlib import Path
+import re
+import shlex
+import shutil
+import subprocess
+import tempfile
+
+
+ROOT = Path(__file__).resolve().parents[3]
+HERE = Path(__file__).resolve().parent
+SOURCE = ROOT / "modules/mod-playerbots/src/Util"
+
+
+def method(source, signature):
+    start = source.index(signature)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth and end < len(source):
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    if depth:
+        raise RuntimeError("Unterminated production method: " + signature)
+    return source[start:end]
+
+
+def main():
+    compiler = os.environ.get("CXX") or shutil.which("c++") or shutil.which("g++") or shutil.which("clang++")
+    if not compiler:
+        raise RuntimeError("A portable C++ compiler is required")
+    production = (SOURCE / "BotSocialChat.cpp").read_text(encoding="utf-8")
+    clock = ("return std::chrono::duration_cast<std::chrono::milliseconds>(\n"
+             "        std::chrono::steady_clock::now().time_since_epoch()).count();")
+    if production.count(clock) != 1:
+        raise RuntimeError("Direct-chat monotonic clock seam changed")
+    production = production.replace(clock, "return FixtureNow;")
+    ai = (ROOT / "modules/mod-playerbots/src/Bot/PlayerbotAI.cpp").read_text(encoding="utf-8")
+    gate = method(ai, "bool PlayerbotAI::IsSocialChatRequest(")
+    channel = (ROOT / "src/server/game/Chat/Channels/Channel.h").read_text(encoding="utf-8")
+    membership = method(channel, "bool HasMember(ObjectGuid who) const")
+    position = channel.index("bool HasMember(ObjectGuid who) const")
+    if channel.rfind("public:", 0, position) < max(channel.rfind("private:", 0, position),
+                                                  channel.rfind("protected:", 0, position)):
+        raise RuntimeError("Exact channel membership accessor must be publicly callable")
+    if not re.search(r'case SMSG_MESSAGECHAT:[^\n]*\n\s*case SMSG_GM_MESSAGECHAT:\s*\{', ai):
+        raise RuntimeError("Ordinary and GM chat opcodes must both enter the existing chat packet parser")
+    with tempfile.TemporaryDirectory(prefix="coa-g1-social-adapter-") as temporary:
+        directory = Path(temporary)
+        (directory / "BotSocialProduction.h").write_text(production + "\n" + gate + "\n", encoding="utf-8")
+        (directory / "ChannelMembershipProduction.h").write_text(membership + "\n", encoding="utf-8")
+        for header in ("ObjectGuid.h", "Channel.h", "ChannelMgr.h", "ChatHelper.h", "Group.h",
+                       "ObjectAccessor.h", "Player.h", "PlayerbotAI.h", "PlayerbotAIConfig.h", "Random.h",
+                       "SocialMgr.h", "WorldSession.h"):
+            (directory / header).write_text('#include "fixture.h"\n', encoding="utf-8")
+        executable = directory / "fixture"
+        subprocess.run(shlex.split(compiler) + [
+            "-std=c++20", "-Wall", "-Wextra", "-Werror", "-pthread", "-I", str(directory), "-I", str(HERE),
